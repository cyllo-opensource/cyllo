    <t t-name="transifex.CodeTranslationListView.Buttons">
        <div t-if="props.showButtons" class="o_list_buttons d-flex gap-1 d-empty-none align-items-baseline"
             role="toolbar" aria-label="Main actions">
            <t t-if="model.root.editedRecord">
                <button type="button" class="btn btn-primary o_list_button_save" data-hotkey="s"
                        t-on-click.stop="onClickSave">
                    Save
                </button>
                <button type="button" class="btn btn-secondary o_list_button_discard" data-hotkey="j"
                        t-on-click.stop="onClickDiscard" t-on-mousedown="onMouseDownDiscard">
                    Discard
                </button>
            </t>
            <button type="button" class="btn btn-primary" t-on-click="onClickReloadCodeTranslations">Reload</button>
        </div>
    </t>
</templates>