<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Tree/List View of Opportunity -->
    <record id="crm_lead_view_tree_opportunity_inherit_survey" model="ir.ui.view">
        <field name="name">crm.lead.view.tree.opportunity.inherit.survey</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_generate_leads']" position="after">
                <button name="action_create_survey" type="object" class="o_button_create_survey"
                        string="Create Survey" display="always"
                        invisible="context.get('active_model', 'crm.lead') != 'crm.lead'"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Tree/List View of Lead -->
    <record id="crm_lead_view_tree_lead_inherit_survey" model="ir.ui.view">
        <field name="name">crm.lead.view.tree.lead.inherit.survey</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_generate_leads']" position="after">
                <button name="action_create_survey" type="object" class="o_button_create_survey"
                        string="Create Survey" display="always"
                        invisible="context.get('active_model', 'crm.lead') != 'crm.lead'"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Kanban View of Opportunity -->
    <record id="view_crm_lead_kanban_inherit_survey" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.survey</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_lead_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_generate_leads']" position="after">
                <button name="action_create_survey" type="object" class="o_button_create_survey"
                        string="Create Survey" display="always"
                        invisible="context.get('active_model', 'crm.lead') != 'crm.lead'"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Kanban View of Lead -->
    <record id="crm_case_kanban_view_leads_inherit_survey" model="ir.ui.view">
        <field name="name">crm.lead.kanban.lead.inherit.survey</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_generate_leads']" position="after">
                <button name="action_create_survey" type="object" class="o_button_create_survey"
                        string="Create Survey" display="always"
                        invisible="context.get('active_model', 'crm.lead') != 'crm.lead'"/>
            </xpath>
        </field>
    </record>
    
</odoo>
