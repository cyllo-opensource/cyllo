<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cyllo_green_metrics.GreenDashboard">
        <div class="cy_gm_page">

                <!-- DASHBOARD BOX: HEADER + CARBON -->
                <div class="mb-3">

                <!-- TOP HEADER & FILTERS BANNER -->
                <div class="row mb-3 align-items-center g-2">
                    <div class="col-lg-5 col-12">
                        <h2 class="gm-page-title fw-bold mb-1">Environment Metrics Overview</h2>
                        <p class="gm-page-subtitle mb-0">Real-time tracking of carbon, water, and sound pollution footprint.</p>
                    </div>

                    <div class="col-lg-7 col-12 d-flex justify-content-lg-end justify-content-start mt-lg-0 mt-2 flex-wrap align-items-center gm-filter-toolbar" t-if="state.dashboardData">
                        <!-- Date Filter Segmented Control (with more-periods chevron inside) -->
                        <div class="gm-segmented d-inline-flex align-items-center" role="group" aria-label="Date filter">
                            <button t-attf-class="gm-seg-btn {{ state.waterDateFilter == 'today' ? 'active' : '' }}" t-on-click="() => this.setDateFilter('today')">Daily</button>
                            <button t-attf-class="gm-seg-btn {{ state.waterDateFilter == 'weekly' ? 'active' : '' }}" t-on-click="() => this.setDateFilter('weekly')">Weekly</button>
                            <button t-attf-class="gm-seg-btn {{ state.waterDateFilter == 'monthly' ? 'active' : '' }}" t-on-click="() => this.setDateFilter('monthly')">Monthly</button>

                            <!-- More Periods Dropdown (chevron) -->
                            <div class="dropdown gm-more-dropdown">
                                <button t-attf-class="btn gm-seg-chevron {{ ['quarterly', 'yearly', 'range'].includes(state.waterDateFilter) ? 'active' : '' }}" type="button" id="periodMoreDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                    <i class="fa fa-chevron-down"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end gm-scope-menu" aria-labelledby="periodMoreDropdown">
                                    <li>
                                        <button type="button" class="gm-scope-item" t-on-click="() => this.setDateFilter('quarterly')">
                                            <span t-attf-class="gm-check {{ state.waterDateFilter == 'quarterly' ? 'checked' : '' }}"><i class="fa fa-check"></i></span>
                                            <span class="flex-grow-1">This Quarter</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="gm-scope-item" t-on-click="() => this.setDateFilter('yearly')">
                                            <span t-attf-class="gm-check {{ state.waterDateFilter == 'yearly' ? 'checked' : '' }}"><i class="fa fa-check"></i></span>
                                            <span class="flex-grow-1">This Year</span>
                                        </button>
                                    </li>
                                    <li>
                                        <button type="button" class="gm-scope-item" t-on-click="() => this.setDateFilter('range')">
                                            <span t-attf-class="gm-check {{ state.waterDateFilter == 'range' ? 'checked' : '' }}"><i class="fa fa-check"></i></span>
                                            <span class="flex-grow-1">Date Range</span>
                                        </button>
                                    </li>
                                    <!-- Date range fields live inside the menu -->
                                    <li t-if="state.waterDateFilter == 'range'">
                                        <div class="gm-range-panel">
                                            <div class="gm-range-inputs d-flex gap-2 align-items-center">
                                                <input type="date" class="form-control form-control-sm" t-model="state.waterStartDate" t-att-max="state.waterEndDate" t-on-change="onWaterDateRangeChange"/>
                                                <span class="gm-range-to">to</span>
                                                <input type="date" class="form-control form-control-sm" t-model="state.waterEndDate" t-att-min="state.waterStartDate" t-on-change="onWaterDateRangeChange"/>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <!-- Multi-select Scope Dropdown -->
                        <div class="dropdown custom-scope-dropdown">
                            <button class="btn gm-scope-btn" type="button" id="scopeDropdown" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <i class="fa fa-filter me-2"></i><t t-esc="getSelectedScopesText()"/><i class="fa fa-chevron-down gm-scope-caret"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end gm-scope-menu" aria-labelledby="scopeDropdown">
                                <li>
                                    <div class="gm-scope-item">
                                        <input type="checkbox" id="scope_all" class="form-check-input" t-att-checked="isAllSelected()" t-on-change="toggleScopeAll"/>
                                        <label class="mb-0 flex-grow-1 cursor-pointer" for="scope_all">Select All</label>
                                    </div>
                                </li>
                                <t t-foreach="state.dashboardData.scopes or []" t-as="scope" t-key="scope.id">
                                    <li>
                                        <div class="gm-scope-item">
                                            <input type="checkbox" t-att-id="'scope_' + scope.id" class="form-check-input" t-att-checked="isScopeSelected(scope.id)" t-on-change="(ev) => this.toggleScope(scope.id, ev)"/>
                                            <label class="mb-0 flex-grow-1 cursor-pointer" t-att-for="'scope_' + scope.id"><t t-esc="scope.name"/></label>
                                        </div>
                                    </li>
                                </t>
                                <li>
                                    <div class="gm-scope-item">
                                        <input type="checkbox" id="scope_none" class="form-check-input" t-att-checked="isScopeSelected('no_scope')" t-on-change="(ev) => this.toggleScope('no_scope', ev)"/>
                                        <label class="mb-0 flex-grow-1 cursor-pointer" for="scope_none">No Scope</label>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Carbon Cards Section -->
                    <div t-if="state.dashboardData.cap_data">
                        <t t-if="state.dashboardData.cap_data.used > state.dashboardData.cap_data.cap">
                            <div class="alert alert-danger mb-3 p-3 d-flex align-items-center justify-content-between mx-1 shadow-sm rounded-3 border-start border-danger" style="border-left-width: 5px !important; background: linear-gradient(135deg, #fff5f5 0%, #ffe3e3 100%);">
                                <div class="d-flex align-items-center">
                                    <i class="fa fa-exclamation-triangle fs-4 me-3 text-danger"></i>
                                    <div>
                                        <h6 class="alert-heading mb-1 fw-bold text-danger" style="font-size: 1rem;">Carbon Limit Over!</h6>
                                        <p class="mb-0 opacity-90" style="font-size: 0.9rem;">
                                            Your Used Amount (<t t-esc="state.dashboardData.cap_data.used"/> <t t-esc="state.dashboardData.cap_data.unit"/>) has exceeded the allocated cap of <t t-esc="state.dashboardData.cap_data.cap"/> <t t-esc="state.dashboardData.cap_data.unit"/>.<t t-if="state.dashboardData.enable_credit_transfer"> You can buy credits to increase your limit.</t>
                                        </p>
                                    </div>
                                </div>
                                <button t-if="state.dashboardData.enable_credit_transfer"
                                        class="btn btn-danger btn-sm rounded-pill px-4 py-2 fw-bold text-white shadow-sm" t-on-click="buyCredits">
                                    <i class="fa fa-shopping-cart me-1"></i> Buy Credits
                                </button>
                            </div>
                        </t>
                        <div class="row g-3">
                            <!-- Allocated Cap -->
                            <div class="col-lg-3 col-md-6 col-sm-6">
                                <div class="gm-card h-100 d-flex justify-content-between">
                                    <div class="gm-card-info">
                                        <h6 class="gm-card-title mb-0">Monthly Allocated Carbon</h6>
                                        <div class="gm-value-row d-flex align-items-baseline">
                                            <span class="gm-value"><t t-esc="state.dashboardData.cap_data.cap" /></span>
                                            <span class="gm-unit"><t t-esc="state.dashboardData.cap_data.unit" /></span>
                                        </div>
                                        <div class="gm-pill-row">
                                            <span class="gm-pill gm-pill-success"><t t-esc="getCapRemainingPct()"/>%</span>
                                        </div>
                                    </div>
                                    <span class="gm-icon-badge"><i class="fa fa-user"></i></span>
                                </div>
                            </div>

                            <!-- Used Amount -->
                            <div class="col-lg-3 col-md-6 col-sm-6">
                                <div class="gm-card h-100 d-flex justify-content-between">
                                    <div class="gm-card-info">
                                        <h6 class="gm-card-title mb-0">Carbon Used This month</h6>
                                        <div class="gm-value-row d-flex align-items-baseline">
                                            <span t-attf-class="gm-value {{ getCapUsedPct() > 100 ? 'text-danger' : '' }}"><t t-esc="state.dashboardData.cap_data.used" /></span>
                                            <span class="gm-unit"><t t-esc="state.dashboardData.cap_data.unit" /></span>
                                        </div>
                                        <div class="gm-pill-row">
                                            <span t-attf-class="gm-pill {{ getCapUsedPct() > 100 ? 'gm-pill-danger' : 'gm-pill-success' }}"><t t-esc="getCapUsedPct()"/>%</span>
                                        </div>
                                    </div>
                                    <span t-attf-class="gm-icon-badge {{ getCapUsedPct() >100 ? 'gm-icon-badge-danger' : '' }}"><i t-attf-class="fa {{ getCapUsedPct() > 100 ? 'fa-exclamation-triangle' : 'fa-leaf' }}"></i></span>
                                </div>
                            </div>

                            <!-- Previous Year Target -->
                            <div class="col-lg-3 col-md-6 col-sm-6">
                                <div class="gm-card h-100 d-flex justify-content-between">
                                    <div class="gm-card-info">
                                        <h6 class="gm-card-title mb-0">Previous Year Target</h6>
                                        <div class="gm-value-row d-flex align-items-baseline">
                                            <span class="gm-value"><t t-esc="state.dashboardData.cap_data.previous_year_achieved" /></span>
                                            <span class="gm-unit"><t t-esc="state.dashboardData.cap_data.unit" /></span>
                                        </div>
                                        <div class="gm-pill-row">
                                            <span t-if="state.dashboardData.cap_data.targeted_achievement > 0" class="gm-pill gm-pill-success"><t t-esc="getPreviousYearPct()"/>%</span>
                                            <span t-else="" class="gm-pill gm-pill-danger">Target not configured</span>
                                        </div>
                                    </div>
                                    <span class="gm-icon-badge"><i class="fa fa-crosshairs"></i></span>
                                </div>
                            </div>

                            <!-- Monthly Carbon Progress -->
                            <div class="col-lg-3 col-md-6 col-sm-6">
                                <div class="gm-card h-100 d-flex justify-content-between">
                                    <div class="gm-card-info">
                                        <h6 class="gm-card-title mb-0">Monthly Carbon Progress</h6>
                                        <div class="gm-value-row d-flex align-items-baseline">
                                            <span class="gm-value"><t t-esc="getCapRemaining()"/></span>
                                            <span class="gm-unit"><t t-esc="state.dashboardData.cap_data.unit" /></span>
                                        </div>
                                        <div class="gm-pill-row">
                                            <span t-attf-class="gm-pill {{ getCapUsedPct() > 100 ? 'gm-pill-danger' : 'gm-pill-success' }}"><t t-esc="getCapUsedPct()"/>%</span>
                                        </div>
                                    </div>
                                    <span t-attf-class="gm-icon-badge {{ getCapUsedPct() >100 ? 'gm-icon-badge-danger' : '' }}"><i class="fa fa-line-chart"></i></span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- WATER SECTION BOX -->
                <div class="gm-box mb-3" t-if="state.dashboardData.water_cap_data">
                    <div>
                        <div class="px-1 mb-3">
                            <h5 class="gm-section-title fw-bold mb-0">Water Usage Stats (<t t-esc="state.dashboardData.water_cap_data.duration" />)</h5>
                        </div>
                        <div class="row g-3">
                            <!-- Allocated Water -->
                            <div class="col-md-4 col-sm-6">
                                <div class="gm-card gm-card-soft h-100 d-flex justify-content-between">
                                    <div class="gm-card-info">
                                        <h6 class="gm-card-title mb-0">Allocated Water</h6>
                                        <div class="gm-value-row d-flex align-items-baseline">
                                            <span class="gm-value"><t t-esc="state.dashboardData.water_cap_data.cap" /></span>
                                            <span class="gm-unit"><t t-esc="state.dashboardData.water_cap_data.unit" /></span>
                                        </div>
                                    </div>
                                    <span class="gm-icon-badge gm-icon-badge-outline"><i class="fa fa-tint"></i></span>
                                </div>
                            </div>
                            <!-- Used Water -->
                            <div class="col-md-4 col-sm-6">
                                <div class="gm-card gm-card-soft h-100 d-flex justify-content-between">
                                    <div class="gm-card-info">
                                        <h6 class="gm-card-title mb-0">Used Water</h6>
                                        <div class="gm-value-row d-flex align-items-baseline">
                                            <span t-attf-class="gm-value {{ getWaterUsedPct() > 100 ? 'text-danger' : '' }}"><t t-esc="state.dashboardData.water_cap_data.used" /></span>
                                            <span class="gm-unit"><t t-esc="state.dashboardData.water_cap_data.unit" /></span>
                                        </div>
                                    </div>
                                    <span t-attf-class="gm-icon-badge gm-icon-badge-outline {{ getWaterUsedPct() > 100 ? 'gm-icon-badge-danger' : '' }}"><i t-attf-class="fa {{ getWaterUsedPct() > 100 ? 'fa-exclamation-triangle' : 'fa-shower' }}"></i></span>
                                </div>
                            </div>
                            <!-- Recovered/Net Water -->
                            <div class="col-md-4 col-sm-6">
                                <div class="gm-card gm-card-soft h-100 d-flex justify-content-between">
                                    <div class="gm-card-info">
                                        <h6 class="gm-card-title mb-0">Net Recovered Water</h6>
                                        <div class="gm-value-row d-flex align-items-baseline">
                                            <span class="gm-value"><t t-esc="state.dashboardData.water_cap_data.recycled_water" /></span>
                                            <span class="gm-unit"><t t-esc="state.dashboardData.water_cap_data.unit" /></span>
                                        </div>
                                    </div>
                                    <span class="gm-icon-badge gm-icon-badge-outline"><i class="fa fa-recycle"></i></span>
                                </div>
                            </div>
                        </div>
                        <t t-if="state.dashboardData.water_cap_data.used > state.dashboardData.water_cap_data.cap">
                            <div class="alert alert-danger mb-0 p-2 d-flex align-items-center mt-3 mx-1 shadow-sm rounded-3">
                                <i class="fa fa-exclamation-triangle fs-5 me-2"></i>
                                <strong>Warning:</strong> Water usage exceeds allocated amount!
                            </div>
                        </t>
                    </div>
                </div>

                <!-- BREAKDOWN & TARGET ACHIEVEMENT ROW -->
                <div class="row g-4 mb-3" t-if="state.dashboardData">
                    <!-- Scope Breakdown (Doughnut — same design as Overall Gas Emissions) -->
                    <div class="col-lg-4 col-md-6">
                        <div class="card gm-card h-100">
                            <div class="card-header border-bottom-0 pb-0">
                                <h5 class="card-title mb-0 fw-bold">Scope Breakdown</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="!isEmptyChart('scope_breakdown')">
                                    <div class="gm-chart-panel">
                                        <div class="chart-container" style="position: relative; height:250px; width:100%">
                                            <canvas t-ref="scopeChart"></canvas>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="gm-chart-panel gm-panel-empty d-flex align-items-center justify-content-center">
                                        <div class="gm-no-data text-center">
                                            <i class="fa fa-bar-chart fa-2x d-block mb-2"></i>
                                            No data in that range or scope
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Target vs Actual Achievement (Gauge Chart) -->
                    <div class="col-lg-4 col-md-12">
                        <div class="card gm-card h-100">
                            <div class="card-header pb-0">
                                <h5 class="card-title mb-0 fw-bold">Target Achievement Status</h5>
                            </div>
                            <div class="card-body">
                                <div class="gm-chart-panel">
                                    <div class="chart-container" style="position: relative; height:200px; width:100%">
                                        <canvas t-ref="targetChart"></canvas>
                                    </div>

                                    <div class="pt-2">
                                        <t t-set="capData" t-value="state.dashboardData.cap_data"/>
                                        <t t-if="capData.targeted_achievement > 0">
                                            <div class="gm-stat-box d-flex align-items-center">
                                                <div class="gm-stat-col text-center flex-fill">
                                                    <div class="gm-stat-label">Target Limit</div>
                                                    <div class="gm-stat-value"><t t-esc="capData.targeted_achievement"/> <span class="gm-stat-unit"><t t-esc="capData.unit"/></span></div>
                                                </div>
                                                <div class="gm-stat-divider"></div>
                                                <div class="gm-stat-col text-center flex-fill">
                                                    <div class="gm-stat-label">Actual Emission</div>
                                                    <div class="gm-stat-value"><t t-esc="capData.filtered_used"/> <span class="gm-stat-unit"><t t-esc="capData.unit"/></span></div>
                                                </div>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="text-muted py-2 text-center">
                                                <i class="fa fa-info-circle me-1"></i> Targeted achievement limit is not configured in settings.
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>                    <!-- Overall Gas Emissions (Doughnut) -->
                    <div class="col-lg-4 col-md-6">
                        <div class="card gm-card h-100">
                            <div class="card-header pb-0">
                                <h5 class="card-title mb-0 fw-bold">Overall Gas Emissions</h5>
                            </div>
                            <div class="card-body">
                                <t t-if="!isEmptyChart('gas')">
                                    <div class="gm-chart-panel">
                                        <div class="chart-container" style="position: relative; height:250px; width:100%">
                                            <canvas t-ref="gasChart"></canvas>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="gm-chart-panel gm-panel-empty d-flex align-items-center justify-content-center">
                                        <div class="gm-no-data text-center">
                                            <i class="fa fa-area-chart fa-2x d-block mb-2"></i>
                                            No data in that range or scope
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>


                </div>

                <!-- MONTHLY TRENDS ROW (5 MONTHS) -->
                <div class="row g-4 mb-3" t-if="state.dashboardData">
                    <!-- Air Emissions Trend -->
                    <div class="col-lg-4 col-md-6">
                        <div class="card gm-card h-100">
                            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 fw-bold">Air Emission Trend</h5>
                                <span class="gm-trend-badge"><span class="gm-trend-badge-value"><t t-esc="getTrendTotal('air_trend')"/> t</span><span class="gm-trend-badge-sub">This month</span></span>
                            </div>
                            <div class="card-body">
                                <t t-if="!isEmptyChart('air_trend')">
                                    <div class="gm-chart-panel">
                                        <div class="chart-container" style="position: relative; height:250px; width:100%">
                                            <canvas t-ref="airTrendChart"></canvas>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="gm-chart-panel gm-panel-empty d-flex align-items-center justify-content-center">
                                        <div class="gm-no-data text-center">
                                            <i class="fa fa-line-chart fa-2x d-block mb-2"></i>
                                            No data in that range or scope
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Water Pollution Trend -->
                    <div class="col-lg-4 col-md-6">
                        <div class="card gm-card h-100">
                            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 fw-bold">Water Usage Trend</h5>
                                <span class="gm-trend-badge"><span class="gm-trend-badge-value"><t t-esc="getTrendTotal('water')"/> <t t-esc="state.dashboardData.water_cap_data.unit"/></span><span class="gm-trend-badge-sub">This month</span></span>
                            </div>
                            <div class="card-body">
                                <t t-if="!isEmptyChart('water')">
                                    <div class="gm-chart-panel">
                                        <div class="chart-container" style="position: relative; height:250px; width:100%">
                                            <canvas t-ref="waterChart"></canvas>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="gm-chart-panel gm-panel-empty d-flex align-items-center justify-content-center">
                                        <div class="gm-no-data text-center">
                                            <i class="fa fa-line-chart fa-2x d-block mb-2"></i>
                                            No data in that range or scope
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Sound Usage Trend -->
                    <div class="col-lg-4 col-md-12">
                        <div class="card gm-card h-100">
                            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 fw-bold">Sound Usage Trend</h5>
                                <span class="gm-trend-badge"><span class="gm-trend-badge-value"><t t-esc="getTrendTotal('sound')"/> dB</span><span class="gm-trend-badge-sub">This month</span></span>
                            </div>
                            <div class="card-body">
                                <t t-if="!isEmptyChart('sound')">
                                    <div class="gm-chart-panel">
                                        <div class="chart-container" style="position: relative; height:250px; width:100%">
                                            <canvas t-ref="soundChart"></canvas>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="gm-chart-panel gm-panel-empty d-flex align-items-center justify-content-center">
                                        <div class="gm-no-data text-center">
                                            <i class="fa fa-line-chart fa-2x d-block mb-2"></i>
                                            No data in that range or scope
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- INITIATIVES ROW -->
                <div class="row g-4" t-if="state.dashboardData and state.dashboardData.show_initiatives">
                    <div class="col-12 px-1">
                        <h4 class="gm-section-title fw-bold mb-0">Sustainability Initiatives &amp; Projects</h4>
                    </div>

                    <!-- Green Initiatives Card -->
                    <div class="col-lg-4 col-md-12 mb-4">
                        <div class="card gm-card h-100">
                            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                                <h5 class="card-title mb-0 fw-bold">Green Projects</h5>
                                <button class="btn btn-sm btn-success rounded-pill px-3 fw-bold" t-if="state.canCreateProject" t-on-click="() => this.createInitiative('green')">
                                    <i class="fa fa-plus me-1"></i>New Task
                                </button>
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between" t-if="state.dashboardData.projects">
                                <div class="d-flex justify-content-around text-center py-3">
                                    <div class="cursor-pointer px-2" t-on-click="() => this.openTasks('green', state.dashboardData.projects.idea_stage_id)">
                                        <h3 class="text-primary fw-bold mb-1"><t t-esc="state.dashboardData.projects.ideas_cnt"/></h3>
                                        <h6 class="text-muted mb-0" style="font-size: 0.85rem;">Ideas</h6>
                                    </div>
                                    <div class="cursor-pointer px-2" t-on-click="() => this.openTasks('green', state.dashboardData.projects.prog_stage_id)">
