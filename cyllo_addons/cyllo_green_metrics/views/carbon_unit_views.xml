<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_carbon_unit_tree" model="ir.ui.view">
        <field name="name">carbon.unit.tree</field>
        <field name="model">carbon.unit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="full_name"/>
                <field name="symbol"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_carbon_unit_form" model="ir.ui.view">
        <field name="name">carbon.unit.form</field>
        <field name="model">carbon.unit</field>
        <field name="arch" type="xml">
            <form string="Greenhouse Gas">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="full_name" placeholder="Unit Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="symbol"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_carbon_units" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">carbon.unit</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>