<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carbon_scope_tree" model="ir.ui.view">
        <field name="name">carbon.scope.tree</field>
        <field name="model">carbon.scope</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="sequence"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_carbon_scope_form" model="ir.ui.view">
        <field name="name">carbon.scope.form</field>
        <field name="model">carbon.scope</field>
        <field name="arch" type="xml">
            <form string="Carbon Scope">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Scope Name"/>
                        </h1>
                    </div>

                    <!-- Main Information -->
                    <group>
                        <group string="Scope Information">
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Configuration">
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Describe the purpose, category, and reporting requirements of this scope..."/>
                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_carbon_scope" model="ir.actions.act_window">
        <field name="name">Scopes</field>
        <field name="res_model">carbon.scope</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
