<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carbon_calc_tree" model="ir.ui.view">
        <field name="name">carbon.calc.tree</field>
        <field name="model">carbon.calc</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date"/>
                <field name="total_air_pollution"/>
                <field name="total_water_pollution"/>
                <field name="total_sound_pollution"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
<record id="view_carbon_calc_form" model="ir.ui.view">
    <field name="name">carbon.calc.form</field>
    <field name="model">carbon.calc</field>
    <field name="arch" type="xml">
        <form string="Carbon Calculation">

            <header>
                <button name="%(action_carbon_compute_wizard)d"
                        type="action"
                        string="Compute Emissions"
                        class="btn-primary"
                        invisible="state != 'draft'"/>

                <button name="action_submit"
                        type="object"
                        string="Submit"
                        class="btn-primary"
                        invisible="state != 'draft'"/>

                <button name="action_approve"
                        type="object"
                        string="Approve"
                        class="btn-primary"
                        groups="cyllo_green_metrics.group_carbon_manager"
                        invisible="state != 'submitted'"/>

                <button name="action_done"
                        type="object"
                        string="Mark Done"
                        class="btn-primary"
                        groups="cyllo_green_metrics.group_carbon_manager"
                        invisible="state != 'approved'"/>

                <button name="action_draft"
                        type="object"
                        string="Reset to Draft"
                        class="btn-secondary"
                        groups="cyllo_green_metrics.group_carbon_manager"
                        invisible="state not in ['submitted', 'approved']"/>

                <field name="state"
                       widget="statusbar"
                       statusbar_visible="draft,submitted,approved,done"/>
            </header>

            <sheet>

                <!-- Record Title -->
                <div class="oe_title">
                    <h1>
                        <field name="name"
                               placeholder="Carbon Calculation Reference"/>
                    </h1>
                </div>

                <!-- Summary Section -->
                <group>
                    <group string="Calculation Details">
                        <field name="date"/>
                        <field name="company_id"
                               groups="base.group_multi_company"/>
                    </group>

                    <group string="Pollution Summary">
                        <field name="total_air_pollution" readonly="1"/>
                        <field name="total_water_pollution" readonly="1"/>
                        <field name="total_sound_pollution" readonly="1"/>
                        <field name="highest_source_id" readonly="1"/>
                    </group>
                </group>

                <notebook>

                    <!-- Activities -->
                    <page string="Activities">
                        <field name="carbon_activity_ids"
                               context="{'default_calculation_id': id}">
                            <tree editable="bottom">
                                <field name="name" readonly="state == 'done'"/>
                                <field name="date" readonly="state == 'done'"/>
                                <field name="source_id" readonly="state == 'done'"/>
                                <field name="scope_id" readonly="state == 'done'"/>
                                <field name="quantity" readonly="state == 'done'"/>
                                <field name="uom_id" readonly="state == 'done'"/>
                                <field name="factor_id"
                                       readonly="state == 'done'"
                                       domain="[('source_id', '=', source_id),
                                                '|', ('valid_from', '=', False), ('valid_from', '&lt;=', date),
                                                '|', ('valid_to', '=', False), ('valid_to', '&gt;=', date)]"/>
                                <field name="gas_id" readonly="state == 'done'"/>
                                <field name="emission_total" readonly="1"/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Notes">
                        <field name="note"
                               nolabel="1"
                               placeholder="Enter remarks, assumptions, audit notes, or additional information..."/>
                    </page>

                    <!-- Report Options -->
                    <page string="PDF Report Options">
                        <group>
                            <group string="Report Filters">
                                <field name="emission_type_filter"/>
                            </group>
                            <group string="Include in Report">
                                <field name="print_activities"/>
                                <field name="print_note"/>
                            </group>
                        </group>
                    </page>
                </notebook>
            </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
    </field>
</record>

    <record id="action_carbon_calc" model="ir.actions.act_window">
        <field name="name">Calculations</field>
        <field name="res_model">carbon.calc</field>
        <field name="view_mode">tree,form,graph</field>
    </record>

    <record id="view_carbon_calc_search" model="ir.ui.view">
        <field name="name">carbon.calc.search</field>
        <field name="model">carbon.calc</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <filter string="Current Year" name="current_year" domain="[('date', '&gt;=', context_today().strftime('%Y-01-01')), ('date', '&lt;=', context_today().strftime('%Y-12-31'))]"/>
                <filter string="Previous Year" name="previous_year" domain="[('date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%Y-01-01')), ('date', '&lt;=', (context_today() - relativedelta(years=1)).strftime('%Y-12-31'))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Highest Emitting Source" name="group_by_highest_source" context="{'group_by': 'highest_source_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_carbon_calc_pivot" model="ir.ui.view">
        <field name="name">carbon.calc.pivot</field>
        <field name="model">carbon.calc</field>
        <field name="arch" type="xml">
            <pivot string="Calculations Analysis" sample="1">
                <field name="highest_source_id" type="row"/>
                <field name="total_air_pollution" type="measure"/>
                <field name="total_water_pollution" type="measure"/>
                <field name="total_sound_pollution" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_carbon_calc_graph" model="ir.ui.view">
        <field name="name">carbon.calc.graph</field>
        <field name="model">carbon.calc</field>
        <field name="arch" type="xml">
            <graph string="Calculations Analysis" type="bar" sample="1">
                <field name="highest_source_id"/>
                <field name="total_air_pollution" type="measure"/>
                <field name="total_water_pollution" type="measure"/>
                <field name="total_sound_pollution" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_carbon_calc_report_view" model="ir.actions.act_window">
        <field name="name">Calculations Analysis</field>
        <field name="res_model">carbon.calc</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_carbon_calc_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No emission calculations available yet.
            </p>
            <p>
                Analyze Air, Water, and Sound pollution totals across your calculation sheets.
            </p>
        </field>
    </record>
</odoo>
