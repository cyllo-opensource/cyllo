<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_carbon_root" name="Green Metrics" action="action_carbon_dashboard_owl"
              sequence="10" groups="cyllo_green_metrics.group_carbon_user"
              web_icon="cyllo_green_metrics,static/description/green_metrics.svg"/>
    <menuitem id="menu_carbon_dashboard" name="Dashboard" parent="menu_carbon_root"
              action="action_carbon_dashboard_owl" sequence="5"/>
    <menuitem id="menu_carbon_calc" name="Calculations" parent="menu_carbon_root"
              action="action_carbon_calc" sequence="10"/>
    <menuitem id="menu_carbon_activity" name="Activities" parent="menu_carbon_root"
              action="action_carbon_activity" sequence="20"/>
    <menuitem id="menu_credit_buy" name="Buy Credit" parent="menu_carbon_root"
              action="action_buy_credit" sequence="30" groups="group_carbon_manager"
              active="False"/>
    <menuitem id="menu_credit_sell" name="Sell Credit" parent="menu_carbon_root"
              action="action_sell_credit" sequence="40" groups="group_carbon_manager"
              active="False"/>

    <!-- Reporting Menu -->
    <menuitem id="menu_carbon_reporting" name="Reporting" parent="menu_carbon_root" sequence="90"/>
    <menuitem id="menu_carbon_activity_analysis" name="Emissions Analysis"
              parent="menu_carbon_reporting" action="action_carbon_activity_report" sequence="10"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_carbon_config" name="Configuration" parent="menu_carbon_root" sequence="100"
              groups="group_carbon_manager"/>
    <menuitem id="menu_carbon_source" name="Emission Sources" parent="menu_carbon_config"
              action="action_carbon_source" sequence="10"/>
    <menuitem id="menu_carbon_rule" name="Assignation Rules" parent="menu_carbon_config"
              action="action_carbon_rule" sequence="20" groups="group_carbon_manager"/>
    <menuitem id="menu_carbon_scope" name="Scopes" parent="menu_carbon_config"
              action="action_carbon_scope" sequence="30" groups="group_carbon_manager"/>
    <menuitem id="menu_carbon_gas" name="Gases" parent="menu_carbon_config"
              action="action_carbon_gas" sequence="40" groups="group_carbon_manager"/>
    <menuitem id="menu_carbon_factors" name="Factors" parent="menu_carbon_config"
              action="action_carbon_factors" sequence="40" groups="group_carbon_manager"/>
    <menuitem id="menu_carbon_units" name="Units" parent="menu_carbon_config"
              action="action_carbon_units" sequence="40" groups="group_carbon_manager"/>
    <menuitem id="menu_carbon_settings" name="Settings" parent="menu_carbon_config"
              action="action_carbon_config_settings" sequence="50" groups="group_carbon_manager"/>
</odoo>
