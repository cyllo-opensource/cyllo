<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carbon_gas_tree" model="ir.ui.view">
        <field name="name">carbon.gas.tree</field>
        <field name="model">carbon.gas</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="formula"/>
                <field name="gwp"/>
                <field name="unit_name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_carbon_gas_form" model="ir.ui.view">
        <field name="name">carbon.gas.form</field>
        <field name="model">carbon.gas</field>
        <field name="arch" type="xml">
            <form string="Greenhouse Gas">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Gas Name"/>
                        </h1>
                    </div>
                    <!-- Main Information -->
                    <group>
                        <group string="Gas Information">
                            <field name="code"/>
                            <field name="formula"/>
                        </group>

                        <group string="Environmental Properties">
                            <field name="gwp"/>
                            <field name="unit_name"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="note"
                                   nolabel="1"
                                   placeholder="Add scientific references, GWP source methodology, reporting notes, or additional information..."/>
                        </page>
                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_carbon_gas" model="ir.actions.act_window">
        <field name="name">Gases</field>
        <field name="res_model">carbon.gas</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
