<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_carbon_source_tree" model="ir.ui.view">
        <field name="name">carbon.source.tree</field>
        <field name="model">carbon.source</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="category"/>
                <field name="activity_unit"/>
                <field name="scope_id"/>
                <field name="factor_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_carbon_source_form" model="ir.ui.view">
        <field name="name">carbon.source.form</field>
        <field name="model">carbon.source</field>
        <field name="arch" type="xml">
            <form string="Emission Source">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Emission Source Name"/>
                        </h1>
                    </div>
                    <!-- Main Information -->
                    <group>
                        <group string="Source Details">
                            <field name="category"/>
                            <field name="activity_unit"/>
                            <field name="scope_id"/>
                        </group>

                        <group string="Configuration">
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Air Factors -->
                        <page string="Air Factors">
                            <field name="air_factor_ids" context="{'default_type': 'air'}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="gas_id"/>
                                    <field name="factor_value"/>
                                    <field name="unit_name"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="active"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Sound Factors -->
                        <page string="Sound Factors">
                            <field name="sound_factor_ids" context="{'default_type': 'sound'}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="factor_value"/>
                                    <field name="unit_name"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="active"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Water Factors -->
                        <page string="Water Factors">
                            <field name="water_factor_ids" context="{'default_type': 'water'}">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="factor_value"/>
                                    <field name="unit_name"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="active"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>

                        <!-- Description -->
                        <page string="Notes">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Add details about this emission source, calculation methodology, standards, references, or comments..."/>

                        </page>

                    </notebook>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_carbon_source" model="ir.actions.act_window">
        <field name="name">Emission Sources</field>
        <field name="res_model">carbon.source</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
