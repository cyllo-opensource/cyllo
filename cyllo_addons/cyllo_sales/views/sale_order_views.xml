<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_custom_badge" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.badge</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('text-bg-secondary') and @invisible='not locked']" position="attributes">
                <attribute name="class">badge rounded-pill bg-secondary text-dark float-end fs-6 border-0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
