<templates xml:space="preserve">
    <t t-inherit="cyllo_web.Systray" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='state.alwaysItems']" position="before">
            <t t-if="_studioAccess.hasAccess">
                <div class="cy_studio_systray_icon">
                    <div class="new_icon">
                        <a class="toggle-icon o_icon" type="button" t-on-click="_onClick" tabindex="0"
                           aria-expanded="false">
                            <i id="cyllo_studio" class="ri-tools-fill cy-icons px-2" role="img"
                               data-tooltip="Go to Studio"/>
                        </a>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>