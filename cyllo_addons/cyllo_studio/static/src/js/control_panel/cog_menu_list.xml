<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <t t-name="cyllo_studio.CogMenuList" t-inherit="cyllo_web.CogMenuList" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'cy-top-section')]" position="replace">
            <div class="container cy-top-section p-0" t-ref="resize">
                <div class="row cog-menu" style="padding-top: 0 !important;">
                    <div class="col">
                        <ul class="navbar-nav flex-row flex-wrap gap-4">
                            <CogMenuItem t-if="props.canCreate and !(isNew or displayButtons)"
                                onClick="() => this.handleReportCreate()" accesskey="'C'">
                                <t t-set-slot="icon"><i class="ri-add-line" /></t>
                                <t t-set-slot="text">New</t>
                            </CogMenuItem>
                            <CogMenuItem t-if="props.canEdit and (isNew or displayButtons)"
                                onClick="props.saveButtonClicked">
                                <t t-set-slot="icon"><i class="ri-save-line" /></t>
                                <t t-set-slot="text">Save</t>
                            </CogMenuItem>
                            <CogMenuItem t-if="props.canEdit and (isNew or displayButtons)"
                                onClick="props.discard">
                                <t t-set-slot="icon"><i class="ri-eraser-line" /></t>
                                <t t-set-slot="text">Discard</t>
                            </CogMenuItem>
                        </ul>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</odoo>