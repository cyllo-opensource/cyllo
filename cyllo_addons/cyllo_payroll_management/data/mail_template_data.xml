<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Email Template for the employee resignation report-->
    <record id="mail_template_resignation_request" model="mail.template">
        <field name="name">Resignation Request</field>
        <field name="model_id" ref="cyllo_payroll_management.model_employee_resignation"/>
        <field name="email_from">{{ (object.employee_id.work_email or user.email_formatted) }}</field>
        <field name="subject">Employee Resignation Request - "{{ object.employee_id.name }}"</field>
        <field name="description">Sent Resignation Request To The Manager</field>
        <field name="body_html" type="html">
            <div style="margin: 0; padding: 24px 12px; background-color: #F4F6F8; font-family: 'Segoe UI', Helvetica, Arial, sans-serif; color: #3C4043;">
                <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 590px; margin: 0 auto; background-color: #FFFFFF; border: 1px solid #E5E7EB; border-top: 4px solid #9EA700; border-radius: 8px; border-collapse: separate;">
                    <tr>
                        <td style="padding: 28px 32px 8px 32px;">
                            <span style="font-size: 11px; color: #9EA700; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Employee Resignation</span>
                            <div style="font-size: 22px; font-weight: 700; color: #1F2933; margin-top: 4px;">Resignation Request</div>
                            <hr style="border: none; border-top: 1px solid #E5E7EB; margin: 16px 0 0 0;"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 16px 32px 28px 32px; font-size: 14px; line-height: 1.6; color: #3C4043;">
                            <p style="margin: 0 0 16px 0;">Hi Team,</p>
                            <p style="margin: 0 0 16px 0;">I hereby submit my resignation from the position of
                                <strong><span t-out="object.employee_id.job_id.name or ''"></span></strong>.</p>
                            <div style="margin: 16px 0; padding: 12px 16px; background-color: #F7F8E6; border-left: 4px solid #9EA700; border-radius: 4px;">
                                Please find more details from the attached Resignation Request of
                                <t t-if="object.employee_id">"<strong><span t-out="object.employee_id.name or ''"></span></strong>"</t>.
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding: 0 32px 20px 32px; font-size: 11px; color: #999999;">
                            <hr style="border: none; border-top: 1px solid #E5E7EB; margin: 0 0 12px 0;"/>
                            Powered by <a href="https://www.cyllo.com" style="color: #9EA700; text-decoration: none;">Cyllo</a>
                        </td>
                    </tr>
                </table>
            </div>
        </field>
        <field name="lang">{{ object.employee_id.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>