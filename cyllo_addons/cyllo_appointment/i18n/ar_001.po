"            <p style=\"margin: 8px 0 0; font-size: 16px; color: #e53e3e;\"><t t-out=\"format_datetime(object.start_datetime, dt_format='full')\"></t></p>\n"
"            <p style=\"margin: 8px 0 0; font-size: 14px; color: #718096;\">العميل: <t t-out=\"object.partner_id.name\"></t></p>\n"
"            <t t-if=\"object.location\"><p style=\"margin: 8px 0 0; font-size: 14px; color: #718096;\">📍 <t t-out=\"object.location\"></t></p></t>\n"
"        </div>\n"
"        <p style=\"font-size: 14px; color: #718096;\">المرجع: <strong><t t-out=\"object.name\"></t></strong></p>\n"
"    </div>\n"
"    <div style=\"background: #373627; padding: 20px 30px; text-align: center; border-radius: 0 0 8px 8px;\">\n"
"        <p style=\"color: #BCBBA7; font-size: 12px; margin: 0;\"><t t-out=\"object.company_id.name\"></t></p>\n"
"    </div>\n"
"</div>\n"
"        "

