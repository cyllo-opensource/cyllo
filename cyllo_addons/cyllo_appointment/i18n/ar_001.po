"        <p style=\"color: #BCBBA7; margin: 8px 0 0; font-size: 13px; text-transform: uppercase; letter-spacing: 3px;\">تمت إزالة الحجز</p>\n"
"    </div>\n"
"    <div style=\"padding: 40px 30px; background: #f8f9fa;\">\n"
"        <p style=\"font-size: 16px; color: #121212; margin: 0 0 20px;\">مرحباً <strong><t t-out=\"object.staff_id.name\"></t></strong>,</p>\n"
