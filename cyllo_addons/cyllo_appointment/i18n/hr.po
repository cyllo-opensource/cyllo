#. module: cyllo_appointment
#: model:mail.template,body_html:cyllo_appointment.email_template_appointment_confirmation
msgid ""
"<div style=\"font-family: 'Inter', Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #ffffff;\">\n"
"    <!-- Header -->\n"
"    <div style=\"background: #373627; padding: 40px 30px; text-align: center; border-radius: 8px 8px 0 0;\">\n"
"        <h1 style=\"color: #9EA700; margin: 0; font-size: 28px; font-weight: 500; letter-spacing: 2px;\">APPOINTMENT</h1>\n"
"        <p style=\"color: #BCBBA7; margin: 8px 0 0; font-size: 13px; text-transform: uppercase; letter-spacing: 3px;\">Confirmation</p>\n"
"    </div>\n"
"\n"
"    <!-- Body -->\n"
"    <div style=\"padding: 40px 30px; background: #f8f9fa;\">\n"
"        <p style=\"font-size: 16px; color: #121212; margin: 0 0 20px;\">Dear <strong><t t-out=\"object.partner_id.name\"></t></strong>,</p>\n"
"        <p style=\"font-size: 15px; color: #4a5568; line-height: 1.6;\">Your appointment has been <strong style=\"color: #9EA700;\">confirmed</strong>. Here are your details:</p>\n"
"\n"
"        <!-- Appointment Details Card -->\n"
"        <div style=\"background: #ffffff; border-radius: 8px; padding: 24px; margin: 24px 0; border-left: 4px solid #9EA700; box-shadow: 0 2px 8px rgba(0,0,0,0.06);\">\n"
"            <table style=\"width: 100%; border-collapse: collapse;\">\n"
"                <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; width: 40%; text-transform: uppercase; letter-spacing: 1px;\">Type</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"object.appointment_type_id.name\"></t></td>\n"
"                </tr>\n"
"                <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Reference</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"object.name\"></t></td>\n"
"                </tr>\n"
"                <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Date &amp; Time</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"format_datetime(object.start_datetime, dt_format='full')\"></t></td>\n"
"                </tr>\n"
"                <t t-if=\"object.staff_id\">\n"
"                <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Staff</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"object.staff_id.name\"></t></td>\n"
"                </tr>\n"
"                </t>\n"
"                <t t-if=\"object.location\">\n"
"                <tr>\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Location</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"object.location\"></t></td>\n"
"                </tr>\n"
"                </t>\n"
"            </table>\n"
"        </div>\n"
"\n"
"        <p style=\"font-size: 14px; color: #718096; line-height: 1.6;\">If you need to reschedule or cancel, you can manage your appointment online.</p>\n"
"\n"
"        <div style=\"text-align: center; margin-top: 30px;\">\n"
"            <a t-attf-href=\"/appointment/manage/{{object.access_token}}\" style=\"background-color: #9EA700; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px; display: inline-block;\">\n"
"                Manage Appointment\n"
"            </a>\n"
"        </div>\n"
"    </div>\n"
"\n"
"    <!-- Footer -->\n"
"    <div style=\"background: #373627; padding: 20px 30px; text-align: center; border-radius: 0 0 8px 8px;\">\n"
"        <p style=\"color: #BCBBA7; font-size: 12px; margin: 0;\"><t t-out=\"object.company_id.name\"></t> • <t t-out=\"object.company_id.email or ''\"></t></p>\n"
"    </div>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"font-family: 'Inter', Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #ffffff;\">\n"
"    <!-- Header -->\n"
"    <div style=\"background: #373627; padding: 40px 30px; text-align: center; border-radius: 8px 8px 0 0;\">\n"
"        <h1 style=\"color: #9EA700; margin: 0; font-size: 28px; font-weight: 500; letter-spacing: 2px;\">TERMIN</h1>\n"
"        <p style=\"color: #BCBBA7; margin: 8px 0 0; font-size: 13px; text-transform: uppercase; letter-spacing: 3px;\">Potvrda</p>\n"
"    </div>\n"
"\n"
"    <!-- Body -->\n"
"    <div style=\"padding: 40px 30px; background: #f8f9fa;\">\n"
"        <p style=\"font-size: 16px; color: #121212; margin: 0 0 20px;\">Poštovani <strong><t t-out=\"object.partner_id.name\"></t></strong>,</p>\n"
"        <p style=\"font-size: 15px; color: #4a5568; line-height: 1.6;\">Vaš termin je <strong style=\"color: #9EA700;\">potvrđen</strong>. Evo vaših podataka:</p>\n"
"\n"
"        <!-- Appointment Details Card -->\n"
"        <div style=\"background: #ffffff; border-radius: 8px; padding: 24px; margin: 24px 0; border-left: 4px solid #9EA700; box-shadow: 0 2px 8px rgba(0,0,0,0.06);\">\n"
"            <table style=\"width: 100%; border-collapse: collapse;\">\n"
"                <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; width: 40%; text-transform: uppercase; letter-spacing: 1px;\">Vrsta</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"object.appointment_type_id.name\"></t></td>\n"
"                </tr>\n"
"                <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Referenca</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"object.name\"></t></td>\n"
"                </tr>\n"
"                <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Datum i vrijeme</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"format_datetime(object.start_datetime, dt_format='full')\"></t></td>\n"
"                </tr>\n"
"                <t t-if=\"object.staff_id\">\n"
"                <tr style=\"border-bottom: 1px solid #e2e8f0;\">\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Osoblje</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"object.staff_id.name\"></t></td>\n"
"                </tr>\n"
"                </t>\n"
"                <t t-if=\"object.location\">\n"
"                <tr>\n"
"                    <td style=\"padding: 10px 0; color: #718096; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;\">Lokacija</td>\n"
"                    <td style=\"padding: 10px 0; color: #121212; font-size: 14px; font-weight: 600;\"><t t-out=\"object.location\"></t></td>\n"
"                </tr>\n"
"                </t>\n"
"            </table>\n"
"        </div>\n"
"\n"
"        <p style=\"font-size: 14px; color: #718096; line-height: 1.6;\">Ako trebate promijeniti ili otkazati termin, možete upravljati svojim terminom online.</p>\n"
"\n"
"        <div style=\"text-align: center; margin-top: 30px;\">\n"
"            <a t-attf-href=\"/appointment/manage/{{object.access_token}}\" style=\"background-color: #9EA700; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 14px; display: inline-block;\">\n"
"                Upravljaj terminom\n"
"            </a>\n"
"        </div>\n"
"    </div>\n"
"\n"
"    <!-- Footer -->\n"
"    <div style=\"background: #373627; padding: 20px 30px; text-align: center; border-radius: 0 0 8px 8px;\">\n"
"        <p style=\"color: #BCBBA7; font-size: 12px; margin: 0;\"><t t-out=\"object.company_id.name\"></t> • <t t-out=\"object.company_id.email or ''\"></t></p>\n"
"    </div>\n"
"</div>\n"
"        "

