<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="signup_fields" name="Auth Signup form fields">
        <div class="floating-label-group">
            <input type="text" name="login" class="form-control cy-input" t-att-value="login"
                   id="login" t-att-readonly="'readonly' if only_passwords else None"
                   required="required" autofocus="autofocus" autocapitalize="off"
                   t-attf-class="form-control cy-input#{' cy-input--error' if error else ''}"
                   placeholder=" "/>
            <label for="login">Email</label>
        </div>
        <div class="floating-label-group">
            <input type="text" class="form-control cy-input" name="name" id="name"
                   placeholder=" " required="required" t-att-value="name"
                   t-att-readonly="'readonly' if only_passwords else None"
                   t-att-autofocus="'autofocus' if login and not only_passwords else None"/>
            <label for="name">Your Name</label>
        </div>

        <div class="floating-label-group">
            <input type="password" class="form-control cy-input" name="password" id="password"
                   placeholder=" " required="required"
                   t-att-autofocus="'autofocus' if only_passwords else None"/>
            <label for="password">Password</label>
        </div>

        <div class="floating-label-group">
            <input type="password" class="form-control cy-input" name="confirm_password" id="confirm_password"
                   placeholder=" " required="required"/>
            <label for="confirm_password">Confirm Password</label>
        </div>
        <p class="cy-password-error"/>
    </template>
</odoo>