<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the standard report layout to change the default window title -->
    <template id="report_layout_inherit" inherit_id="web.report_layout" name="Cyllo Report Layout Inherit">
        <xpath expr="//title/t" position="replace">
            <t t-esc="title or 'Cyllo Report'"/>
        </xpath>
    </template>

    <!-- Inherit the report preview layout (used in Studio and previews) -->
    <template id="report_preview_layout_inherit" inherit_id="web.report_preview_layout" name="Cyllo Report Preview Layout Inherit">
        <xpath expr="//title/t" position="replace">
            <t t-esc="title or 'Cyllo Report'"/>
        </xpath>
    </template>
</odoo>
