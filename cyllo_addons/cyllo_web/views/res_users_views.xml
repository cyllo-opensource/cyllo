<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Inherits users form view-->
    <record id="view_res_users_form" model="ir.ui.view">
        <field name="name">view.res.users.form</field>
        <field name="model">res.users</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tz']" position="before">
                <field name="dark_mode_selection"/>
                <field name="start_time" widget="timepicker" invisible="dark_mode_selection == 'none'"/>
                <field name="end_time" widget="timepicker" invisible="dark_mode_selection == 'none'"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_users_form_simple_modif" model="ir.ui.view">
        <field name="name">view.res.users.form</field>
        <field name="model">res.users</field>
        <field name="priority" eval="0"/>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tz']" position="before">
                <field name="dark_mode_selection"/>
                <field name="start_time" widget="timepicker" invisible="dark_mode_selection == 'none'"/>
                <field name="end_time" widget="timepicker" invisible="dark_mode_selection == 'none'"/>
            </xpath>
        </field>
    </record>

    <record id="view_res_users_form_onboarding" model="ir.ui.view">
        <field name="name">view.res.users.form.cyllo.onboarding</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="first_time" invisible="1"/>
                <div class="cy-app-install-guidance-message alert-success"
                     role="status"
                     invisible="first_time">
                    You will be able to create and edit the user by navigating to
                    Settings → Users &amp; Companies → Users
                </div>
            </xpath>
            <xpath expr="//field[@name='login']" position="attributes">
                <attribute name="readonly">not first_time and id == context.get('uid')</attribute>
            </xpath>
        </field>
    </record>
</odoo>