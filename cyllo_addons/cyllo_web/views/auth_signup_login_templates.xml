<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="signup" inherit_id="auth_signup.signup" name="Signup">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}" />
                <t t-set="body_classname" t-value="'bg-100'" />
                <t t-set="no_header" t-value="True" />
                <t t-set="no_footer" t-value="True" />
                <section class="cy-instance cy-instance-signup">

                    <!-- Background decoration -->
                    <div class="cy-instance_bg">
                        <img src="/cyllo_web/static/src/img/hero-des-r.svg" alt=""
                            class="cy-instance_bg-img" />
                    </div>

                    <!-- Toast container -->
                    <div id="cy-toast-container" class="cy-toast-container"></div>

                    <!-- Card wrapper -->
                    <div class="cy-instance_box">
                        <div class="cy-instance_content">

                            <!-- Logo & DB Name -->
                            <div class="cy-login-logo-wrap">
                                <img src="/cyllo_web/static/src/img/cyllo.svg" alt="Cyllo logo"
                                    class="cy-login-logo-img" />
                                <span t-if="request and request.db" class="cy-current-db-name">
                                    <i class="ri-database-2-line"></i>
                                    <t t-out="request.db" />
                                </span>
                            </div>

                            <!-- Form area -->
                            <div class="cy-step4 cy-form">
                                <form class="oe_signup_form" role="form"
                                    t-attf-action="/web/signup"
                                    method="post" t-if="not message"
                                    novalidate="novalidate"
                                    onsubmit="this.action = '/web/signup' + location.hash">

                                    <div class="cy-form_title">
                                        <span class="cy-instance-title">Get started with Cyllo</span>
                                        <span class="cy-login-subtitle">Please enter your details to
                                            create an account</span>
                                    </div>

                                    <input type="hidden" name="csrf_token"
                                        t-att-value="request.csrf_token()" />
                                    <t t-call="cyllo_web.signup_fields">
                                        <t t-set="only_passwords"
                                            t-value="bool(token and not invalid_token)" />
                                    </t>

                                    <!-- Server-side auth error (hidden, picked up by JS toast) -->
                                    <p t-if="error"
                                        id="cy-server-error"
                                        class="cy-server-error-hidden"
                                        t-esc="error" />

                                    <!-- Actions row -->
                                    <div class="cy-login-actions">
                                        <div class="cy-login-buttons">
                                            <button type="submit" id="signup_button"
                                                class="btn btn1">Sign Up</button>
                                        </div>

                                        <div class="cy-login_bottom">
                                            <div class="cy-login-signup-row">
                                                <p t-if="signup_enabled" class="para"> Already have
                                                    an account? <a
                                                        t-attf-href="/web/login?{{ keep_query() }}"
                                                        class="click">Log In</a>
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <input type="hidden" name="redirect" t-att-value="redirect" />
                                    <input type="hidden" name="token" t-att-value="token" />
                                    <div class="o_login_auth d-none" />
                                </form>
                                <t t-if="message">
                                    <p class="alert alert-success" role="status">
                                        <t t-esc="message" />
                                    </p>
                                </t>
                            </div>

                            <!-- Database link -->
                            <p class="para cy-login-db-link"> Looking to organize your database? <a
                                    class="click db-click" href="/web/database/selector">Click Here</a>
                            </p>

                        </div>
                    </div>

                </section>
            </t>
        </xpath>
    </template>
    <template id="reset_password" inherit_id="auth_signup.reset_password" name="Reset password">
        <xpath expr="//t[@t-call='web.login_layout']" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data" t-value="{'style': 'height: 100%;'}" />
                <t t-set="body_classname" t-value="'bg-100'" />
                <t t-set="no_header" t-value="True" />
                <t t-set="no_footer" t-value="True" />
                <section class="cy-instance cy-instance-reset-password">

                    <!-- Background decoration -->
                    <div class="cy-instance_bg">
                        <img src="/cyllo_web/static/src/img/hero-des-r.svg" alt=""
                            class="cy-instance_bg-img" />
                    </div>

                    <!-- Toast container -->
                    <div id="cy-toast-container" class="cy-toast-container"></div>

                    <!-- Card wrapper -->
                    <div class="cy-instance_box">
                        <div class="cy-instance_content">

                            <!-- Logo & DB Name -->
                            <div class="cy-login-logo-wrap">
                                <img src="/cyllo_web/static/src/img/cyllo.svg" alt="Cyllo logo"
                                    class="cy-login-logo-img" />
                                <span t-if="request and request.db" class="cy-current-db-name">
                                    <i class="ri-database-2-line"></i>
                                    <t t-out="request.db" />
                                </span>
                            </div>

                            <t t-if="message">
                                <div
                                    class="d-flex justify-content-center success-box-section my-auto">
                                    <div class="cy-success-box text-center">
                                        <i class="ri-checkbox-circle-line reset-success-tick text-success"></i>
                                        <h4 class="cyllo-semibold">Reset Link Sent!</h4>
                                        <p>Password reset instructions have been sent to your email
                                            address.</p>
                                        <a class="click" href="/web/login">Back to Login</a>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <!-- Form area -->
                                <div class="cy-step4 cy-form">
                                    <form class="oe_reset_password_form" role="form"
                                        t-attf-action="/web/reset_password"
                                        method="post"
                                        onsubmit="this.action = '/web/reset_password' + location.hash">

                                        <div class="cy-form_title">
                                            <span class="cy-instance-title">Reset Password</span>
                                            <span class="cy-login-subtitle">Enter your email to
                                                receive password reset instructions</span>
                                        </div>

                                        <input type="hidden" name="csrf_token"
                                            t-att-value="request.csrf_token()" />

                                        <t t-if="token and not invalid_token">
                                            <t t-call="auth_signup.fields">
                                                <t t-set="only_passwords" t-value="1" />
                                            </t>
                                        </t>

                                        <t t-if="not token">
                                            <div class="floating-label-group">
                                                <input type="text" name="login"
                                                    class="form-control cy-input"
                                                    t-att-value="login"
                                                    id="login"
                                                    required="required" autofocus="autofocus"
                                                    autocapitalize="off"
                                                    placeholder=" " />
                                                <label for="login">Email</label>
                                            </div>
                                        </t>

                                        <!-- Server-side auth error (hidden, picked up by JS toast) -->
                                        <p t-if="error"
                                            id="cy-server-error"
                                            class="cy-server-error-hidden"
                                            t-esc="error" />

                                        <input type="hidden" name="redirect" t-att-value="redirect" />
                                        <input type="hidden" name="token" t-att-value="token" />

                                        <!-- Actions row -->
                                        <div class="cy-login-actions">
                                            <div class="cy-login-buttons">
                                                <button type="submit" id="reset_password_button"
                                                    class="btn btn1">Reset Password</button>
                                            </div>

                                            <div class="cy-login_bottom">
                                                <div class="cy-login-signup-row">
                                                    <a t-if="not token or invalid_token"
                                                        class="click"
                                                        t-attf-href="/web/login?{{ keep_query() }}">Back
                                                        to Login
                                                    </a>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="o_login_auth d-none" />
                                    </form>
                                </div>
                            </t>

                            <!-- Database link -->
                            <p class="para cy-login-db-link"> Looking to organize your database? <a
                                    class="click db-click" href="/web/database/selector">Click Here</a>
                            </p>

                        </div>
                    </div>

                </section>
            </t>
        </xpath>
    </template>
</odoo>