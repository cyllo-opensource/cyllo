<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <!-- Client action for showing the onboarding component-->
    <record id="action_first_time" model="ir.actions.client">
        <field name="name">Initial Setup</field>
        <field name="tag">onboarding</field>
        <field name="target">current</field>
    </record>
    <!--    Menu item with action as the action_first_time-->
    <menuitem id="menu_action_first_time"
              name="Onboarding"
              sequence="-1000000"
              action="action_first_time"
              groups="base.group_system"
    />
</odoo>
