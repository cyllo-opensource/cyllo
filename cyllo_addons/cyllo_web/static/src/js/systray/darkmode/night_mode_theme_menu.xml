<?xml version="1.0" encoding="UTF-8"?>
<!--  This is a template for a systray theme menu  -->
<templates id="template">
    <t t-name="NightModeTheme" owl="1">
        <div t-att-data-tooltip="state.checked ? 'Light Mode' : 'Dark Mode'" class="systray_dark_root cy-systray-parent-class" t-ref="root"
            t-on-click.stop.prevent="onToggleClick">
            <label for="checkbox"
                class="toggle checkbox-label cy-checkbox-label cy-checkbox-label-dark-mode">
                <input id="cy_check" class="input" type="checkbox" t-model="state.checked" />
                <div class="icon-dark icon--dynamic" t-ref="iconContainer">
                    <div class="icon-dark icon--moon-dark">
                        <i class="ri-moon-line cy-icons cy-stray-icon-sp"></i>
                    </div>

                    <div class="icon-dark icon--sun-dark">
                        <i class="ri-sun-line cy-icons cy-stray-icon-sp"></i>
                    </div>
                </div>
            </label>
            <span t-if="props.nameShow" class="cy-systray-label">
                <t t-esc="state.checked ? 'Light Mode' : 'Dark Mode'" />
            </span>
        </div>
    </t>
</templates>