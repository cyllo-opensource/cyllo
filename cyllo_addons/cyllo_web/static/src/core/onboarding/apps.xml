<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!-- Template for individual apps -->
    <t t-name="cyllo_web.apps" owl="1">
        <div class="cy_onboarding_demo_apps_label "
             t-att-app-id="this.props.app_data.id"
             t-on-click="() => this.select_app(this.props.app_data)"
             t-att-class="{ 'cy_onboarding_selected': this.props.selected_apps and Object.values(this.props.selected_apps).includes(this.props.app_data.id)}">
            <img class="cy_onboarding_demo_apps_icon_container"
                 t-att-src="this.props.app_data.icon"/>
            <span class="cy_onboarding_demo_apps_label_text"
                  t-esc="this.props.app_data.shortdesc"/>
            <span class="cy_onboarding_demo_apps_checkbox_indicator">
                <i class="ri-check-line"/>
            </span>
        </div>
    </t>
</templates>
