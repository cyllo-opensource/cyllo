<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="cyllo_web.AppSearchBar" owl="1">
        <WithSearch t-if="state.searchViewFields"
            resModel="'ir.module.module'"
            searchViewArch="searchViewArch"
            searchViewFields="state.searchViewFields"
            searchMenuTypes="['filter', 'groupBy']"
            t-slot-scope="search">
            <SearchBar/>
            <DomainWatcher domain="search.domain" onDomainChange="props.onDomainChange"/>
        </WithSearch>
    </t>
</templates>