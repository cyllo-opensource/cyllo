<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="web.LoadingIndicator" t-inherit-mode="extension" owl="1">
        <xpath expr="//span[hasclass('o_loading_indicator')]" position="replace">
            <span class="o_loading_indicator" t-att-class="transition.className">
                <span class="spinner-border spinner-border-sm m-0" role="status"/>
                Loading
                <t t-if="env.debug" t-esc="' (' + state.count + ')'"/>
            </span>
        </xpath>
    </t>

</templates>