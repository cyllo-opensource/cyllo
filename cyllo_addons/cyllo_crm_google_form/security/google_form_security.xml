<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="google_form_company_rule" model="ir.rule">
            <field name="name">Google Form: Current Company Only</field>
            <field name="model_id" ref="model_google_form"/>
            <field name="domain_force">[('company_id', '=', company_id)]</field>
        </record>

        <record id="google_form_questions_company_rule" model="ir.rule">
            <field name="name">Google Form Questions: Current Company Only</field>
            <field name="model_id" ref="model_google_form_questions"/>
            <field name="domain_force">[('google_form_id.company_id', '=', company_id)]</field>
        </record>

    </data>
</odoo>
