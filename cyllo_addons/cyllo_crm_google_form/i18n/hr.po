#. module: cyllo_crm_google_form
#: model:mail.template,body_html:cyllo_crm_google_form.email_template_google_form_share
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333;\">\n"
"                    <p>Dear Recipient,</p>\n"
"                    <p>Please fill in the following form:</p>\n"
"                    <p>\n"
"                        <a t-att-href=\"object.form_url or ''\" target=\"_blank\" style=\"background-color:#9EA700;color:#fff;padding:10px 20px;border-radius:4px;text-decoration:none;display:inline-block;font-weight:bold;\">\n"
"                            Click Here to Open the Form\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>Or copy and paste this link into your browser:<br>\n"
"                        <a t-att-href=\"object.form_url or ''\" target=\"_blank\">\n"
"                            <t t-esc=\"object.form_url or 'URL not available — please contact us.'\"></t>\n"
"                        </a>\n"
"                    </p>\n"
"                    <br>\n"
"                    <p>Thank you,<br>\n"
"                        <t t-esc=\"user.name\"></t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px; color: #333;\">\n"
"                    <p>Poštovani primatelju,</p>\n"
"                    <p>Molimo ispunite sljedeći obrazac:</p>\n"
"                    <p>\n"
"                        <a t-att-href=\"object.form_url or ''\" target=\"_blank\" style=\"background-color:#9EA700;color:#fff;padding:10px 20px;border-radius:4px;text-decoration:none;display:inline-block;font-weight:bold;\">\n"
"                            Kliknite ovdje za otvaranje obrasca\n"
"                        </a>\n"
"                    </p>\n"
"                    <p>Ili kopirajte i zalijepite ovu vezu u preglednik:<br>\n"
"                        <a t-att-href=\"object.form_url or ''\" target=\"_blank\">\n"
"                            <t t-esc=\"object.form_url or 'URL nije dostupan — molimo kontaktirajte nas.'\"></t>\n"
"                        </a>\n"
"                    </p>\n"
"                    <br>\n"
"                    <p>Hvala,<br>\n"
"                        <t t-esc=\"user.name\"></t>\n"
"                    </p>\n"
"                </div>\n"
"            "

