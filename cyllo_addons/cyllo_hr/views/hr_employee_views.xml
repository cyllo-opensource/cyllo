<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_employee_kanban_inherit_cyllo_hr" model="ir.ui.view">
        <field name="name">view.hr.employee.kanban.inherit.cyllo.hr</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="arch" type="xml">
            <xpath expr='//div[hasclass("oe_kanban_global_click")]'
                   position='attributes'>
                <attribute name="class" add="cy_oe_kanban" separator=" "/>
            </xpath>
        </field>
    </record>
</odoo>