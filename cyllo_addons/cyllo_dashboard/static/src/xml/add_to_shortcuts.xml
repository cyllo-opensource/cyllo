<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cyllo_dashboard.AddToShortcuts" owl="1">
        <CogMenuItem t-if="!state.isAddedToShortcut and this.env.config.actionId"
            onClick="() => this.addToShortcuts()" accesskey="'Y'">
            <t t-set-slot="icon"><i class="ri-folder-add-line" /></t>
            <t t-set-slot="text">Add to Shortcuts</t>
        </CogMenuItem>
        <CogMenuItem t-if="state.isAddedToShortcut and this.env.config.actionId"
            onClick="() => this.removeFromShortcuts()" accesskey="'S'">
            <t t-set-slot="icon"><i class="ri-folder-reduce-line" /></t>
            <t t-set-slot="text">Remove From Shortcuts</t>
        </CogMenuItem>
    </t>
</templates>