<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <!-- "Account Settings" body: rendered inline in the non-admin
         dashboard rail (the Login History card stays admin-only).
         Holds the email signature, notification type and the
         groups / access rights tiles. -->
    <t t-name="cyllo_dashboard.AccountSettingsPanel">
        <div class="cy_account_settings_panel">
            <div class="cy_user_dashboard_info_grid">
                <div class="cy_user_dashboard_info_row cy_user_dashboard_info_row--wide">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="cy_user_dashboard_info_label">Email Signature</span>
                        <button
                            t-on-click="() => this.editSignature()"
                            class="btn cyllo-userdashboard-feature-btn"
                            title="Edit signature">
                            <i class="ri-pencil-fill" />
                        </button>
                    </div>
                    <div class="cy_account_settings_signature">
                        <t t-out="markupSignature" />
                    </div>
                </div>
                <div class="cy_user_dashboard_info_row cy_user_dashboard_info_row--wide">
                    <span class="cy_user_dashboard_info_label pb-1">Notification Type</span>
                    <div class="cy_user_dashboard_notif_row" role="radiogroup">
                        <div class="form-check cy_notif_toggle_item">
                            <input
                                t-att-checked="props.notifType === 'email' ? 'checked' : ''"
                                t-on-input="(ev) => this.onInputNotifType(ev)"
                                t-att-id="notifRadioIds.email"
                                t-att-name="notifGroupName"
                                type="radio"
                                class="form-check-input cy_notif_toggle_input"
                                value="email" />
                            <label class="cy-userdashboard--detail cy_notif_toggle_label" t-att-for="notifRadioIds.email">Handle by Email</label>
                        </div>
                        <div class="form-check cy_notif_toggle_item">
                            <input
                                t-att-checked="props.notifType === 'inbox' ? 'checked' : ''"
                                t-on-input="(ev) => this.onInputNotifType(ev)"
                                t-att-id="notifRadioIds.inbox"
                                t-att-name="notifGroupName"
                                type="radio"
                                class="form-check-input cy_notif_toggle_input"
                                value="inbox" />
                            <label class="cy-userdashboard--detail cy_notif_toggle_label" t-att-for="notifRadioIds.inbox">Handle in Cyllo</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="cy_user_dashboard_access_grid">
                <div
                    t-on-click="onClickGroups"
                    class="cy-non-admin-box_container cyllo_useradmin-state--btn">
                    <i class="ri-group-fill cyllo_useradmin--icon" />
                    <span>Groups</span>
                </div>
                <div
                    t-on-click="onClickAccessRights"
                    class="cy-non-admin-box_container cyllo_useradmin-state--btn">
                    <i class="ri-folders-fill cyllo_useradmin--icon" />
                    <span>Access Right</span>
                </div>
                <div
                    t-on-click="onClickRecordRules"
                    class="cy-non-admin-box_container cyllo_useradmin-state--btn">
                    <i class="ri-stack-fill cyllo_useradmin--icon" />
                    <span>Record Rules</span>
                </div>
            </div>
        </div>
    </t>
    <!-- Signature editor: the content component rendered by the dialog
         service; the service environment carries the dialogData the
         inner <Dialog> chrome needs. -->
    <t t-name="cyllo_dashboard.SignatureEditDialog">
        <Dialog size="'md'" title="'Email Signature'">
            <textarea
                t-att-value="state.draft"
                t-on-input="(ev) => this.onSignatureInput(ev)"
                name="email_signature"
                class="w-100 cy_signature_dialog_input"
                placeholder="--"
                rows="5"
                autofocus="autofocus" />
            <t t-set-slot="footer">
                <button
                    t-on-click="() => this.save()"
                    class="btn btn-primary"
                    type="button">Save</button>
                <button
                    t-on-click="() => this.props.close()"
                    class="btn btn-secondary"
                    type="button">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>