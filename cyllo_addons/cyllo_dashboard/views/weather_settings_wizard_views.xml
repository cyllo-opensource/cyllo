<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_weather_settings_wizard_form" model="ir.ui.view">
        <field name="name">weather.setup.wizard.form</field>
        <field name="model">weather.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Weather Settings">
                <group>
                    <field name="api_key" password="True" required="1"
                           placeholder="OpenWeatherMap API key"/>
                    <field name="location_set" widget="radio"/>
                    <field name="city" placeholder="e.g. Kozhikode"
                           invisible="location_set != 'manual'"
                           required="location_set == 'manual'"/>
                </group>
                <footer>
                    <button string="Save"
                            name="action_save_weather"
                            type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
