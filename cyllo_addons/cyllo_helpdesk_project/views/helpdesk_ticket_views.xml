<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_inherit_project" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form.inherit.project</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="cyllo_helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_create_task" type="object" string="Create Task" class="oe_highlight" invisible="not use_project"
                        groups="project.group_project_user,project.group_project_manager"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="use_project" invisible="1"/>
                <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not use_project or task_count == 0">
                    <field name="task_count" widget="statinfo" string="Tasks"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="project_id" invisible="not use_project"/>
            </xpath>
        </field>
    </record>
</odoo>
