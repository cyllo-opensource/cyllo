<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_team_view_form_inherit_project" model="ir.ui.view">
        <field name="name">helpdesk.team.view.form.inherit.project</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="cyllo_helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_project']" position="after">
                <field name="project_id"
                       invisible="not use_project"
                       required="use_project"/>
            </xpath>
        </field>
    </record>
</odoo>
