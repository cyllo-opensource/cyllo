<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_task_form2_inherit_helpdesk" model="ir.ui.view">
        <field name="name">project.task.form.inherit.helpdesk</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="helpdesk_ticket_id" invisible="not helpdesk_ticket_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
