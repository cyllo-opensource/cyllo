<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_algo_config_form" model="ir.ui.view">
        <field name="name">algo.config.form</field>
        <field name="model">algo.config</field>
        <field name="arch" type="xml">
            <form string="Algorithm Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="field_type"/>
                                <field name="custom_field_id" attrs="{'invisible': [('field_type', '!=', 'custom')], 'required': [('field_type', '=', 'custom')]}"/>
                                <field name="weightage" sum="Total Weightage"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_algo_config" model="ir.actions.act_window">
        <field name="name">Algorithm Configuration</field>
        <field name="res_model">algo.config</field>
        <field name="view_mode">tree,form</field>
    </record>
    
</odoo>
