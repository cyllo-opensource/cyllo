<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="DemandPredictionDashboard" owl="1">
        <t t-if="demandState.showTable">
            <div class="demand_prediction-pdf cyllo-background cy_prediction_container cy-demand-v2 h-100"
                 t-ref="root">

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- PAGE HEADER                                           -->
                <!-- ══════════════════════════════════════════════════════ -->
                <div class="cy-demand-header">
                    <div class="cy-demand-headline">
                        <div class="d-flex align-items-center gap-2">
                            <h1 class="cy-demand-title">Demand Prediction Dashboard</h1>
                            <a href="/cyllo_sale_analytics/static/docs/Demand_Forecasting_User_Manual.pdf"
                               target="_blank"
                               class="cy-demand-doc"
                               title="Documentation">
                                <i class="ri-question-line"/>
                            </a>
                        </div>
                        <div class="cy-demand-subrow">
                            <span class="cy-demand-subtitle" t-esc="demandSummary"/>
                            <t t-if="demandState.formattedDate.startDate and demandState.formattedDate.endDate">
                                <span class="cy-demand-datepill"
                                      t-att-title="'Actual sales from ' + demandState.formattedDate.startDate + ' to ' + demandState.formattedDate.endDate">
                                    <i class="ri-calendar-line"/>
                                    <t t-esc="this.shortDate(demandState.formattedDate.startDate)"/> –
                                    <t t-esc="this.shortDate(demandState.formattedDate.endDate)"/>
                                </span>
                            </t>
                        </div>
                    </div>
                    <div class="cy-demand-actions">
                        <FilterDropdown mainClass="'dropdown-filters-sale cy-demand-filter'"
                                        class="'btn btn-primary'"
                                        onClick.bind="datePeriod"
                                        display_name="demandState.labels.filters || 'Filters'"
                                        name="demandState.labels.filters || 'Demand filters'">
                            <t t-set-slot="contents">
                                <div class="col-12">
                                    <label for="act-start-date"
                                           class="cy-marketing-auto-dialog-txt">Start Date:</label>
                                    <div>
                                        <input type="date"
                                               id="act-start-date"
                                               t-att-max="dateToday"
                                               class="start_date w-100 form-control"
                                               name="start-date"
                                               t-model="demandState.actStartDate"/>
                                    </div>
                                </div>
                                <div class="col-12 my-3">
                                    <label for="end-date"
                                           class="cy-marketing-auto-dialog-txt">End Date:</label>
                                    <div>
                                        <input type="date"
                                               id="act-end-date"
                                               t-att-max="dateToday"
                                               class="end_date w-100 form-control"
                                               name="end-date"
                                               t-model="demandState.actEndDate"/>
                                    </div>
                                </div>
                                <div class="col-12 my-3">
                                    <label for="period-dmd">Future Periods:</label>
                                    <input class="form-control cy-button-stroke"
                                           type="number"
                                           min="0"
                                           max="500"
                                           id="period-dmd"
                                           value="30"
                                           placeholder="Future Period"
                                           t-model="demandState.periodDemand"
                                           title="Period for Forecasting"/>
                                </div>
                                <div class="col-12 my-3">
                                    <label for="frequency">Frequency:</label>
                                    <select id="frequency"
                                            class="form-select cy-button-stroke"
                                            t-model="demandState.frequencyDemand"
                                            title="Frequency for Forecasting">
                                        <option value="D">Day</option>
                                        <option value="M">Month</option>
                                        <option value="Y">Year</option>
                                    </select>
                                </div>
                            </t>
                        </FilterDropdown>

                        <div class="position-relative">
                            <Dropdown class="'btn-group dropdown-fit-content cy-demand-export'"
                                      togglerClass="'btn btn-primary'"
                                      showCaret="true">
                                <t t-set-slot="toggler">
                                    <span class="ri-upload-line"/>
                                    Export
                                </t>
                                <DropdownItem onSelected.bind="exportDemandPDF">
                                    <span class="ri-file-pdf-line"/>
                                    <span class="ms-2">PDF</span>
                                </DropdownItem>
                                <DropdownItem onSelected.bind="exportDemandPNG">
                                    <span class="ri-file-image-line"/>
                                    <span class="ms-2">PNG</span>
                                </DropdownItem>
                                <DropdownItem onSelected.bind="exportDemandXLSX">
                                    <span class="ri-file-excel-line"/>
                                    <span class="ms-2">XLSX</span>
                                </DropdownItem>
                            </Dropdown>
                        </div>

                        <button type="button"
                                class="btn btn-primary d-flex align-items-center gap-1"
                                t-on-click="demandForecastAction">
                            <span class="ri-refresh-line"/>
                            Re-run forecast
                        </button>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- BODY: product rail + main column                       -->
                <!-- ══════════════════════════════════════════════════════ -->
                <div class="cy-demand-body">

                    <!-- ── product rail ─────────────────────────────────── -->
                    <aside class="cy-demand-rail">
                        <div class="cy-demand-search">
                            <i class="ri-search-line"/>
                            <input type="search"
                                   class="cy-demand-search-input"
                                   placeholder="Search products"
                                   t-model="state.search"
                                   aria-label="Search products"/>
                        </div>
                        <ul class="cy-demand-prodlist" t-if="state.prodList.length">
                            <t t-foreach="state.prodList" t-as="prod" t-key="prod_index">
                                <t t-set="prod" t-value="Object.values(prod)[0]"/>
                                <li class="cy-demand-prod"
                                    t-att-class="{'cy-demand-prod--active': prod[0] == demandState.defaultProduct[0]}"
                                    t-on-click="() => this.onClickProduct(prod)">
                                    <span class="cy-demand-prod-avatar"
                                          t-att-style="'background-color: ' + this.avatarColor(prod_index)">
                                        <t t-esc="this.prodInitials(prod[1])"/>
                                        <!-- Product photo; the initials above stay visible
                                             for products without one. -->
                                        <img t-if="this.prodImage(prod[0])"
                                             class="cy-demand-prod-avatar-img"
                                             t-att-src="'/web/image/product.product/' + prod[0] + '/image_128'"
                                             t-att-alt="this.prodName(prod[1])"
                                             loading="lazy"
                                             t-on-error="(ev) => ev.target.classList.add('is-broken')"/>
                                    </span>
                                    <span class="cy-demand-prod-text">
                                        <span class="cy-demand-prod-name" t-esc="this.prodName(prod[1])"/>
                                        <span class="cy-demand-prod-code"
                                              t-if="this.prodCode(prod[1])"
                                              t-esc="this.prodCode(prod[1])"/>
                                    </span>
                                    <span t-if="this.prodDelta(prod[0]) !== null"
                                          t-attf-class="cy-demand-prod-delta {{ this.prodDeltaClass(prod[0]) }}"
                                          t-esc="this.prodDeltaLabel(prod[0])"/>
                                </li>
                            </t>
                        </ul>
                        <div t-if="demandState.status === 'none' and !state.prodList.length"
                             class="cy-demand-skeleton">
                            <div t-foreach="[0, 1, 2, 3, 4, 5]" t-as="row" t-key="row"
                                 class="cy-demand-skeleton-row">
                                <span class="cy-demand-skeleton-avatar"/>
                                <span class="cy-demand-skeleton-lines">
                                    <span class="cy-demand-skeleton-line"/>
                                    <span class="cy-demand-skeleton-line short"/>
                                </span>
                            </div>
                        </div>
                        <div t-elif="!state.prodList.length" class="cy-demand-rail-empty">
                            No products found
                        </div>
                    </aside>

                    <!-- ── main column ──────────────────────────────────── -->
                    <section class="cy-demand-main">

                        <!-- loading -->
                        <div t-if="demandState.status === 'none'" class="cy-demand-loading">
                            <div class="cy-grid-loading-spinner">
                                <span class="cy-grid-loading-dot"/>
                                <span class="cy-grid-loading-dot"/>
                                <span class="cy-grid-loading-dot"/>
                            </div>
                            <span class="cy-sheet-loading-label">Loading your data…</span>
                        </div>

                        <!-- not enough data for this product -->
                        <t t-elif="!demandState.noData">
                            <div class="cy-demand-empty cy-no_data">
                                <i class="ri-bar-chart-box-line cy-demand-empty-icon"/>
                                <h3 class="cy-demand-empty-title"
                                    t-esc="'Not enough data for ' + selectedProductName + '.'"/>
                                <p class="cy-demand-empty-text">
                                    Sales data is insufficient for this frequency.
                                    Increase the sales data by adjusting the start and end dates.
                                </p>
                            </div>
                        </t>

                        <!-- dashboard -->
                        <t t-else="">
                            <!-- product header card -->
                            <div class="cy-demand-card cy-demand-prodcard">
                                <div class="cy-demand-prodhead">
                                    <span class="cy-demand-prodhead-avatar"
                                          t-att-style="'background-color: ' + this.avatarColor(this.selectedProductIndex)">
                                        <t t-esc="this.prodInitials(demandState.defaultProduct[1])"/>
                                        <img t-if="this.prodImage(demandState.defaultProduct[0])"
                                             class="cy-demand-prod-avatar-img"
                                             t-att-src="'/web/image/product.product/' + demandState.defaultProduct[0] + '/image_128'"
                                             t-att-alt="this.prodName(demandState.defaultProduct[1])"
                                             t-on-error="(ev) => ev.target.classList.add('is-broken')"/>
                                    </span>
                                    <div class="cy-demand-prodhead-text">
                                        <span class="cy-demand-eyebrow">Product</span>
                                        <span class="cy-demand-prodtitle"
                                              t-esc="demandState.defaultProduct[1]"/>
                                    </div>
                                </div>
                                <div class="cy-demand-avgprice">
                                    <span class="cy-demand-avgprice-label">Avg. price</span>
                                    <span class="cy-demand-avgprice-value" t-esc="this.formatMoney(avgPrice)"/>
                                </div>
                            </div>

                            <!-- KPI cards -->
                            <div class="cy-demand-kpis">
                                <div class="cy-demand-kpi">
                                    <span class="cy-demand-kpi-label">Forecast units</span>
                                    <span class="cy-demand-kpi-value" t-esc="this.formatNumber(forecastTotals.qty)"/>
                                    <span t-if="unitsDeltaPct !== null"
                                          t-attf-class="cy-demand-kpi-sub {{ unitsDeltaPct >= 0 ? 'is-up' : 'is-down' }}">
                                        <i t-attf-class="ri-arrow-{{ unitsDeltaPct >= 0 ? 'up' : 'down' }}-sf"/>
                                        <t t-esc="Math.abs(unitsDeltaPct)"/>% vs last
                                        <t t-esc="comparedPeriods"/> periods
                                    </span>
                                </div>
                                <div class="cy-demand-kpi">
                                    <span class="cy-demand-kpi-label">Forecast revenue</span>
                                    <span class="cy-demand-kpi-value" t-esc="this.formatMoney(forecastTotals.revenue)"/>
                                    <span t-if="comparedRevenue"
                                          t-attf-class="cy-demand-kpi-sub {{ revenueDelta >= 0 ? 'is-up' : 'is-down' }}">
                                        <i t-attf-class="ri-arrow-{{ revenueDelta >= 0 ? 'up' : 'down' }}-sf"/>
                                        <t t-esc="this.formatMoney(Math.abs(revenueDelta))"/> vs actual
                                    </span>
                                </div>
                                <div class="cy-demand-kpi">
                                    <span class="cy-demand-kpi-label">Peak demand</span>
                                    <span class="cy-demand-kpi-value">
                                        <t t-esc="this.formatNumber(forecastTotals.peak ? forecastTotals.peak.qty : 0)"/>
                                        <span class="cy-demand-kpi-unit">units</span>
                                    </span>
                                    <span class="cy-demand-kpi-sub is-alert" t-if="forecastTotals.peak">
                                        <t t-esc="this.shortDate(forecastTotals.peak.date)"/> · plan stock ahead
                                    </span>
                                </div>
                                <div class="cy-demand-kpi">
                                    <span class="cy-demand-kpi-label">Forecast accuracy</span>
                                    <span class="cy-demand-kpi-value">
                                        <t t-esc="accuracy"/><span class="cy-demand-kpi-unit">%</span>
                                    </span>
                                    <span class="cy-demand-kpi-sub is-muted">
                                        MAPE <t t-esc="mape"/>% · last
                                        <t t-esc="accuracyMetrics.periods"/> periods
                                    </span>
                                </div>
                            </div>

                            <!-- chart card -->
                            <div class="cy-demand-card cy-demand-chartcard">
                                <div class="cy-demand-cardhead">
                                    <h3 class="cy-demand-cardtitle">Quantity sold — actual vs forecast</h3>
                                    <div class="cy-demand-charttools">
                                        <span class="cy-demand-legend">
                                            <span class="cy-demand-legend-item">
                                                <i class="cy-demand-swatch is-actual"/>Actual
                                            </span>
                                            <span class="cy-demand-legend-item">
                                                <i class="cy-demand-swatch is-forecast"/>Forecast
                                            </span>
                                        </span>
                                        <span class="cy-demand-segmented">
                                            <button type="button"
                                                    t-attf-class="cy-demand-segbtn {{ state.typeChart === 'bar' ? 'is-on' : '' }}"
                                                    t-on-click="() => this.onClickChartType('bar')">Bars</button>
                                            <button type="button"
                                                    t-attf-class="cy-demand-segbtn {{ state.typeChart === 'line' ? 'is-on' : '' }}"
                                                    t-on-click="() => this.onClickChartType('line')">Line</button>
                                        </span>
                                    </div>
                                </div>
                                <div class="cy-demand-chartwrap chart-col" t-ref="chart-container">
                                    <div id="demand_prediction_chart" class="demand_prediction_chart"/>
                                </div>
                            </div>

                            <!-- period table card -->
                            <div class="cy-demand-card cy-demand-tablecard">
                                <div class="cy-demand-table-scroll" t-ref="table-scroll">
                                    <table class="cy-demand-table">
                                        <thead>
                                            <tr>
                                                <th class="cy-demand-table-label">Period</th>
                                                <t t-foreach="analyticsTable.analysisTableActual"
                                                   t-as="data" t-key="'a_' + data_index">
                                                    <th t-esc="this.shortDate(data.date)"/>
                                                </t>
                                                <t t-foreach="analyticsTable.analysisTableForecast"
                                                   t-as="data" t-key="'f_' + data_index">
                                                    <th class="is-forecast" t-esc="this.shortDate(data.date)"/>
                                                </t>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <th class="cy-demand-table-label">Quantity sold</th>
                                                <t t-foreach="analyticsTable.analysisTableActual"
                                                   t-as="data" t-key="'qa_' + data_index">
                                                    <td t-esc="this.formatNumber(data.qty)"/>
                                                </t>
                                                <t t-foreach="analyticsTable.analysisTableForecast"
                                                   t-as="data" t-key="'qf_' + data_index">
                                                    <td class="is-forecast is-strong" t-esc="this.formatNumber(data.qty)"/>
                                                </t>
                                            </tr>
                                            <tr>
                                                <th class="cy-demand-table-label">Avg. sales price</th>
                                                <t t-foreach="analyticsTable.analysisTableActual"
                                                   t-as="data" t-key="'pa_' + data_index">
                                                    <td t-esc="this.formatNumber(data.avg_price)"/>
                                                </t>
                                                <t t-foreach="analyticsTable.analysisTableForecast"
                                                   t-as="data" t-key="'pf_' + data_index">
                                                    <td class="is-forecast" t-esc="this.formatNumber(data.avg_price)"/>
                                                </t>
                                            </tr>
                                            <tr>
                                                <th class="cy-demand-table-label">Revenue</th>
                                                <t t-foreach="analyticsTable.analysisTableActual"
                                                   t-as="data" t-key="'ra_' + data_index">
                                                    <td t-esc="this.formatNumber(data.sub_total)"/>
                                                </t>
                                                <t t-foreach="analyticsTable.analysisTableForecast"
                                                   t-as="data" t-key="'rf_' + data_index">
                                                    <td class="is-forecast" t-esc="this.formatNumber(data.subtotal)"/>
                                                </t>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </t>
                    </section>
                </div>
            </div>
        </t>
        <t t-else="">
            <div class="cyllo-background cy_prediction_container cy-demand-v2 h-100 cy-demand-v2--empty">
                <div class="cy-demand-header">
                    <div class="cy-demand-headline">
                        <div class="d-flex align-items-center gap-2">
                            <h1 class="cy-demand-title">Demand Prediction Dashboard</h1>
                            <a href="/cyllo_sale_analytics/static/docs/Demand_Forecasting_User_Manual.pdf"
                               target="_blank"
                               class="cy-demand-doc"
                               title="Documentation">
                                <i class="ri-question-line"/>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="cy-demand-card cy-demand-empty cy-no_data">
                    <i class="ri-folder-forbid-line cy-demand-empty-icon"/>
                    <h3 class="cy-demand-empty-title">No data has been recorded.</h3>
                    <p class="cy-demand-empty-text">
                        There should be sale orders for demand prediction. The dataset is
                        too small to perform a meaningful prediction — the model may have
                        limited accuracy due to the small dataset size.
                    </p>
                </div>
            </div>
        </t>
    </t>
</templates>
