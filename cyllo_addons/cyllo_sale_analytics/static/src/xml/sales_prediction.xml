<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="SalesPredictionDashboard" owl="1">
        <div class="cy-main cyllo-background h-100 p-4">

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- LOADING STATUS (restoring a saved forecast, if any)     -->
            <!-- Shown until checkSavedForecast() decides whether to open -->
            <!-- the results view or fall back to the guidelines screen,  -->
            <!-- so the guidelines page no longer flashes on every open.  -->
            <!-- ══════════════════════════════════════════════════════ -->
            <div t-if="state.status === 'loading'" class="d-flex flex-column align-items-center justify-content-center h-100">
                <div class="spinner-border text-success" style="width: 3rem; height: 3rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-muted mt-3 mb-0">Loading...</p>
            </div>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- GUIDELINES STATUS                                       -->
            <!-- ══════════════════════════════════════════════════════ -->
            <div t-if="state.status === 'guidelines'" class="d-flex flex-column align-items-center justify-content-center h-100">
                <div class="text-center p-5 card shadow-sm border-0 rounded w-75">
                    <div class="mb-4 text-center mx-auto d-flex justify-content-center">
                        <iframe src="https://lottie.host/embed/f44dd487-2810-485e-a159-fb4377a8db29/jODYvOf9p9.lottie"
                                class="border-0 w-100" height="200"
                                sandbox="allow-scripts allow-same-origin"></iframe>
                    </div>
                    <h2 class="mb-4 text-success fw-bold">Sales Forecasting Data Preparation</h2>
                    <p class="mb-5 text-muted fs-5">
                        Welcome to the advanced predictive forecasting module.
                        Please select a date range and the necessary data fields you wish to include
                        to train your models securely and generate a dynamic analysis table.
                    </p>
                    <button class="btn cy-btn-green py-3 px-5 shadow fw-bold fs-5" t-on-click="startWizard">
                        <i class="ri-play-circle-line me-2"></i> Start Configuration Wizard
                    </button>
                </div>
            </div>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- WIZARD STATUS                                           -->
            <!-- ══════════════════════════════════════════════════════ -->
            <div t-if="state.status === 'wizard'" class="card shadow-sm border-0 rounded p-4 h-100 d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-4 border-bottom pb-2">
                    <h3 class="mb-0">Training Data Wizard</h3>
                    <a href="/cyllo_sale_analytics/static/docs/viewer.html?file=Sales_Forecasting_User_Manual.pdf" target="_blank" class="text-success fs-4" title="Documentation">
                        <i class="ri-question-line"/>
                    </a>
                </div>

                <div class="row mb-4">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Start Date</label>
                        <input type="date" class="form-control bg-light"
                               t-att-class="{'cy-date-invalid': state.startDateInvalid}"
                               t-on-change="() => this.state.startDateInvalid = false"
                               t-model="state.startDate"/>
                        <small t-if="state.startDateInvalid" class="text-danger">Start Date is required.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">End Date</label>
                        <input type="date" class="form-control bg-light"
                               t-att-class="{'cy-date-invalid': state.endDateInvalid}"
                               t-on-change="() => this.state.endDateInvalid = false"
                               t-model="state.endDate"/>
                        <small t-if="state.endDateInvalid" class="text-danger">A valid End Date is required.</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Aggregate</label>
                        <select class="form-select bg-light" t-model="state.aggregate">
                            <option value="M">Monthly</option>
                            <option value="Y">Yearly</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold d-block mb-3">Select Model Mode</label>
                    <div class="btn-group shadow-sm" role="group">
                        <button type="button" class="btn px-4"
                                t-attf-class="btn-{{state.mode === 'algorithm' ? 'success' : 'outline-success'}}"
                                t-on-click="() => this.setMode('algorithm')">
                            Algorithm Mode
                        </button>
                        <button type="button" class="btn px-4"
                                t-attf-class="btn-{{state.mode === 'ai' ? 'success' : 'outline-success'}}"
                                t-on-click="() => this.setMode('ai')">
                            AI Mode
                        </button>
                    </div>
                </div>

                <!-- AI-mode news keywords (optional; used to semantically search news) -->
                <div t-if="state.mode === 'ai'" class="mb-3 cy-fcnews-keyfield">
                    <label class="form-label fw-semibold small mb-1" for="cy_fcnews_kw">
                        <i class="ri-newspaper-line me-1"></i> News Keywords
                        <span class="text-muted fw-normal">(optional, comma-separated — searched semantically &amp; given higher preference)</span>
                    </label>
                    <input type="text" id="cy_fcnews_kw" class="form-control form-control-sm"
                           t-model="state.keywords"
                           placeholder="e.g. currency exchange rate, global crisis, fuel prices"/>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-bold mb-0">Pre-defined Fields</label>
                        <div>
                            <button class="btn btn-sm btn-outline-success me-2" t-on-click="selectAllCustomFields">Select All</button>
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="clearAllCustomFields">Clear All</button>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_customer_info"
                                       t-att-checked="state.customFields.customer_info"
                                       t-on-change="() => this.toggleCustomField('customer_info')"/>
                                <label class="form-check-label" for="chk_customer_info"><t t-esc="state.predefinedLabels.customer_info"/></label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_sale_order_amount"
                                       t-att-checked="state.customFields.sale_order_amount"
                                       t-on-change="() => this.toggleCustomField('sale_order_amount')"/>
                                <label class="form-check-label" for="chk_sale_order_amount"><t t-esc="state.predefinedLabels.sale_order_amount"/></label>
                            </div>
                        </div>
                        <div class="col-md-3" t-if="state.availableFields.includes('opportunity_id')">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_leads"
                                       t-att-checked="state.customFields.leads_opportunities"
                                       t-on-change="() => this.toggleCustomField('leads_opportunities')"/>
                                <label class="form-check-label" for="chk_leads"><t t-esc="state.predefinedLabels.leads_opportunities"/></label>
                            </div>
                        </div>
                        <div class="col-md-3" t-if="state.availableFields.includes('opportunity_id')">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_opp_id"
                                       t-att-checked="state.customFields.opportunity_id"
                                       t-on-change="() => this.toggleCustomField('opportunity_id')"/>
                                <label class="form-check-label" for="chk_opp_id"><t t-esc="state.predefinedLabels.opportunity_id"/></label>
                            </div>
                        </div>
                        <div class="col-md-3" t-if="state.availableFields.includes('campaign_id')">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_campaign_id"
                                       t-att-checked="state.customFields.campaign_id"
                                       t-on-change="() => this.toggleCustomField('campaign_id')"/>
                                <label class="form-check-label" for="chk_campaign_id"><t t-esc="state.predefinedLabels.campaign_id"/></label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_holidays"
                                       t-att-checked="state.customFields.holidays"
                                       t-on-change="() => this.toggleCustomField('holidays')"/>
                                <label class="form-check-label" for="chk_holidays"><t t-esc="state.predefinedLabels.holidays"/></label>
                            </div>
                        </div>
                        <div class="col-md-3" t-if="state.availableFields.includes('website_id')">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_visitors"
                                       t-att-checked="state.customFields.website_visitors"
                                       t-on-change="() => this.toggleCustomField('website_visitors')"/>
                                <label class="form-check-label" for="chk_visitors"><t t-esc="state.predefinedLabels.website_visitors"/></label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_products"
                                       t-att-checked="state.customFields.product_features"
                                       t-on-change="() => this.toggleCustomField('product_features')"/>
                                <label class="form-check-label" for="chk_products"><t t-esc="state.predefinedLabels.product_features"/></label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_seasonality"
                                       t-att-checked="state.customFields.seasonality"
                                       t-on-change="() => this.toggleCustomField('seasonality')"/>
                                <label class="form-check-label" for="chk_seasonality"><t t-esc="state.predefinedLabels.seasonality"/></label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="chk_active_customer"
                                       t-att-checked="state.customFields.active_customer"
                                       t-on-change="() => this.toggleCustomField('active_customer')"/>
                                <label class="form-check-label" for="chk_active_customer"><t t-esc="state.predefinedLabels.active_customer"/></label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex-grow-1 d-flex flex-column mb-3 overflow-hidden min-vh-25">
                    <label class="form-label fw-bold mb-2">Additional Application Fields (ir.fields)</label>
                    <div class="card h-100 shadow-sm border">
                        <div class="card-header bg-light p-2">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Search application fields..."
                                   t-model="state.searchIrField"/>
                        </div>
                        <div class="card-body p-0 overflow-auto h-100">
                            <div class="list-group list-group-flush rounded-bottom">
                                <t t-foreach="filteredIrFields" t-as="field" t-key="field.name">
                                    <label class="list-group-item list-group-item-action d-flex align-items-center cursor-pointer">
                                        <input class="form-check-input me-3" type="checkbox"
                                               t-att-checked="state.selectedIrFields[field.name]"
                                               t-on-change="() => this.toggleIrField(field.name)"/>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold"><t t-esc="field.field_description"/></span>
                                            <small class="text-muted"><t t-esc="field.name"/></small>
                                        </div>
                                    </label>
                                </t>
                                <div t-if="filteredIrFields.length === 0" class="p-4 text-center text-muted">
                                    No fields match your search.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-end mt-2 pt-3 border-top">
                    <div class="alert alert-warning mb-0 d-flex align-items-center shadow-sm w-50 py-2" role="alert">
                        <i class="ri-error-warning-line flex-shrink-0 me-2"></i>
                        <div class="small">
                            <strong>Note:</strong> Generating this dataset might take time on huge volumes.
                        </div>
                    </div>
                    <div class="d-flex gap-3">
                        <button class="btn btn-secondary px-4 py-2" t-on-click="cancelWizard">Cancel</button>
                        <button class="btn cy-btn-green px-4 py-2 shadow-sm" t-on-click="submitWizard">Generate Query</button>
                    </div>
                </div>
            </div>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- PROCESSING STATUS                                       -->
            <!-- ══════════════════════════════════════════════════════ -->
            <div t-if="state.status === 'processing'" class="d-flex flex-column align-items-center justify-content-center h-100">
                <div class="text-center p-5 card shadow-sm border-0 rounded">
                    <div class="mb-4 text-center mx-auto d-flex justify-content-center">
                        <iframe src="https://lottie.host/embed/f44dd487-2810-485e-a159-fb4377a8db29/jODYvOf9p9.lottie"
                                class="border-0 w-100" height="200"
                                sandbox="allow-scripts allow-same-origin"></iframe>
                    </div>
                    <h3 class="text-success mb-2">Processing Dynamic Query...</h3>
                    <p class="text-muted">Fetching and organizing the dataset based on your selections. This may take a moment.</p>
                </div>
            </div>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- TABLE STATUS                                            -->
            <!-- ══════════════════════════════════════════════════════ -->
            <div t-if="state.status === 'table'" class="card cy-training-card shadow-sm border-0 rounded p-4 h-100 d-flex flex-column">

                <!-- ── Header ── -->
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <div>
                        <h3 class="mb-1">Generated Training Dataset</h3>
                        <p class="text-muted mb-0 small">
                            <span class="fw-bold"><t t-esc="state.totalRows"/></span> record(s) generated
                            (preview: up to 100 rows). Download to get all data.
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <button t-if="state.activeTab === 'table'"
                                class="btn cy-btn-green shadow-sm" t-on-click="downloadAllXlsx"
                                t-att-disabled="state.downloading">
                            <t t-if="state.downloading">
                                <span class="spinner-border spinner-border-sm me-1" role="status"/> Downloading…
                            </t>
                            <t t-else="">
                                <i class="ri-file-excel-2-line me-1"></i> Download XLSX
                            </t>
                        </button>
                        <button class="btn btn-secondary shadow-sm" t-on-click="cancelWizard">
                            <i class="ri-refresh-line me-1"></i> New Query
                        </button>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════════ -->
                <!--  TOP-LEVEL TABS:  Chart View  |  Table View        -->
                <!--  (Chart tab shown only in AI mode)                 -->
                <!-- ══════════════════════════════════════════════════ -->
                <ul class="nav nav-tabs mb-0" role="tablist">
                    <!-- Chart tab – AI and Algorithm modes -->
                    <li t-if="state.mode === 'ai' or state.mode === 'algorithm'" class="nav-item" role="presentation">
                        <button class="nav-link fw-bold"
                                t-att-class="{'active text-success': state.activeTab === 'chart', 'text-muted': state.activeTab !== 'chart'}"
                                t-on-click="() => this.toggleTab('chart')">
                            <i class="ri-bar-chart-2-line me-1"></i> Chart View
                        </button>
                    </li>
                    <!-- Table tab – always visible -->
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold"
                                t-att-class="{'active text-success': state.activeTab === 'table', 'text-muted': state.activeTab !== 'table'}"
                                t-on-click="() => this.toggleTab('table')">
                            <i class="ri-table-line me-1"></i> Table View
                        </button>
                    </li>
                </ul>

                <!-- ══════════════════════════════════════════════════ -->
                <!--  CHART VIEW PANEL  (AI mode only)                  -->
                <!-- ══════════════════════════════════════════════════ -->
                <div t-if="(state.mode === 'ai' or state.mode === 'algorithm') and state.activeTab === 'chart'"
                     class="border border-top-0 rounded-bottom p-3 bg-white shadow-sm flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <h4 class="text-success mb-0">Predicted Sales For 10 Periods</h4>
                        <span class="badge cy-fcnews-mode-badge"
                              t-esc="state.mode === 'ai' ? 'AI Prediction' : 'Algorithm Prediction'"/>
                    </div>
                    <t t-if="state.hasForecast">
                        <div class="cy-fcnews-stage position-relative">
                            <div id="sale_forecast_wizard_chart" class="cy-forecast-wizard-chart"></div>

                            <!-- Floating news trigger (AI mode) -->
                            <button t-if="state.mode === 'ai'" type="button"
                                    class="cy-fcnews-fab btn d-flex align-items-center justify-content-center shadow"
                                    title="News keywords &amp; recompute"
                                    t-on-click="toggleNewsPanel">
                                <i class="ri-newspaper-line"></i>
                            </button>

                            <!-- Non-modal side panel: edit keywords &amp; recompute -->
                            <div t-if="state.mode === 'ai' and state.showNewsPanel"
                                 class="cy-fcnews-panel d-flex flex-column shadow-lg rounded">
                                <div class="cy-fcnews-panel__head d-flex align-items-center justify-content-between px-3 py-2">
                                    <span class="fw-semibold">
                                        <i class="ri-search-eye-line me-1"></i> News Keywords
                                    </span>
                                    <button type="button" class="btn btn-sm btn-link p-0 cy-fcnews-panel__close"
                                            t-on-click="closeNewsPanel" title="Close">
                                        <i class="ri-close-line"></i>
                                    </button>
                                </div>
                                <div class="cy-fcnews-panel__body flex-grow-1 px-3 py-2 overflow-auto">
                                    <p class="text-muted mb-2 cy-fcnews-hint">
                                        Add/refine comma-separated keywords, then recompute from the
                                        algorithm baseline. Unchanged keywords keep the current result.
                                    </p>
                                    <textarea class="form-control form-control-sm cy-fcnews-panel__input" rows="3"
                                              t-model="state.panelKeywords"
                                              placeholder="e.g. currency exchange rate, global crisis, oil price"></textarea>
                                </div>
                                <div class="cy-fcnews-panel__foot px-3 py-2 border-top d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            t-on-click="closeNewsPanel">Close</button>
                                    <button type="button" class="btn btn-sm cy-fcnews-btn flex-grow-1"
                                            t-att-disabled="state.recomputing"
                                            t-on-click="recomputePrediction">
                                        <span t-if="state.recomputing">
                                            <i class="ri-loader-4-line cy-fcnews-spin me-1"></i> Recomputing…
                                        </span>
                                        <span t-else="">
                                            <i class="ri-refresh-line me-1"></i> Recompute Prediction
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="alert alert-warning m-3 shadow-sm d-flex align-items-center" role="alert">
                            <i class="ri-error-warning-line fs-3 me-3"></i>
                            <div>
                                <h5 class="alert-heading fw-bold mb-1">Insufficient Data for Forecasting</h5>
                                <p class="mb-0 text-wrap">
                                    At least 5 data points/periods are required to generate a reliable forecast. Please select a wider date range or a different aggregation level (e.g., Daily or Weekly) with more sales activity.
                                </p>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- ══════════════════════════════════════════════════ -->
                <!--  TABLE VIEW PANEL                                   -->
                <!--  Contains inner sub-tabs when sub-tables exist:    -->
                <!--  • Main Summary                                     -->
                <!--  • Sale Orders Breakdown                           -->
                <!--  • Order Lines Breakdown  (if product_features chosen) -->
                <!-- ══════════════════════════════════════════════════ -->
                <div t-if="state.activeTab === 'table'"
                     class="border border-top-0 rounded-bottom flex-grow-1 d-flex flex-column overflow-hidden">

                    <!-- ── Inner sub-tab bar (only when aggregation produced sub-tables) ── -->
                    <div t-if="state.hasSubTables" class="border-bottom bg-light px-3 pt-2 d-flex align-items-center gap-3 flex-wrap">
                        <!-- Sub-tab buttons -->
                        <ul class="nav nav-pills nav-sm mb-2 flex-grow-1" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link py-1 px-3 small fw-semibold"
                                        t-att-class="{'active': state.activeSubTab === 'main'}"
                                        t-on-click="() => this.toggleSubTab('main')">
                                    <i class="ri-list-check me-1"></i> Main Summary
                                </button>
                            </li>
                            <li class="nav-item" t-if="state.saleOrdersTableData.length > 0">
                                <button class="nav-link py-1 px-3 small fw-semibold"
                                        t-att-class="{'active': state.activeSubTab === 'sale_orders'}"
                                        t-on-click="() => this.toggleSubTab('sale_orders')">
                                    <i class="ri-shopping-cart-line me-1"></i> Sale Orders Breakdown
                                    <span class="badge bg-secondary text-black ms-1"><t t-esc="state.saleOrdersTableData.length"/></span>
                                </button>
                            </li>
                            <li class="nav-item" t-if="state.orderLinesTableData.length > 0">
                                <button class="nav-link py-1 px-3 small fw-semibold"
                                        t-att-class="{'active': state.activeSubTab === 'orderlines'}"
                                        t-on-click="() => this.toggleSubTab('orderlines')">
                                    <i class="ri-list-ordered me-1"></i> Order Lines Breakdown
                                    <span class="badge bg-secondary text-black ms-1"><t t-esc="state.orderLinesTableData.length"/></span>
                                </button>
                            </li>
                        </ul>
                    </div>

                    <!-- Info banner for sub-tables -->
                    <div t-if="state.hasSubTables and state.activeSubTab === 'sale_orders'"
                         class="alert alert-info mb-0 py-2 px-3 small border-0 rounded-0 d-flex align-items-center">
                        <i class="ri-information-line me-2 fs-5 flex-shrink-0"></i>
                        <span>
                            <strong>Sale Orders Breakdown:</strong> One row per Sale Order in the aggregated period.
                        </span>
                    </div>
                    <div t-if="state.hasSubTables and state.activeSubTab === 'orderlines'"
                         class="alert alert-info mb-0 py-2 px-3 small border-0 rounded-0 d-flex align-items-center">
                        <i class="ri-information-line me-2 fs-5 flex-shrink-0"></i>
                        <span>
                            <strong>Order Lines Breakdown:</strong> One row per Order Line inside the aggregated period.
                        </span>
                    </div>

                    <!-- ── MAIN SUMMARY TABLE ── -->
                    <div t-if="state.activeSubTab === 'main'"
                         class="cy-training-table-wrapper flex-grow-1 overflow-auto">
                        <table class="table table-hover table-striped mb-0 align-middle text-nowrap">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th class="fw-semibold cy-sf-index-col"><t t-esc="colLabel('Index')"/></th>
                                    <t t-foreach="state.tableColumns" t-as="col" t-key="col">
                                        <th class="fw-semibold"><t t-esc="colLabel(col)"/></th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.tableDataPreview" t-as="row" t-key="row_index">
                                    <tr>
                                        <td class="text-muted"><t t-esc="row_index + 1"/></td>
                                        <t t-foreach="state.tableColumns" t-as="col" t-key="col">
                                            <td><t t-esc="row[col]"/></td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <!-- ── SALE ORDERS BREAKDOWN TABLE ── -->
                    <div t-if="state.activeSubTab === 'sale_orders' and state.saleOrdersTableData.length > 0"
                         class="cy-training-table-wrapper flex-grow-1 overflow-auto">
                        <table class="table table-hover table-striped mb-0 align-middle text-nowrap">
