<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="CustomerChurnDetails" owl="1">
        <div t-ref="root"
             class="cy_prediction_container customer-data-churn-main cyllo-background cy-cust-v2">
            <div class="cy-cust-shell">

                <!-- page header -->
                <div class="cy-cust-head">
                    <button type="button"
                            class="cy-cust-back"
                            title="Go Back"
                            t-on-click="() => this.goBack()">
                        <i class="ri-arrow-left-s-line"/>
                    </button>
                    <div class="cy-cust-head-text">
                        <h1 class="cy-cust-title"><t t-esc="state.custDetails.custName"/></h1>
                        <p class="cy-cust-sub"
                           t-if="state.dateRange and state.dateRange.length">
                            <t t-esc="periodLabel()"/> ·
                            <t t-esc="state.dateRange[0][0]"/> –
                            <t t-esc="state.dateRange[state.dateRange.length - 1][1]"/>
                        </p>
                    </div>
                </div>

                <!-- churn summary cards -->
                <div class="cy-cust-stats">
                    <div class="cy-cust-stat">
                        <div class="cy-cust-stat-top">
                            <span class="cy-cust-stat-label">Likely to be Churn</span>
                            <span class="cy-cust-stat-icon"><i class="ri-alert-line"/></span>
                        </div>
                        <div t-attf-class="cy-cust-stat-value {{this.churnTone(state.custDetails.Churn)}}"
                             t-esc="churnLabel(state.custDetails.Churn)"/>
                        <span t-attf-class="cy-cust-pill {{this.churnTone(state.custDetails.Churn)}}"
                              t-esc="this.churnNote(state.custDetails.Churn)"/>
                    </div>
                    <div class="cy-cust-stat">
                        <div class="cy-cust-stat-top">
                            <span class="cy-cust-stat-label">Probability of Churn</span>
                            <span class="cy-cust-stat-icon"><i class="ri-pie-chart-line"/></span>
                        </div>
                        <div class="cy-cust-stat-value is-bad">
                            <t t-esc="state.custDetails.prob_yes"/><span class="cy-cust-unit">%</span>
                        </div>
                        <span class="cy-cust-meter">
                            <span class="is-bad"
                                  t-attf-style="width: {{state.custDetails.prob_yes}}%"/>
                        </span>
                    </div>
                    <div class="cy-cust-stat">
                        <div class="cy-cust-stat-top">
                            <span class="cy-cust-stat-label">Probability of Not Churn</span>
                            <span class="cy-cust-stat-icon"><i class="ri-shield-check-line"/></span>
                        </div>
                        <div class="cy-cust-stat-value is-ok">
                            <t t-esc="state.custDetails.prob_no"/><span class="cy-cust-unit">%</span>
                        </div>
                        <span class="cy-cust-meter">
                            <span class="is-ok"
                                  t-attf-style="width: {{state.custDetails.prob_no}}%"/>
                        </span>
                    </div>
                </div>

                <!-- charts + period table -->
                <div t-if="state.custDetails.total_sales" class="cy-cust-grid">
                    <div class="cy-cust-card">
                        <div class="cy-cust-card-head">
                            <h3 class="cy-cust-card-title">
                                <t t-esc="state.labels.total_sale_orders || 'Total Sale Orders'"/>
                            </h3>
                            <span class="cy-cust-chip"><t t-esc="periodLabel()"/></span>
                        </div>
                        <div class="cy-cust-plot">
                            <canvas id="freq_chart"/>
                        </div>
                    </div>
                    <div class="cy-cust-card">
                        <div class="cy-cust-card-head">
                            <h3 class="cy-cust-card-title">
                                <t t-esc="state.labels.total_sale_amount || 'Total Sale Amount'"/>
                            </h3>
                            <span class="cy-cust-chip"><t t-esc="periodLabel()"/></span>
                        </div>
                        <div class="cy-cust-plot">
                            <canvas id="mon_chart"/>
                        </div>
                    </div>
                    <div class="cy-cust-card">
                        <div class="cy-cust-card-head">
                            <h3 class="cy-cust-card-title">
                                <t t-esc="state.labels.period || 'Period'"/>
                            </h3>
                        </div>
                        <div class="cy-cust-periods">
                            <table class="cy-cust-table">
                                <thead>
                                    <tr>
                                        <th><t t-esc="state.labels.period || 'Period'"/></th>
                                        <th class="text-end">Start date</th>
                                        <th class="text-end">End date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="index" t-value="1"/>
                                    <t t-foreach="state.dateRange or []"
                                       t-as="date"
                                       t-key="date_index">
                                        <tr>
                                            <td class="cy-cust-period-name">
                                                <t t-esc="periodLabel()"/>-<t t-esc="index"/>
                                            </td>
                                            <td class="text-end cy-cust-date"><t t-esc="date[0]"/></td>
                                            <td class="text-end cy-cust-date"><t t-esc="date[1]"/></td>
                                        </tr>
                                        <t t-set="index" t-value="index + 1"/>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- sale orders: one always-open card per period -->
                <div t-if="state.custDetails.total_sales" class="cy-cust-period-cards">
                    <t t-foreach="Object.keys(state.saleOrders)"
                       t-as="item" t-key="item_index">
                        <div t-if="state.saleOrders[item].length"
                             class="cy-cust-card cy-cust-orders">
                            <div class="cy-cust-orders-head">
                                <h3 class="cy-cust-orders-title">
                                    <t t-esc="periodLabel()"/>-<t t-esc="item"/>
                                    <span class="cy-cust-orders-count">
                                        <t t-esc="state.saleOrders[item].length"/>
                                    </span>
                                </h3>
                                <button type="button"
                                        class="cy-cust-viewall"
                                        t-on-click="() => this.openAllOrders(item)">
                                    View All
                                </button>
                            </div>
                            <div class="cy-cust-orders-body">
                                <table class="cy-cust-table cy-cust-orders-table">
                                    <thead>
                                        <tr>
                                            <th>Order Number</th>
                                            <th>Date</th>
                                            <th>Salesperson</th>
                                            <th class="text-end">Untaxed Amount</th>
                                            <th class="text-end">Total</th>
                                            <th class="text-end">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.saleOrders[item]"
                                           t-as="order"
                                           t-key="order_index">
                                            <tr t-on-click="() => this.onClickSaleOrder(order.id)">
                                                <td class="cy-cust-order-name">
                                                    <t t-esc="order.name"/>
                                                </td>
                                                <td class="cy-cust-date">
                                                    <t t-esc="order.date_order"/>
                                                </td>
                                                <td class="cy-cust-salesperson">
                                                    <span class="cy-cust-sales">
                                                        <img t-attf-src="/web/image/res.users/{{order.user_id[0]}}/avatar_128"
                                                             t-att-alt="order.user_id[1]"
                                                             loading="lazy"/>
                                                        <t t-esc="order.user_id[1]"/>
                                                    </span>
                                                </td>
                                                <td class="text-end cy-cust-amount">
                                                    <t t-esc="order.amount_untaxed"/>
                                                </td>
                                                <td class="text-end cy-cust-amount">
                                                    <t t-esc="order.amount_total"/>
                                                </td>
                                                <td class="text-end">
                                                    <span t-attf-class="cy-cust-status {{this.orderStateTone(order.state)}}"
                                                          t-esc="order.state"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- empty state -->
                <div t-else="" class="cy-cust-empty">
                    <span class="cy-cust-empty-icon"><i class="ri-file-list-3-line"/></span>
                    <h3 class="cy-cust-empty-title">No Sale Orders</h3>
                    <p class="cy-cust-empty-text">
                        There are no sale orders for <t t-esc="state.custDetails.custName"/>
                        <t t-if="state.dateRange and state.dateRange.length">
                            from <t t-esc="state.dateRange[0][0]"/>
                            to <t t-esc="state.dateRange[state.dateRange.length - 1][1]"/>
                        </t>
                    </p>
                </div>

            </div>
        </div>
    </t>
</templates>
