<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bom_stock_report_company_rule" model="ir.rule">
        <field name="name">BOM Stock Report multi-company</field>
        <field name="model_id" ref="model_bom_stock_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
