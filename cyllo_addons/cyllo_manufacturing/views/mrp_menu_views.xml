<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Hide Manufacturing option in Inventory Operations for users without manufacturing access -->
        <record id="mrp.mrp_operation_picking" model="ir.ui.menu">
            <!-- Explicitly remove stock groups and add mrp group -->
            <field name="groups_id" eval="[
                (3, ref('stock.group_stock_manager')),
                (3, ref('stock.group_stock_user')),
                (4, ref('mrp.group_mrp_user'))
            ]"/>
        </record>
    </data>
</odoo>
