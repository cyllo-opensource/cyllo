<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="appointment_type_table" model="appointment.type">
            <field name="name">Table</field>
            <field name="require_resource">True</field>
            <field name="require_staff">False</field>
            <field name="is_published">True</field>
            <field name="send_confirmation" eval="True"/>
            <field name="confirmation_template_id" ref="cyllo_appointment.email_template_appointment_confirmation"/>
            <field name="send_reminder" eval="True"/>
            <field name="reminder_hours_before">24</field>
            <field name="reminder_template_id" ref="cyllo_appointment.email_template_appointment_reminder"/>
            <field name="send_followup" eval="True"/>
            <field name="followup_hours_after">2</field>
            <field name="followup_template_id" ref="cyllo_appointment.email_template_appointment_followup"/>
            <field name="send_cancellation" eval="True"/>
            <field name="cancellation_template_id" ref="cyllo_appointment.email_template_appointment_cancellation"/>
        </record>
    </data>
</odoo>
