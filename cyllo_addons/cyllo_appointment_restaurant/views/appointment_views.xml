<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appointment_resource_form_inherit_cyllo_restaurant" model="ir.ui.view">
        <field name="name">appointment.resource.form.inherit.cyllo.restaurant</field>
        <field name="model">appointment.resource</field>
        <field name="inherit_id" ref="cyllo_appointment.view_appointment_resource_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_pos_tables"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-cutlery"
                    invisible="not pos_table_ids">
                    <field name="pos_table_ids" widget="statinfo" string="POS Tables"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
