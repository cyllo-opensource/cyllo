"                        <t t-out=\"object.db_name\"></t>\n"
"                        <br>\n"
"                        الوجهة:\n"
"                        <t t-if=\"object.backup_destination == 'local'\">\n"
"                            محلي\n"
"                        </t>\n"
"                        <t t-elif=\"object.backup_destination == 'google_drive'\">\n"
"                            Google Drive\n"
"                        </t>\n"
"                        <t t-elif=\"object.backup_destination == 'ftp'\">\n"
"                            خادم FTP\n"
"                        </t>\n"
"                        <t t-elif=\"object.backup_destination == 'sftp'\">\n"
"                            خادم SFTP\n"
"                        </t>\n"
"                        <t t-elif=\"object.backup_destination == 'dropbox'\">\n"
"                            Dropbox\n"
"                        </t>\n"
"                        <t t-elif=\"object.backup_destination == 'onedrive'\">\n"
"                            Onedrive\n"
"                        </t>\n"
"                        <t t-elif=\"object.backup_destination == 'next_cloud'\">\n"
"                            NextCloud\n"
"                        </t>\n"
"                        <t t-elif=\"object.backup_destination == 'amazon_s3'\">\n"
"                            Amazon S3\n"
"                        </t>\n"
"                        <t t-if=\"object.backup_destination in ('local', 'ftp', 'sftp', 'dropbox','next_cloud','amazon_s3')\">\n"
"                            <br>\n"
"                            مسار النسخة الاحتياطية:\n"
"                            <t t-if=\"object.backup_destination == 'local'\">\n"
"                                <t t-out=\"object.backup_path\"></t>\n"
"                            </t>\n"
"                            <t t-elif=\"object.backup_destination == 'ftp'\">\n"
"                                <t t-out=\"object.ftp_path\"></t>\n"
"                            </t>\n"
"                            <t t-elif=\"object.backup_destination == 'sftp'\">\n"
"                                <t t-out=\"object.sftp_path\"></t>\n"
"                            </t>\n"
"                            <t t-elif=\"object.backup_destination == 'dropbox'\">\n"
"                                <t t-out=\"object.dropbox_folder\"></t>\n"
"                            </t>\n"
"                            <t t-elif=\"object.backup_destination == 'next_cloud'\">\n"
"                                <t t-out=\"object.nextcloud_folder_key\"></t>\n"
"                            </t>\n"
"                            <t t-elif=\"object.backup_destination == 'amazon_s3'\">\n"
"                                <t t-out=\"object.aws_folder_name\"></t>\n"
"                            </t>\n"
"                        </t>\n"
"                        <br>\n"
"                        نوع النسخة الاحتياطية:\n"
"                        <t t-out=\"object.backup_format\"></t>\n"
"                        <br>\n"
"                        <br>\n"
"                        <b>رسالة الخطأ:</b>\n"
"                        <br>\n"
"                        <i>\n"
"                            <t t-out=\"object.generated_exception\"></t>\n"
"                        </i>\n"
"                    </span>\n"
"                </p>\n"
"            </div>\n"
"        "

