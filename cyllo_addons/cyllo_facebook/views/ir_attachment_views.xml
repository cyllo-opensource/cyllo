<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ir_attachment_facebook" model="ir.ui.view">
        <field name="name">view.ir.attachment.cyllo.facebook</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mimetype']" position="after">
                <field name="fb_public_url" widget="url" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>