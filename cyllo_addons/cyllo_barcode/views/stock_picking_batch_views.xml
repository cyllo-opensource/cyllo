<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record for defining a kanban view named 'marketing.campaign.kanban' for the model 'marketing.campaign' -->
    <record id="view_stock_picking_batch_kanban" model="ir.ui.view">
        <field name="name">view.stock.picking.batch.kanban</field>
        <field name="model">stock.picking.batch</field>
        <field name="arch" type="xml">
            <kanban js_class="barcode_kanban" class="cyllo_barcode_kanban" quick_create="false"
                    records_draggable="false" action="open_batch_record" type="object" create="0">
                <field name="name"/>
                <field name="state"/>
                <field name="picking_type_id"/>
                <field name="scheduled_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="card">
                            <div class="card-body">
                                <div class="row d-flex justify-content-between">
                                    <div class="d-flex align-items-center mb-2">
                                        <h4 class="card-title mb-0 flex-grow-1"
                                            t-esc="record.name.value"/>
                                        <div t-att-class="{
                                                'badge-stock-picking': true,
                                                'cy-barcode__ready': record.state.raw_value === 'in_progress',
                                                'cy-barcode__waiting': record.state.raw_value === 'draft',
                                                'cy-barcode__done': record.state.raw_value === 'done'
                                             }"
                                             t-esc="record.state.value"/>
                                        <button class="btn btn-secondary btn-sm w-auto ms-1"
                                                name="open_batch_picking" type="object">
                                            <i class="ri-arrow-right-s-line"/>
                                        </button>
                                    </div>
                                    <p class="text-muted col-sm-6 text-truncate"
                                       t-esc="record.picking_type_id.value"/>
                                    <p class="text-muted col-sm-6 d-flex justify-content-end"
                                       t-esc="record.scheduled_date.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>