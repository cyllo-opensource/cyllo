<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_cyllo_purchase" model="ir.ui.view">
        <field name="name">account.move.form.inherit.cyllo.purchase</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='other_tab']//field[@name='fiscal_position_id']" position="after">
                <field name="three_way_matching_enabled" invisible="1"/>
                <field name="three_way_match" invisible="not three_way_matching_enabled or move_type not in ('in_invoice', 'in_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
