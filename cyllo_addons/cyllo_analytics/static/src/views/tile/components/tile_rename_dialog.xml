<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="cyllo_analytics.TileRenameDialog" owl="1">
        <Dialog title="props.title" size="'sm'">
            <label class="form-label" for="cy_tile_rename_input">Name</label>
            <input id="cy_tile_rename_input"
                   type="text"
                   class="form-control"
                   t-ref="nameInput"
                   t-model="state.name"
                   t-on-keydown="onKeydown"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary"
                        t-att-disabled="!isValid"
                        t-on-click="_confirm">Rename</button>
                <button class="btn btn-secondary"
                        t-on-click="_cancel">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
