<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_document_delete_trash_form" model="ir.ui.view">
        <field name="name">view.document.delete.trash.form</field>
        <field name="model">document.delete.trash</field>
        <field name="arch" type="xml">
            <form>
                <div class="document_delete_trash_form">
                    <h2 class="move_trash_heading">Move to Trash/Delete Document Permanently</h2>
                    <field name="document_file_id" readonly="1" invisible="1"/>
                    <footer>
                        <div class="w-100 doc-delete-modal-footer-container">
                            <div class="d-flex gap-2 w-100 justify-content-center">
                                <button class="document_lock_wizard move_trash" type="object"
                                        name="action_document_move_trash">
                                    Move to Trash
                                </button>
                                <button class="document_lock_wizard move_trash" type="object"
                                        name="action_document_permanent_delete">Delete Permanently
                                </button>
                            </div>
                            <button class="document_cancel_wizard move_trash_wizard" special="cancel" string="Cancel"/>
                        </div>
                    </footer>
                </div>
            </form>
        </field>
    </record>
</odoo>