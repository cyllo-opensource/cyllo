<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="cyllo_ai.ChatSidebar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('history-header')]/dotlottie-player" position="replace">
            <div class="cy-ai-history-title">
                <span class="cy-ai-history-title-icon"><i class="ri-history-line"/></span>
                <span>Chat history</span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('history-body')]/t[@t-if='state.loading']/div" position="replace">
            <div class="cy-ai-history-loading">
                <i class="ri-loader-4-line cy-ai-spin"/>
                <span>Loading conversations…</span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('history-body')]/t[@t-elif='state.sessions.length === 0']/div" position="replace">
            <div class="cy-ai-history-empty">
                <div class="cy-ai-history-empty-icon"><i class="ri-chat-history-line"/></div>
                <div class="cy-ai-history-empty-title">No conversations yet</div>
                <div class="cy-ai-history-empty-text">Your chats with Cyllo AI will be saved here, so you can pick up where you left off.</div>
                <button class="cy-ai-history-empty-btn" t-on-click="() => this.chatSideBarClose()">
                    <i class="ri-chat-new-line"/>
                    <span>Start a new chat</span>
                </button>
            </div>
        </xpath>
    </t>
</templates>
