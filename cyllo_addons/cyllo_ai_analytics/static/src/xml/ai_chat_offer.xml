<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="cyllo_ai.ChatBot" t-inherit-mode="extension">
        <xpath expr="//t[@t-if='state.docked']/div[@t-if='state.offer']" position="replace">
            <div class="cy-ai-offer-card" t-if="state.offer">
                <div class="cy-ai-offer-avatar">
                    <dotlottie-player
                        src="https://lottie.host/f44dd487-2810-485e-a159-fb4377a8db29/jODYvOf9p9.lottie"
                        background="transparent"
                        speed="1"
                        loop=""
                        autoplay=""/>
                </div>
                <div class="cy-ai-offer-title">AI chart suggestions</div>
                <div class="cy-ai-offer-text">Cyllo AI can read the fields of this sheet and suggest charts that fit your data.</div>
                <button class="cy-ai-offer" t-on-click="onOfferClick" t-att-disabled="state.offerLoading">
                    <t t-if="state.offerLoading">
                        <i class="ri-loader-4-line cy-ai-spin"/>
                        <span>Analysing your fields…</span>
                    </t>
                    <t t-else="">
                        <i class="ri-magic-line"/>
                        <span t-esc="state.offer.label"/>
                    </t>
                </button>
            </div>
        </xpath>
    </t>
</templates>
