<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="ir_buttons_view_tree" model="ir.ui.view">
        <field name="name">ir.buttons.view.tree</field>
        <field name="model">ir.buttons</field>
        <field name="arch" type="xml">
            <tree create="false">
                <header>
                    <button name="load_buttons_from_views" string="Load from Views"
                            type="object" class="oe_highlight"/>
                </header>
                <field name="name"/>
                <field name="string"/>
                <field name="type"/>
                <field name="model_id" context="{'model': True}"/>
            </tree>
        </field>
    </record>

    <record id="ir_buttons_view_form" model="ir.ui.view">
        <field name="name">ir.buttons.view.form</field>
        <field name="model">ir.buttons</field>
        <field name="arch" type="xml">
            <form string="Button">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="string"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="model_id" context="{'model': True}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ir_buttons" model="ir.actions.act_window">
        <field name="name">Buttons</field>
        <field name="res_model">ir.buttons</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="ir_buttons_view_tree"/>
        <field name="views" eval="[(ref('ir_buttons_view_tree'), 'tree'), (ref('ir_buttons_view_form'), 'form')]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face"></p>
        </field>
    </record>

    <menuitem id="menu_ir_buttons" name="Buttons" parent="base.next_id_2"
              action="action_ir_buttons" sequence="40"/>
</odoo>
