<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_asset_item_form_inherit_asset_quality" model="ir.ui.view">
        <field name="name">asset.item.form.inherit.asset.quality</field>
        <field name="model">asset.item</field>
        <field name="inherit_id" ref="cyllo_asset_management.view_asset_item_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='quality_check']" position="inside">
                <group>
                    <field name="quality_control_point_id"
                           invisible="not is_quality" 
                           context="{'default_qc_check_for': 'asset'}" 
                           domain=" [('qc_check_for', '=', 'asset')]"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
