<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_asset_asset_form_inherit_asset_quality" model="ir.ui.view">
        <field name="name">asset.asset.form.inherit.asset.quality</field>
        <field name="model">asset.asset</field>
        <field name="inherit_id" ref="cyllo_asset_management.view_asset_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="quality_control" string="Quality Control">
                    <group>
                        <field name="quality_control_point_ids" widget="many2many_tags"
                               context="{'default_qc_check_for': 'asset'}"
                               domain="[('qc_check_for', '=', 'asset')]"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
