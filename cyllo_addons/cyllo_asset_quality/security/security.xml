<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="cyllo_asset_management.group_cyllo_asset_users" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('cyllo_quality.group_cyllo_quality_user'))
        ]"/>
    </record>

    <record id="cyllo_asset_management.group_cyllo_asset_admin" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('cyllo_quality.group_cyllo_quality_manager'))
        ]"/>
    </record>

    <record id="access_asset_quality_user" model="ir.model.access">
        <field name="name">asset.quality.user</field>
        <field name="model_id" ref="model_asset_asset"/>
        <field name="group_id" ref="cyllo_quality.group_cyllo_quality_user"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
