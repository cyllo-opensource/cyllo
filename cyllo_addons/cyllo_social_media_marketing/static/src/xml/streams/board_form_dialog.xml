<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="cyllo_social_media_marketing.BoardFormDialog">
        <Dialog size="'sm'" title="props.title">
            <input type="text" class="o_input rounded-0 form-control" placeholder="Board name"
                   t-model="state.name" t-on-keydown="onKeydown" t-ref="input"/>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm" t-esc="props.confirmLabel"/>
                <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
