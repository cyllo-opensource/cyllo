<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="cyllo_social_media_marketing.PlatformPickerDialog">
        <Dialog size="'md'" title="'Add a social account'" footer="false">
            <div class="o_platform_picker_grid">
                <div class="o_platform_picker_tile" t-foreach="platforms" t-as="entry" t-key="entry.platform"
                    t-on-click="() => this.selectPlatform(entry.platform)">
                    <div class="o_platform_picker_icon" t-attf-style="background: {{ entry.color }}">
                        <i t-att-class="entry.icon" />
                    </div>
                    <span t-esc="entry.moduleLabel" />
                </div>
            </div>
        </Dialog>
    </t>
</templates>
