<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="cyllo_social_media_marketing.ModeRadioField">
        <div role="radiogroup" class="o_mode_badges">
            <t t-foreach="items" t-as="item" t-key="item[0]">
                <span t-attf-class="badge rounded-pill o_mode_badge{{ item[0] === value ? ' o_mode_badge_active' : '' }}{{ props.readonly ? ' o_mode_badge_readonly' : '' }}"
                    t-on-click="() => this.onChange(item[0])"
                    t-esc="item[1]" />
            </t>
            <div class="text-muted" t-if="!items.length">
                No mode is common to all the platforms selected.
            </div>
        </div>
    </t>
</templates>
