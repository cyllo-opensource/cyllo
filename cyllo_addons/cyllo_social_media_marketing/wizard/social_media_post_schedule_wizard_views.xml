<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_media_post_schedule_wizard_form" model="ir.ui.view">
        <field name="name">social.media.post.schedule.wizard.form</field>
        <field name="model">social.media.post.schedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Post">
                <field name="post_id" invisible="1"/>
                <group>
                    <field name="scheduled_date"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Schedule" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_social_media_post_schedule_wizard" model="ir.actions.act_window">
        <field name="name">Schedule Post</field>
        <field name="res_model">social.media.post.schedule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
