<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_campaign_list" model="ir.ui.view">
        <field name="name">view.social.campaign.list</field>
        <field name="model">utm.campaign</field>
        <field name="arch" type="xml">
            <tree string="Campaigns">
                <field name="name"/>
                <field name="social_post_count"/>
                <field name="social_total_engagements"/>
                <field name="social_leads_created"/>
                <field name="social_leads_converted"/>
            </tree>
        </field>
    </record>
    <record id="view_social_campaign_kanban" model="ir.ui.view">
        <field name="name">view.social.campaign.kanban</field>
        <field name="model">utm.campaign</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_dashboard">
                <field name="name"/>
                <field name="social_post_count"/>
                <field name="social_total_engagements"/>
                <field name="social_leads_created"/>
                <field name="social_leads_converted"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_card p-3">
                            <div class="o_kanban_record_top mb-2">
                                <strong class="o_kanban_record_title fs-5">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_body row text-center">
                                <div class="col-6 mb-2">
                                    <div class="fs-4 fw-bold">
                                        <field name="social_post_count"/>
                                    </div>
                                    <div class="text-muted">Posts</div>
                                </div>
                                <div class="col-6 mb-2">
                                    <div class="fs-4 fw-bold">
                                        <field name="social_total_engagements"/>
                                    </div>
                                    <div class="text-muted">Engagements</div>
                                </div>
                                <div class="col-6">
                                    <div class="fs-4 fw-bold">
                                        <field name="social_leads_created"/>
                                    </div>
                                    <div class="text-muted">Leads Created</div>
                                </div>
                                <div class="col-6">
                                    <div class="fs-4 fw-bold">
                                        <field name="social_leads_converted"/>
                                    </div>
                                    <div class="text-muted">Leads Converted</div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_view_social_campaigns" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">utm.campaign</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_social_campaign_kanban')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_social_campaign_list')}),
            (0, 0, {'view_mode': 'form'})]"/>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Campaign
            </p>
            <p>
                Tag your social media posts with a campaign to track its
                posts, engagements, leads created and leads converted.
            </p>
        </field>
    </record>
    <menuitem id="menu_social_campaigns" name="Campaigns"
        action="action_view_social_campaigns"
        sequence="50"
        parent="menu_cyllo_social_media_marketing_root"/>
</odoo>
