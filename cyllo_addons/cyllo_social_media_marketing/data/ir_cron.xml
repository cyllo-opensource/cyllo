<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_capture_audience_snapshot" model="ir.cron">
        <field name="name">Social Media: Capture Daily Audience Snapshot</field>
        <field name="model_id" ref="model_social_media_snapshot"/>
        <field name="state">code</field>
        <field name="code">model._cron_capture_audience_snapshots()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_publish_scheduled_posts" model="ir.cron">
        <field name="name">Social Media: Publish Scheduled Posts</field>
        <field name="model_id" ref="model_social_media_post"/>
        <field name="state">code</field>
        <field name="code">model._cron_publish_scheduled_posts()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
