<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_marketing_social_media">
        <field name="name">Social Media Marketing</field>
        <field name="description">Helps you manage your Social Media Marketing.</field>
        <field name="sequence">19</field>
    </record>

    <record id="group_social_media_user" model="res.groups">
        <field name="name">Social Media User</field>
        <field name="category_id" ref="module_category_marketing_social_media"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_social_media_administrator" model="res.groups">
        <field name="name">Social Media Administrator</field>
        <field name="category_id" ref="module_category_marketing_social_media"/>
        <field name="implied_ids" eval="[Command.link(ref('group_social_media_user'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_social_media_administrator'))]"/>
    </record>
    <record id="social_media_post_rule" model="ir.rule">
        <field name="name">Social Media Post multi company rule</field>
        <field name="model_id" ref="model_social_media_post"/>
        <field name="domain_force">[('company_id', 'in', company_ids +
            [False])]
        </field>
    </record>
    <record id="social_stream_board_rule" model="ir.rule">
        <field name="name">Social Stream Board: own boards only</field>
        <field name="model_id" ref="model_social_stream_board"/>
        <field name="domain_force">[('user_id', '=', user.id), ('company_id', 'in',
            company_ids + [False])]
        </field>
    </record>
    <record id="social_stream_column_rule" model="ir.rule">
        <field name="name">Social Stream Column: own boards only</field>
        <field name="model_id" ref="model_social_stream_column"/>
        <field name="domain_force">[('board_id.user_id', '=', user.id)]</field>
    </record>
</odoo>