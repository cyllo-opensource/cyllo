<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root Menu -->
    <menuitem id="menu_frontdesk_root"
              name="Front Desk"
              web_icon="cyllo_front_desk,static/description/front-desk-black.svg"
              sequence="85"
              groups="group_frontdesk_user,group_frontdesk_admin"/>

    <!-- Top level menus -->
     <menuitem id="menu_frontdesk_dashboard"
              name="Stations"
              parent="menu_frontdesk_root"
              action="action_frontdesk_frontdesk"
              sequence="10"/>

    <menuitem id="menu_frontdesk_visitor"
              name="Visitors"
              parent="menu_frontdesk_root"
              action="action_frontdesk_visitor"
              sequence="20"/>

    <menuitem id="menu_frontdesk_enquiry"
              name="Enquiries"
              parent="menu_frontdesk_root"
              action="action_frontdesk_enquiry"
              sequence="25"/>

    <menuitem id="menu_frontdesk_reporting"
              name="Reporting"
              parent="menu_frontdesk_root"
              action="action_frontdesk_visitor_reporting"
