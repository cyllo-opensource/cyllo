<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Project User -> Green Metrics User -->
    <record id="project.group_project_user" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('cyllo_green_metrics.group_carbon_user'))
        ]"/>
    </record>

    <!-- Project Manager -> Green Metrics Manager -->
    <record id="project.group_project_manager" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('cyllo_green_metrics.group_carbon_manager'))
        ]"/>
    </record>

</odoo>