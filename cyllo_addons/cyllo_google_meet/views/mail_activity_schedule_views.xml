<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_schedule_view_form_google_meet" model="ir.ui.view">
        <field name="name">mail.activity.schedule.view.form.inherit.google.meet</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_type_id']" position="after">
                <field name="is_google_meet"
                       widget="boolean_toggle"
                       invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
