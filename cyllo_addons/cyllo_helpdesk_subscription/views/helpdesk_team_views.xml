<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_team_view_form_inherit_subscription" model="ir.ui.view">
        <field name="name">helpdesk.team.view.form.inherit.subscription</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="cyllo_helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_product_warranty']" position="after">
                <field name="use_subscription"/>
            </xpath>
        </field>
    </record>
</odoo>
