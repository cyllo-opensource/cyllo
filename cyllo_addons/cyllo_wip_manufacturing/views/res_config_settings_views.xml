<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mrp.wip</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_stock_valuation_accounts']" position="inside">
                <setting id="mrp_wip_accounting" title="Work in Progress (WIP)"
                         help="Configure WIP accounts and journals for manufacturing orders.">
                    <field name="wip_active" string="Manufacturing"/>
                    <div class="content-group" invisible="not wip_active">
                        <div class="row mt8">
                            <label for="wip_journal_id" class="col-lg-5 o_light_label"/>
                            <field name="wip_journal_id" required="wip_active"/>
                        </div>
                        <div class="row mt8">
                            <label for="wip_account_id" class="col-lg-5 o_light_label"/>
                            <field name="wip_account_id" required="wip_active"/>
                        </div>
                        <div class="row mt8">
                            <label for="wip_overhead_account_id" class="col-lg-5 o_light_label"/>
                            <field name="wip_overhead_account_id" required="wip_active"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
