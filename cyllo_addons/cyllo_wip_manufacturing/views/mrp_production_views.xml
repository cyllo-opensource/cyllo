<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Tree View for WIP Entries -->
    <record id="view_move_tree_wip" model="ir.ui.view">
        <field name="name">account.move.tree.wip</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <tree string="Journal Entries" create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="name" string="Number"/>
                <field name="partner_id" string="Partner"/>
                <field name="ref" string="Reference"/>
                <field name="journal_id" string="Journal"/>
                <field name="company_id" string="Company"/>
                <field name="amount_total_signed" string="Total" sum="Total Amount"/>
                <field name="state" string="Status" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'"/>
            </tree>
        </field>
    </record>

    <!-- Smart Button on Manufacturing Order -->
    <record id="mrp_production_form_view_inherit_wip" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit.wip</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_wip_entries" type="object" class="oe_stat_button" icon="fa-book" invisible="wip_entry_count == 0">
                    <field name="wip_entry_count" widget="statinfo" string="WIP Entries"/>
                </button>
            </xpath>
        </field>
    </record>

    <!-- Post WIP Entries Action bound to Manufacturing Order form -->
    <record id="action_post_wip_entries_server" model="ir.actions.server">
        <field name="name">Post WIP Entries</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
        <field name="state">code</field>
        <field name="code">
if record:
    action = record.action_post_wip_entries()
        </field>
    </record>
</odoo>
