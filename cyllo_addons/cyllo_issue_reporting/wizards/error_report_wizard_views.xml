<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_error_report_wizard_form" model="ir.ui.view">
        <field name="name">error.report.wizard.form</field>
        <field name="model">error.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Error to Administrator">
                <div class="alert alert-info py-2" role="alert">
                    Please review the error breakdown below and add any steps to reproduce before submitting.
                </div>
                
                <group>
                    <group string="Error Breakdown">
                        <field name="error_type" widget="badge"/>
                        <field name="name"/>
                        <field name="module_name" class="fw-bold text-danger"/>
                        <field name="file_location" class="text-break"/>
                        <field name="user_id"/>
                    </group>
                    <group string="Context">
                        <field name="url" class="text-break font-monospace small" widget="char"/>
                        <field name="error_message" class="text-break"/>
                    </group>
                </group>

                <group string="Feedback &amp; Attachment">
                    <group>
                    <field name="user_notes" placeholder="What were you trying to do when this error occurred?" colspan="2"/>
                    </group>
                    <group>
                    <field name="attachment" filename="attachment_filename" accept=".png,.jpg,.jpeg,.pdf" help="PNG, JPG, JPEG, and PDF file types are accepted"/>
                    <field name="attachment_filename" invisible="1"/>
                    </group>
                </group>

                <notebook>
                    <page string="Detailed Traceback" name="traceback_page">
                        <field name="traceback" widget="text" class="text-monospace font-monospace bg-light p-2 text-break" readonly="1"/>
                    </page>
                </notebook>

                <footer>
                    <button name="action_send_report" string="Submit Report to Admin" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
