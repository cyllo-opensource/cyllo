<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- For Technical / System / RPC / Client Errors -->
    <t t-inherit="web.ErrorDialog" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-set-slot='footer']" position="inside">
            <button t-if="state.canReportAdmin" class="btn btn-outline-danger" t-on-click="onClickReportAdmin">
<!--                <i class="fa fa-paper-plane mr-1 me-1"/>-->
                <span>Report Admin</span>
            </button>
        </xpath>
    </t>

    <!-- (Optional) For User / Validation / Access Warnings -->
    <t t-inherit="web.WarningDialog" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-set-slot='footer']" position="inside">
            <button t-if="state.canReportAdmin" class="btn btn-outline-danger" t-on-click="onClickReportAdmin" groups="cyllo_issue_reporting.group_error_reporting_user">
<!--                <i class="fa fa-paper-plane mr-1 me-1"/>-->
                <span>Report Admin</span>
            </button>
        </xpath>
    </t>

</templates>
