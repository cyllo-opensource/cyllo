<odoo>
    <!-- Add Issue Reporting setting to Odoo Settings -->
    <record id="res_config_settings_view_form_issue_reporting" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.issue.reporting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

                <app string="Issue Reporting"
                     name="issue_reporting">

                    <block title="Issue Reporting">

                        <setting
                            string="Enable Issue Reporting"
                            help="Enable or disable the Issue Reporting feature.">
                            <field name="is_issue_reporting"/>

                        </setting>

                    </block>

                </app>

            </xpath>

        </field>
    </record>
</odoo>