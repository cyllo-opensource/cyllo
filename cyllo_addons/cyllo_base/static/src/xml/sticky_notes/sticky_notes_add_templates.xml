<?xml version="1.0" encoding="UTF-8" ?>
<template xml:space="preserve">
    <!-- Create sticky note template from systray-->
    <t t-name="StickyNotesAdd" owl="1">
        <t t-if="!props.mode">
            <div class="d-flex" style="gap: 8px;">
                <div class="add_note flex-grow-1" t-on-click="props.onAddText" style="justify-content: center;">
                    <i class="ri-add-line add-sticky-note"/>
                    <h6>Add New Note...</h6>
                </div>
                <div class="add_note" t-on-click="props.onAddList" style="width: 44px; justify-content: center; cursor: pointer;" title="New List">
                    <i class="fa fa-check-square-o" style="font-size: 18px; align-self: center; margin: 0;"/>
                </div>
                <div class="add_note" t-on-click="props.onAddDrawing" style="width: 44px; justify-content: center; cursor: pointer;" title="New Drawing">
                    <i class="fa fa-paint-brush" style="font-size: 18px; align-self: center; margin: 0;"/>
                </div>
            </div>
        </t>
        <t t-else="">
            <div class="o_button_close" >
                 <i class="fa fa-undo fa-lg"/>
            </div>
        </t>
    </t>
</template>