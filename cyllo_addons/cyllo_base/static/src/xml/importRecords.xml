<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <!-- Replace the import records in base import -->
    <t t-inherit="base_import.ImportRecords" t-inherit-mode="extension" owl="1">
        <xpath expr="//DropdownItem" position="replace">
            <CogMenuItem onClick="() => this.importRecords()" accesskey="'I'">
                <t t-set-slot="icon"><i class="ri-download-2-line" /></t>
                <t t-set-slot="text">Import records</t>
            </CogMenuItem>
        </xpath>
    </t>
</templates>