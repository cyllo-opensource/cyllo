<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="cyllo_base.NotificationWowl" t-inherit="web.NotificationWowl" t-inherit-mode="extension">
        <xpath expr="//div[@t-on-mouseenter='this.props.freeze']" position="replace">
            <div
                t-attf-class="cy-notification cy-noti_{{props.type}} mb-2"
                t-on-mouseenter="this.props.freeze"
                t-on-mouseleave="this.props.refresh"
                aria-atomic="true"
                aria-live="assertive"
                role="alert">
                <div class="cy-notifi_icon">
                    <i t-if="props.type == 'success'" class="ri-checkbox-circle-line" />
                    <i t-elif="props.type == 'warning'" class="ri-error-warning-line" />
                    <i t-elif="props.type == 'danger'" class="ri-close-circle-line" />
                    <i t-elif="props.type == 'whatsapp'" class="ri-whatsapp-line" />
                    <i t-else="" class="ri-information-line" />
                </div>
                <div class="cy-notifi_body">
                    <div class="cy-notifi_title">
                        <t t-if="props.title" t-out="props.title" />
                        <t t-elif="props.type == 'success'">Success</t>
                        <t t-elif="props.type == 'warning'">Warning</t>
                        <t t-elif="props.type == 'danger'">Error</t>
                        <t t-elif="props.type == 'info'">Info</t>
                        <t t-elif="props.type == 'whatsapp'">WhatsApp</t>
                        <t t-else="">Info</t>
                    </div>
                    <div t-if="props.message" class="cy-notifi_msg">
                        <span>
                            <t t-out="props.message" />
                        </span>
                    </div>
                    <div t-if="props.buttons.length" class="o_notification_buttons d-flex gap-2 mt-2">
                        <button
                            t-foreach="props.buttons"
                            t-as="button"
                            t-attf-class="btn {{button.primary ? 'btn-primary' : 'btn-secondary'}}"
                            t-key="button_index"
                            t-on-click="button.onClick"
                            type="button">
                            <t t-if="button.icon">
                                <i
                                    t-if="button.icon.indexOf('fa-') === 0"
                                    t-att-aria-label="button.name"
                                    t-att-title="button.name"
                                    t-attf-class="fa fa-fw o_button_icon {{button.icon}}"
                                    role="img" />
                                <img t-att-src="button.icon" t-att-alt="button.name" t-else="" />
                            </t>
                            <span t-esc="button.name" />
                        </button>
                    </div>
                </div>
                <span class="cy-notifi_close">
                    <i t-on-click="props.close" class="ri-close-line" />
                </span>
            </div>
        </xpath>
    </t>
</templates>