<?xml version="1.0" encoding="utf-8" ?>
<templates xml:space="preserve">
    <t t-inherit="base_import.ImportAction" t-inherit-mode="extension" owl="1">
        <xpath expr="//a[normalize-space()='Import FAQ']" position="attributes">
            <attribute name="href">https://docs.cyllo.com/exporting-importing-data.html</attribute>
        </xpath>
    </t>
    <t t-inherit="base_import.ImportDataSidepanel" t-inherit-mode="extension" owl="1">
        <xpath expr="//a[normalize-space()='Go to Import FAQ']" position="attributes">
            <attribute name="href">https://docs.cyllo.com/exporting-importing-data.html</attribute>
        </xpath>
    </t>
</templates>
