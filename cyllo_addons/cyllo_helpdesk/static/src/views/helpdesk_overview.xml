<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="cyllo_helpdesk.ToggleTag" owl="1">
        <div class="some_class" style="cursor: pointer">
            <t t-if="toggle.tag">
                <input t-ref="root"
                       class="w-100 o_input_tag text-center p-0 m-0 fw-semibold text-dark fs-6"
                       style="outline: none; box-shadow: none; border: none; background-color: transparent; height: calc(1.5em); min-height: 0; line-height: 1.5;"
                       t-on-blur="onBlurEvent"
                       type="text" inputmode="decimal"
                       pattern="[0-9]*[.,]?[0-9]*"
                       t-att-value="toggle.value"/>
            </t>
            <t t-else="">
                <div t-on-click="changeElement">
                    <span class="fw-semibold text-dark fs-6">
                        <t t-out="toggle.value"/>
                    </span>
                </div>
            </t>
        </div>
    </t>

    <t t-name="cyllo_helpdesk.HelpdeskOverview" owl="1">
        <div class="container-fluid px-4 py-3"
             style="background-color: #FFFFFF; border-bottom: 1px solid #dee2e6;">
            <div class="row g-3 align-items-stretch">

                <!-- Left: hero banner (My Tickets) -->
                <div class="col-12 col-xl-6">
                    <div class="h-100" style="background-color: #FFFFFF; border-radius: 24px;">
                        <!--                <h5 class="fw-bold mb-3" style="font-size: 26px; color: #18301F;">My Tickets</h5>-->
                        <div class="row row-cols-1 row-cols-md-3 g-3">
                            <!-- Metric column: Tickets -->
                            <div class="col">
                                <div class="h-100 bg-white"
                                     style="border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden;">
                                    <div class="cursor-pointer"
                                         style="background-color: #fdffdb; padding: 18px 20px;"
                                         t-on-click="getSearchDetails"
                                         title="My Tickets"
                                         filter_name="user_id, stage_id"
                                         name="cyllo_helpdesk.helpdesk_my_open_ticket_action">
                                        <div style="font-size: 13px; color: #3F5B49;">Tickets</div>
                                        <div class="fw-bold"
                                             style="font-size: 38px; line-height: 1.2; color: #9ea600;"
                                             t-out="ticketData['all_tickets']"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center cursor-pointer"
                                         style="padding: 12px 20px; border-top: 1px solid var(--border-color); font-size: 13px; color: #3F5B49;"
                                         t-on-click="getSearchDetails"
                                         title="Average Open Hours"
                                         filter_name="open_tickets"
                                         name="cyllo_helpdesk.helpdesk_my_ticket_average_open_hours_action">
                                        <span>Avg open hours</span>
                                        <span class="fw-bold"
                                              style="font-size: 16px; color: #18301F;"
                                              t-out="ticketData['average_open_hour']"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center cursor-pointer"
                                         style="padding: 12px 20px; border-top: 1px solid var(--border-color); font-size: 13px; color: #3F5B49;"
                                         t-on-click="getSearchDetails"
                                         title="Failed Tickets"
                                         filter_name="failed_tickets"
                                         name="cyllo_helpdesk.helpdesk_my_failed_ticket_action">
                                        <span>Failed</span>
                                        <span class="fw-bold"
                                              style="background-color: #FFF1D6; color: #8A5300; border-radius: 99px; padding: 2px 12px; font-size: 14px;"
                                              t-out="ticketData['failed_ticket_count']"/>
                                    </div>
                                </div>
                            </div>
                            <!-- Metric column: High Priority -->
                            <div class="col">
                                <div class="h-100 bg-white"
                                     style="border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden;">
                                    <div class="cursor-pointer"
                                         style="background-color: #FEF2F2; padding: 18px 20px;"
                                         t-on-click="getSearchDetails"
                                         title="High Priority"
                                         filter_name="high_priority"
                                         name="cyllo_helpdesk.helpdesk_my_high_priority_open_ticket_action">
                                        <div style="font-size: 13px; color: #3F5B49;">High
                                            Priority
                                        </div>
                                        <div class="fw-bold"
                                             style="font-size: 38px; line-height: 1.2; color: #DC2626;"
                                             t-out="ticketData['high_priority']"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center cursor-pointer"
                                         style="padding: 12px 20px; border-top: 1px solid var(--border-color); font-size: 13px; color: #3F5B49;"
                                         t-on-click="getSearchDetails"
                                         title="High Priority Average Open Hour"
                                         filter_name="high_priority_open_tickets"
                                         name="cyllo_helpdesk.helpdesk_high_priority_ticket_average_open_hours_action">
                                        <span>Avg open hours</span>
                                        <span class="fw-bold"
                                              style="font-size: 16px; color: #18301F;"
                                              t-out="ticketData['high_priority_average_open_hour']"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center cursor-pointer"
                                         style="padding: 12px 20px; border-top: 1px solid var(--border-color); font-size: 13px; color: #3F5B49;"
                                         t-on-click="getSearchDetails"
                                         title="Failed High Priority Tickets"
                                         filter_name="failed_high_priority_tickets"
                                         name="cyllo_helpdesk.helpdesk_high_priority_failed_ticket_action">
                                        <span>Failed</span>
                                        <span class="fw-bold"
                                              style="background-color: #FFF1D6; color: #8A5300; border-radius: 99px; padding: 2px 12px; font-size: 14px;"
                                              t-out="ticketData['failed_high_priority_ticket_count']"/>
                                    </div>
                                </div>
                            </div>
                            <!-- Metric column: Urgent -->
                            <div class="col">
                                <div class="h-100 bg-white"
                                     style="border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden;">
                                    <div class="cursor-pointer"
                                         style="background-color: #FFFBEB; padding: 18px 20px;"
                                         t-on-click="getSearchDetails"
                                         title="Urgent Tickets"
                                         filter_name="urgent_tickets"
                                         name="cyllo_helpdesk.helpdesk_my_urgent_priority_open_ticket_action">
                                        <div style="font-size: 13px; color: #3F5B49;">Urgent</div>
                                        <div class="fw-bold"
                                             style="font-size: 38px; line-height: 1.2; color: #B45309;"
                                             t-out="ticketData['urgent']"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center cursor-pointer"
                                         style="padding: 12px 20px; border-top: 1px solid var(--border-color); font-size: 13px; color: #3F5B49;"
                                         t-on-click="getSearchDetails"
                                         title="Urgent Average Open Hours"
                                         filter_name="urgent_open_tickets"
                                         name="cyllo_helpdesk.helpdesk_urgent_ticket_average_open_hours_action">
                                        <span>Avg open hours</span>
                                        <span class="fw-bold"
                                              style="font-size: 16px; color: #18301F;"
                                              t-out="ticketData['urgent_average_open_hour']"/>
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center cursor-pointer"
                                         style="padding: 12px 20px; border-top: 1px solid var(--border-color); font-size: 13px; color: #3F5B49;"
                                         t-on-click="getSearchDetails"
                                         title="Failed Urgent Tickets"
                                         filter_name="failed_urgent_tickets"
                                         name="cyllo_helpdesk.helpdesk_urgent_failed_ticket_action">
                                        <span>Failed</span>
                                        <span class="fw-bold"
                                              style="background-color: #FFF1D6; color: #8A5300; border-radius: 99px; padding: 2px 12px; font-size: 14px;"
                                              t-out="ticketData['failed_urgent_ticket_count']"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: performance rows (same line as hero) -->
                <div class="col-12 col-xl-6">
                    <div class="h-100">
                        <!--                <h5 class="fw-bold mb-3" style="font-size: 16px; color: #18301F;">Closed Tickets</h5>-->
                        <div class="row mx-0 mb-2 text-center fw-semibold"
                             style="font-size: 12px; color: #3F5B49;">
                            <div class="col-3"></div>
                            <div class="col-3">Closed Tickets</div>
                            <div class="col-3">Success Rate</div>
                            <div class="col-3">Average Rating</div>
                        </div>
                        <div class="row align-items-center mb-2 mx-0 py-3"
                             style="background-color: #F8F9FA; border-radius: 8px;">
                            <div class="col-3 fw-semibold text-start ps-3"
                                 style="font-size: 14px; color: #18301F;">Today
                            </div>
                            <div class="col-3 text-center" t-on-click="getSearchDetails"
                                 name="cyllo_helpdesk.helpdesk_my_today_closed_ticket_action">
                                <a href="#" class="text-decoration-none fw-semibold fs-6"
                                   style="color: #18301F;">
                                    <t t-out="ticketData['my_today_closed_ticket_count']"/>
                                </a>
                            </div>
                            <div class="col-3 text-center" t-on-click="getSearchDetails"
                                 name="cyllo_helpdesk.helpdesk_my_sla_success_ticket_action">
                                <a href="#" class="text-decoration-none fw-semibold fs-6"
                                   style="color: #18301F;">
                                    <t t-out="ticketData['my_success_rate_ticket_count']"/>
                                </a>
                            </div>
                            <div class="col-3 text-center" t-on-click="getSearchDetails"
                                 name="cyllo_helpdesk.helpdesk_my_sla_success_ticket_action">
                                <a href="#" class="text-decoration-none fw-semibold fs-6"
                                   style="color: #18301F;">
                                    <t t-out="ticketData['my_average_rating']"/>
                                </a>
                            </div>
                        </div>
                        <div class="row align-items-center mb-2 mx-0 py-3"
                             style="background-color: #F8F9FA; border-radius: 8px;">
                            <div class="col-3 fw-semibold text-start ps-3"
                                 style="font-size: 14px; color: #18301F;">Average 7 Days
                            </div>
                            <div class="col-3 text-center" t-on-click="getSearchDetails"
                                 name="cyllo_helpdesk.helpdesk_my_last_seven_days_closed_tickets_action">
                                <a href="#" class="text-decoration-none fw-semibold fs-6"
                                   style="color: #18301F;">
                                    <t t-out="ticketData['my_last_seven_days_closed_ticket_count']"/>
                                </a>
                            </div>
                            <div class="col-3 text-center" t-on-click="getSearchDetails"
                                 name="cyllo_helpdesk.helpdesk_my_last_seven_days_sla_success_ticket_action">
                                <a href="#" class="text-decoration-none fw-semibold fs-6"
                                   style="color: #18301F;">
                                    <t t-out="ticketData['my_last_seven_days_success_rate']"/>
                                </a>
                            </div>
                            <div class="col-3 text-center">
                                <a href="#" class="text-decoration-none fw-semibold fs-6"
                                   style="color: #18301F;">
                                    <t t-out="ticketData['my_last_seven_days_average_rating']"/>
                                </a>
                            </div>
                        </div>
                        <div class="row align-items-center mx-0 py-3"
                             style="background-color: #F8F9FA; border-radius: 8px;">
                            <div class="col-3 fw-semibold text-start ps-3"
                                 style="font-size: 14px; color: #18301F;">Daily Target
                            </div>
                            <div class="col-3 text-center">
                                <span t-on-click="getSearchDetails"
                                      name="cyllo_helpdesk.helpdesk_my_target_ticket_action"></span>
                                <ToggleTag tag="false"
                                           value="ticketData['daily_target_ticket_count']"
                                           fieldName="'ticket_count'"/>
                            </div>
                            <div class="col-3 text-center">
                                <ToggleTag tag="false"
                                           value="ticketData['daily_target_success_rate']"
                                           float="true" fieldName="'success_rate'"/>
                            </div>
                            <div class="col-3 text-center">
                                <ToggleTag tag="false"
                                           value="ticketData['daily_target_average_rating']"
                                           float="true" fieldName="'average_rating'"/>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>
