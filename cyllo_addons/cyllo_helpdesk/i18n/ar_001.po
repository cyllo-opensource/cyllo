#. module: cyllo_help_desk
#: model:mail.template,body_html:cyllo_help_desk.help_desk_mail_template
msgid ""
"<br>\n"
"            <h4>Dear<t t-out=\"object.customer_id.name\"></t>,\n"
"                <br>\n"
"                Your helpdesk ticket\n"
"                <span>\n"
"                    <a t-attf-href=\"/service_request/details/request/{{object.id}}\" style=\"text-decoration:none;\" class=\"text-decoration-none\">\n"
"                        <t t-out=\"object.name\"></t>\n"
"                    </a>\n"
"                </span>\n"
"                has been submitted.\n"
"            </h4>\n"
"            <p style=\"font-size:15px;font-weight:bold;\">Request No :\n"
"                <span>\n"
"                    <t t-out=\"object.ticket\"></t>\n"
"                </span>\n"
"            </p>\n"
"            <p style=\"font-size:15px;font-weight:bold;\">Team :\n"
"                <span>\n"
"                    <t t-out=\"object.team_id.name\"></t>\n"
"                </span>\n"
"            </p>\n"
"            <p style=\"font-size:15px;font-weight:bold;\">Responsible Person :\n"
"                <span>\n"
"                    <t t-out=\"object.user_id.name\"></t>\n"
"                </span>\n"
"            </p>\n"
"            <p style=\"font-size:15px;font-weight:bold;\">State :\n"
"                <span>\n"
"                    <t t-out=\"object.stage_id.name\"></t>\n"
"                </span>\n"
"            </p>\n"
"        "
msgstr ""
"<br>\n"
"            <h4>عزيزي <t t-out=\"object.customer_id.name\"></t>,\n"
"                <br>\n"
"                تذكرة الدعم الخاصة بك\n"
"                <span>\n"
"                    <a t-attf-href=\"/service_request/details/request/{{object.id}}\" style=\"text-decoration:none;\" class=\"text-decoration-none\">\n"
"                        <t t-out=\"object.name\"></t>\n"
"                    </a>\n"
"                </span>\n"
"                قد تم إرسالها.\n"
"            </h4>\n"
"            <p style=\"font-size:15px;font-weight:bold;\">رقم الطلب :\n"
"                <span>\n"
"                    <t t-out=\"object.ticket\"></t>\n"
"                </span>\n"
"            </p>\n"
"            <p style=\"font-size:15px;font-weight:bold;\">الفريق :\n"
"                <span>\n"
"                    <t t-out=\"object.team_id.name\"></t>\n"
"                </span>\n"
"            </p>\n"
"            <p style=\"font-size:15px;font-weight:bold;\">الشخص المسؤول :\n"
"                <span>\n"
"                    <t t-out=\"object.user_id.name\"></t>\n"
"                </span>\n"
"            </p>\n"
"            <p style=\"font-size:15px;font-weight:bold;\">الحالة :\n"
"                <span>\n"
"                    <t t-out=\"object.stage_id.name\"></t>\n"
"                </span>\n"
"            </p>\n"
"        "

#. module: cyllo_help_desk
#: model:mail.template,body_html:cyllo_help_desk.help_desk_mail_template_auto_close_reminder
msgid ""
"<div>\n"
"                <br>\n"
"                <h4>Dear <t t-out=\"object.customer_id.name\"></t>,</h4>\n"
"                <p>We are following up on your ticket <strong><t t-out=\"object.name\"></t></strong> (No. <t t-out=\"object.ticket\"></t>).</p>\n"
"                <p>Since we haven't heard from you in a while, we wanted to let you know that this ticket will be automatically closed soon if there is no further activity.</p>\n"
"                <p>If the issue is still ongoing, please reply to this email or update the ticket on the portal.</p>\n"
"                <br>\n"
"                <p>Best regards,<br>\n"
"                <t t-out=\"object.team_id.name\"></t> Support Team</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <br>\n"
"                <h4>عزيزي  <t t-out=\"object.customer_id.name\"></t>,</h4>\n"
"                <p>نتابع بشأن تذكرتك <strong><t t-out=\"object.name\"></t></strong> (رقم <t t-out=\"object.ticket\"></t>).</p>\n"
"                <p>بما أننا لم نسمع منك منذ فترة، أردنا إعلامك بأنه سيتم إغلاق هذه التذكرة تلقائياً قريباً إذا لم يكن هناك نشاط إضافي.</p>\n"
"                <p>إذا كانت المشكلة لا تزال قائمة، يرجى الرد على هذا البريد الإلكتروني أو تحديث التذكرة في البوابة.</p>\n"
"                <br>\n"
"                <p>مع أطيب التحيات،<br>\n"
"                <t t-out=\"object.team_id.name\"></t> فريق الدعم</p>\n"
"            </div>\n"
"        "

#. module: cyllo_help_desk
#: model:mail.template,body_html:cyllo_help_desk.help_desk_rating_template
msgid ""
"<div>\n"
"                <br>\n"
"                <h4>Dear<t t-out=\"object.customer_id.name\"></t>,\n"
"                    <br>\n"
"                    This is to inform you that the issue you reported has been\n"
"                    successfully resolved.\n"
"                    <br>\n"
"                    Details\n"
"                    <br>\n"
"                    -------\n"
"                    <br>\n"
"                    <span>\n"
"                        <a t-attf-href=\"/service_request/details/request/{{object.id}}\" style=\"text-decoration:none;\" class=\"text-decoration-none\">\n"
"                            <t t-out=\"object.name\"></t>\n"
"                        </a>\n"
"                    </span>\n"
"                </h4>\n"
"                <p style=\"font-size:15px;font-weight:bold;\">Request No :\n"
"                    <span>\n"
"                        <t t-out=\"object.ticket\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <p style=\"font-size:15px;font-weight:bold;\">Team :\n"
"                    <span>\n"
"                        <t t-out=\"object.team_id.name\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <p style=\"font-size:15px;font-weight:bold;\">Responsible Person\n"
"                    :\n"
"                    <span>\n"
"                        <t t-out=\"object.user_id.name\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <p style=\"font-size:15px;font-weight:bold;\">State :\n"
"                    <span>\n"
"                        <t t-out=\"object.stage_id.name\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"></t>\n"
"                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"width:100%; margin:0px auto;\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                <t t-if=\"object.customer_id.name\">\n"
"                                    Hello<t t-out=\"object.customer_id.name\"></t>,\n"
"                                    <br>\n"
"                                    <br>\n"
"                                </t>\n"
"                                <t t-else=\"\">\n"
"                                    Hello,\n"
"                                    <br>\n"
"                                    <br>\n"
"                                </t>\n"
"                                Please take a moment to rate our services\n"
"                                related\n"
"                                to the task\n"
"                                <t t-if=\"object.user_id.name\">\n"
"                                    assigned to <strong t-out=\"object.user_id.name or ''\">\n"
"                                    Mitchell Admin</strong>.\n"
"                                    <br>\n"
"                                </t>\n"
"                                <t t-else=\"\">.\n"
"                                    <br>\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"text-align: center;\">\n"
"                                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" summary=\"o_mail_notification\" style=\"width:100%; margin: 32px 0px 32px 0px;\">\n"
"                                    <tr>\n"
"                                        <td style=\"font-size: 13px;\">\n"
"                                            <strong>Tell us how you feel about\n"
"                                                our\n"
"                                                service\n"
"                                            </strong>\n"
"                                            <br>\n"
"                                            <span style=\"text-color: #888888\">\n"
"                                                (click on one of these smileys)\n"
"                                            </span>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"font-size: 13px;\">\n"
"                                            <table style=\"width:100%;text-align:center;margin-top:2rem;\">\n"
"                                                <tr>\n"
"                                                    <td style=\"padding: 0 10px;\">\n"
"                                                        <a t-attf-href=\"/rate/{{ access_token }}/5\">\n"
"                                                            <img alt=\"Satisfied\" src=\"/cyllo_help_desk/static/src/img/satisfied.png\" title=\"Satisfied\" style=\"width: 60px; height: 60px;\">\n"
"                                                        </a>\n"
"                                                    </td>\n"
"                                                    <td style=\"padding: 0 10px;\">\n"
"                                                        <a t-attf-href=\"/rate/{{ access_token }}/3\">\n"
"                                                            <img alt=\"Okay\" src=\"/cyllo_help_desk/static/src/img/okay.png\" title=\"Okay\" style=\"width: 60px; height: 60px;\">\n"
"                                                        </a>\n"
"                                                    </td>\n"
"                                                    <td style=\"padding: 0 10px;\">\n"
"                                                        <a t-attf-href=\"/rate/{{ access_token }}/1\">\n"
"                                                            <img alt=\"Dissatisfied\" src=\"/cyllo_help_desk/static/src/img/dissatisfied.png\" title=\"Dissatisfied\" style=\"width: 60px; height: 60px;\">\n"
"                                                        </a>\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                We appreciate your feedback. It helps us to\n"
"                                improve\n"
"                                continuously.\n"
"                                <br>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <br>\n"
"                <h4>عزيزي <t t-out=\"object.customer_id.name\"></t>,\n"
"                    <br>\n"
"                    نود إعلامك بأنه تم حل المشكلة التي أبلغت عنها بنجاح.\n"
"                    <br>\n"
"                    التفاصيل\n"
"                    <br>\n"
"                    -------\n"
"                    <br>\n"
"                    <span>\n"
"                        <a t-attf-href=\"/service_request/details/request/{{object.id}}\" style=\"text-decoration:none;\" class=\"text-decoration-none\">\n"
"                            <t t-out=\"object.name\"></t>\n"
"                        </a>\n"
"                    </span>\n"
"                </h4>\n"
"                <p style=\"font-size:15px;font-weight:bold;\">رقم الطلب :\n"
"                    <span>\n"
"                        <t t-out=\"object.ticket\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <p style=\"font-size:15px;font-weight:bold;\">الفريق :\n"
"                    <span>\n"
"                        <t t-out=\"object.team_id.name\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <p style=\"font-size:15px;font-weight:bold;\">الشخص المسؤول :\n"
"                    <span>\n"
"                        <t t-out=\"object.user_id.name\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <p style=\"font-size:15px;font-weight:bold;\">الحالة :\n"
"                    <span>\n"
"                        <t t-out=\"object.stage_id.name\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"></t>\n"
"                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"width:100%; margin:0px auto;\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                <t t-if=\"object.customer_id.name\">\n"
"                                    مرحباً <t t-out=\"object.customer_id.name\"></t>,\n"
"                                    <br>\n"
"                                    <br>\n"
"                                </t>\n"
"                                <t t-else=\"\">\n"
"                                    مرحباً ,\n"
"                                    <br>\n"
"                                    <br>\n"
"                                </t>\n"
"                                يرجى تخصيص لحظة لتقييم خدماتنا المتعلقة بالمهمة\n"
"                                <t t-if=\"object.user_id.name\">\n"
"                                    المسندة إلى <strong t-out=\"object.user_id.name or ''\">\n"
"                                    Mitchell Admin</strong>.\n"
"                                    <br>\n"
"                                </t>\n"
"                                <t t-else=\"\">.\n"
"                                    <br>\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"text-align: center;\">\n"
"                                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" summary=\"o_mail_notification\" style=\"width:100%; margin: 32px 0px 32px 0px;\">\n"
"                                    <tr>\n"
"                                        <td style=\"font-size: 13px;\">\n"
"                                            <strong>أخبرنا برأيك في خدمتنا\n"
"                                            </strong>\n"
"                                            <br>\n"
"                                            <span style=\"text-color: #888888\">\n"
"                                                (انقر على أحد هذه الرموز التعبيرية)\n"
"                                            </span>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"font-size: 13px;\">\n"
"                                            <table style=\"width:100%;text-align:center;margin-top:2rem;\">\n"
"                                                <tr>\n"
"                                                    <td style=\"padding: 0 10px;\">\n"
"                                                        <a t-attf-href=\"/rate/{{ access_token }}/5\">\n"
"                                                            <img alt=\"راضٍ\" src=\"/cyllo_help_desk/static/src/img/satisfied.png\" title=\"راضٍ\" style=\"width: 60px; height: 60px;\">\n"
"                                                        </a>\n"
"                                                    </td>\n"
"                                                    <td style=\"padding: 0 10px;\">\n"
"                                                        <a t-attf-href=\"/rate/{{ access_token }}/3\">\n"
"                                                            <img alt=\"مقبول\" src=\"/cyllo_help_desk/static/src/img/okay.png\" title=\"مقبول\" style=\"width: 60px; height: 60px;\">\n"
"                                                        </a>\n"
"                                                    </td>\n"
"                                                    <td style=\"padding: 0 10px;\">\n"
"                                                        <a t-attf-href=\"/rate/{{ access_token }}/1\">\n"
"                                                            <img alt=\"غير راضٍ\" src=\"/cyllo_help_desk/static/src/img/dissatisfied.png\" title=\"غير راضٍ\" style=\"width: 60px; height: 60px;\">\n"
"                                                        </a>\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                نقدّر ملاحظاتك. فهي تساعدنا على التحسّن باستمرار.\n"
"                                <br>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "

