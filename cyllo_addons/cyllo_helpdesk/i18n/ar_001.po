"                                            <span style=\"font-size: 12px; color: #FF9800; font-weight: bold; display: block; margin-top: 4px;\">Okay</span>\n"
"                                        </a>\n"
"                                    </td>\n"
"                                    <td style=\"padding: 5px 10px; text-align: center;\">\n"
"                                        <a t-attf-href=\"{{ base_url }}/rate/{{ access_token }}/1\" style=\"text-decoration: none; display: inline-block;\">\n"
"                                            <span style=\"display: inline-block; width: 48px; height: 48px; line-height: 48px; font-size: 30px; text-align: center; border-radius: 50%; background-color: #F44336; color: #ffffff;\">😟</span><br>\n"
"                                            <span style=\"font-size: 12px; color: #F44336; font-weight: bold; display: block; margin-top: 4px;\">Dissatisfied</span>\n"
"                                        </a>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </table>\n"
"                            <p style=\"font-size: 12px; color: #6b7280; margin: 10px 0 0 0;\">Click an option above to submit your rating. Your feedback helps us improve!</p>\n"
"                        </div>\n"
"                        <p style=\"margin: 18px 0 0 0; font-size: 13px; color: #6b7280; text-align: center;\">You can reply directly to this email if you need any additional assistance.</p>\n"
"                    </td>\n"
"                </tr>\n"
"                <tr>\n"
"                    <td style=\"background-color: #f9fafb; border-top: 1px solid #e5e7eb; padding: 20px 28px; font-size: 13px; color: #6b7280;\">\n"
