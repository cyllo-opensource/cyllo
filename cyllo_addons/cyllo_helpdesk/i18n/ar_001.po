"                                    </t>\n"
"                                    <t t-else=\"\">\n"
"                                        <a t-attf-href=\"{{ object.company_id.website or 'https://www.cyllo.com' }}\" target=\"_blank\" style=\"text-decoration: none;\">\n"
"                                            <img t-attf-src=\"{{ object.get_base_url() }}/cyllo_web/static/src/img/cyllo.svg\" alt=\"Cyllo Logo\" width=\"70\" height=\"32\" style=\"width: 70px; max-width: 70px; height: auto; display: block; border: 0; outline: none;\">\n"
"                                        </a>\n"
"                                    </t>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"        </td>\n"
"    </tr>\n"
"</table>\n"
