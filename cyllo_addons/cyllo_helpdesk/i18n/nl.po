"                        <t t-out=\"object.user_id.name\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <p style=\"font-size:15px;font-weight:bold;\">Status :\n"
"                    <span>\n"
"                        <t t-out=\"object.stage_id.name\"></t>\n"
"                    </span>\n"
"                </p>\n"
"                <t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"></t>\n"
"                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" style=\"width:100%; margin:0px auto;\">\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                <t t-if=\"object.customer_id.name\">\n"
"                                    Hallo <t t-out=\"object.customer_id.name\"></t>,\n"
"                                    <br>\n"
"                                    <br>\n"
"                                </t>\n"
"                                <t t-else=\"\">\n"
"                                    Hallo ,\n"
"                                    <br>\n"
"                                    <br>\n"
"                                </t>\n"
"                                Neem even de tijd om onze diensten met betrekking tot de taak te beoordelen\n"
"                                <t t-if=\"object.user_id.name\">\n"
"                                    toegewezen aan <strong t-out=\"object.user_id.name or ''\">\n"
"                                    Mitchell Admin</strong>.\n"
"                                    <br>\n"
"                                </t>\n"
"                                <t t-else=\"\">.\n"
"                                    <br>\n"
"                                </t>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"text-align: center;\">\n"
"                                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"590\" summary=\"o_mail_notification\" style=\"width:100%; margin: 32px 0px 32px 0px;\">\n"
"                                    <tr>\n"
"                                        <td style=\"font-size: 13px;\">\n"
"                                            <strong>Vertel ons wat u van onze service vindt\n"
"                                            </strong>\n"
"                                            <br>\n"
"                                            <span style=\"text-color: #888888\">\n"
"                                                (klik op een van deze smileys)\n"
"                                            </span>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                    <tr>\n"
"                                        <td style=\"font-size: 13px;\">\n"
"                                            <table style=\"width:100%;text-align:center;margin-top:2rem;\">\n"
"                                                <tr>\n"
"                                                    <td style=\"padding: 0 10px;\">\n"
"                                                        <a t-attf-href=\"/rate/{{ access_token }}/5\">\n"
"                                                            <img alt=\"Tevreden\" src=\"/cyllo_help_desk/static/src/img/satisfied.png\" title=\"Tevreden\" style=\"width: 60px; height: 60px;\">\n"
"                                                        </a>\n"
"                                                    </td>\n"
"                                                    <td style=\"padding: 0 10px;\">\n"
"                                                        <a t-attf-href=\"/rate/{{ access_token }}/3\">\n"
"                                                            <img alt=\"Oké\" src=\"/cyllo_help_desk/static/src/img/okay.png\" title=\"Oké\" style=\"width: 60px; height: 60px;\">\n"
"                                                        </a>\n"
"                                                    </td>\n"
"                                                    <td style=\"padding: 0 10px;\">\n"
"                                                        <a t-attf-href=\"/rate/{{ access_token }}/1\">\n"
"                                                            <img alt=\"Ontevreden\" src=\"/cyllo_help_desk/static/src/img/dissatisfied.png\" title=\"Ontevreden\" style=\"width: 60px; height: 60px;\">\n"
"                                                        </a>\n"
"                                                    </td>\n"
"                                                </tr>\n"
"                                            </table>\n"
"                                        </td>\n"
"                                    </tr>\n"
"                                </table>\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td valign=\"top\" style=\"font-size: 13px;\">\n"
"                                We waarderen uw feedback. Deze helpt ons om voortdurend te verbeteren.\n"
"                                <br>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </div>\n"
"        "

