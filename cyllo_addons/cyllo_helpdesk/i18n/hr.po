"                                            </td>\n"
"                                            <td style=\"padding: 10px 14px; font-size: 13px;\">\n"
"                                                <span style=\"display: inline-block; background-color: #dbeafe; color: #1e40af; font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 2px 8px; border-radius: 10px;\">\n"
"                                                    <t t-out=\"object.stage_id.name or 'In Progress'\"></t>\n"
"                                                </span>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                        <t t-if=\"object.user_id\">\n"
"                                            <tr>\n"
"                                                <td style=\"padding: 10px 14px; color: #6b7280; font-size: 13px;\">\n"
"                                                    Dodijeljeno\n"
"                                                </td>\n"
"                                                <td style=\"padding: 10px 14px; font-size: 13px; color: #111827;\">\n"
"                                                    <t t-out=\"object.user_id.name\"></t>\n"
"                                                </td>\n"
"                                            </tr>\n"
"                                        </t>\n"
"                                    </table>\n"
"\n"
"                                    <!-- CTA Button -->\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 24px 0 18px 0;\">\n"
"                                        <tr>\n"
"                                            <td align=\"center\">\n"
"                                                <a t-attf-href=\"{{ object.get_base_url() }}/my/ticket/{{ object.id }}\" style=\"background-color: #9EA700; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 10px 24px; border-radius: 6px; display: inline-block;\">\n"
"                                                    Provjeri napredak tiketa\n"
"                                                </a>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"\n"
"                                    <p style=\"margin: 18px 0 0 0; font-size: 13px; color: #6b7280; text-align: center;\">\n"
"                                        Obavijestit ćemo vas o napretku. Na ovu e-poruku možete odgovoriti izravno u bilo kojem trenutku.\n"
"                                    </p>\n"
"                                </td>\n"
"                            </tr>\n"
"\n"
"                            <!-- Footer -->\n"
"                            <tr>\n"
"                                <td style=\"background-color: #f9fafb; border-top: 1px solid #e5e7eb; padding: 20px 28px; font-size: 13px; color: #6b7280;\">\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n"
"                                        <tr>\n"
"                                            <td valign=\"middle\" align=\"left\">\n"
"                                                <p style=\"margin: 0; line-height: 1.5; color: #6b7280; font-size: 13px;\">\n"
