"                            <tr>\n"
"                                <td style=\"padding: 5px 28px 24px 28px;\">\n"
"                                    <p style=\"margin: 0 0 10px 0; font-size: 15px;\">\n"
"                                        Poštovani\n"
"                                        <strong t-out=\"object.customer_id.name or 'Customer'\"></strong>\n"
"                                        ,\n"
"                                    </p>\n"
"                                    <p style=\"margin: 0 0 18px 0; color: #4b5563;\">\n"
"                                        Naš tim za podršku počeo je raditi na vašem tiketu. Evo najnovijeg napretka vašeg problema:\n"
"                                    </p>\n"
"\n"
"                                    <!-- Issue Card -->\n"
"                                    <div style=\"background-color: #f9fafb; border-left: 4px solid #9EA700; border-radius: 0 6px 6px 0; padding: 14px 18px; margin: 20px 0;\">\n"
"                                        <div style=\"font-size: 11px; font-weight: 700; text-transform: uppercase; color: #858D00; letter-spacing: 0.5px; margin-bottom: 4px;\">\n"
"                                            Predmet tiketa\n"
"                                        </div>\n"
"                                        <div style=\"font-size: 15px; font-weight: 600; color: #111827;\">\n"
"                                            <t t-out=\"object.name\"></t>\n"
"                                        </div>\n"
"                                    </div>\n"
"\n"
"                                    <!-- Details Table -->\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse: collapse; margin: 22px 0 24px 0; background-color: #ffffff; border: 1px solid #f3f4f6; border-radius: 6px;\">\n"
"                                        <tr style=\"border-bottom: 1px solid #f3f4f6;\">\n"
