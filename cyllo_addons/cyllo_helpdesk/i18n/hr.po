"                                                #\n"
"                                                <t t-out=\"object.ticket\"></t>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                        <tr style=\"border-bottom: 1px solid #f3f4f6;\">\n"
"                                            <td style=\"padding: 10px 14px; color: #6b7280; font-size: 13px;\">\n"
