"                                                    <br>\n"
"                                                    <strong style=\"color: #111827;\">\n"
"                                                        <t t-out=\"user.name or object.team_id.name or 'Support Team'\"></t>\n"
"                                                    </strong>\n"
"                                                    <br>\n"
"                                                    <t t-out=\"object.company_id.name\"></t>\n"
"                                                </p>\n"
"                                            </td>\n"
"                                            <td valign=\"middle\" align=\"right\" style=\"padding-left: 15px;\">\n"
"                                                <!-- Reliable Company Logo Loading -->\n"
"                                                <t t-if=\"object.company_id.logo\">\n"
"                                                    <img t-attf-src=\"{{ object.get_base_url() }}/logo.png?company={{ object.company_id.id }}\" t-att-alt=\"object.company_id.name\" width=\"70\" height=\"32\" style=\"width: 70px; max-width: 70px; height: auto; display: block; border: 0; outline: none;\">\n"
"                                                </t>\n"
"                                                <t t-else=\"\">\n"
"\n"
"\n"
"                                                    <img t-attf-src=\"{{ object.get_base_url() }}/cyllo_web/static/src/img/cyllo.svg\" alt=\"Cyllo Logo\" width=\"70\" height=\"32\" style=\"width: 70px; max-width: 70px; height: auto; display: block; border: 0; outline: none;\">\n"
"\n"
"\n"
"                                                </t>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"        "

