#. module: cyllo_helpdesk
#: model:mail.template,body_html:cyllo_helpdesk.help_desk_mail_template_auto_close_reminder
msgid ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #f4f5f7;                           font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;                           font-size: 14px;                           color: #374151;                           line-height: 1.6;\">\n"
"\n"
"                <tr>\n"
"                    <td align=\"center\" style=\"padding: 24px 12px;\">\n"
"\n"
"                        <!-- Main Email Card -->\n"
"                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"max-width: 600px;                                       width: 100%;                                       background-color: #ffffff;                                       border: 1px solid #e5e7eb;                                       border-radius: 8px;\">\n"
"\n"
"                            <!-- Header -->\n"
"                            <tr>\n"
"                                <td style=\"background-color: #ffffff;                                            padding: 20px 24px;                                            text-align: left;\">\n"
"\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n"
"                                        <tr>\n"
"    <td valign=\"middle\" style=\"padding-right: 10px;\">\n"
"        <h2 style=\"margin: 0; font-size: 17px; font-weight: 600; color: #000000; letter-spacing: -0.2px; line-height: 1.2;\">\n"
"            Helpdesk Support\n"
"        </h2>\n"
"        <span style=\"font-size: 13px; color: #6b7280;\">Inactivity Reminder</span>\n"
"    </td>\n"
"    <td valign=\"middle\" align=\"right\" style=\"width: 1%; white-space: nowrap;\">\n"
"        <span style=\"display: inline-block; background-color: #ffffff; color: #858D00;                      font-size: 16px; font-weight: 600; padding: 3px 8px;                      border-radius: 12px; white-space: nowrap;\">#<t t-out=\"object.ticket\"></t></span>\n"
"    </td>\n"
"</tr>\n"
"                                    </table>\n"
"                                </td>\n"
"                            </tr>\n"
"\n"
"                            <!-- Content Area -->\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 28px 24px 28px;\">\n"
"\n"
"                                    <p style=\"margin: 0 0 10px 0;                                               font-size: 15px;\">\n"
"                                        Dear\n"
"                                        <strong t-out=\"object.customer_id.name or 'Customer'\"></strong>\n"
"                                        ,\n"
"                                    </p>\n"
"\n"
"                                    <p style=\"margin: 0 0 18px 0;                                               color: #4b5563;\">\n"
"                                        We are following up regarding your\n"
"                                        ticket\n"
"                                        <strong>\n"
"                                            <t t-out=\"object.name\"></t>\n"
"                                        </strong>\n"
"                                        (No.<t t-out=\"object.ticket\"></t>).\n"
"                                    </p>\n"
"\n"
"                                    <!-- Reminder Box -->\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 20px 0;\">\n"
"                                        <tr>\n"
"                                            <td style=\"background-color: #fffbeb;                                                        border-left: 4px solid #f59e0b;                                                        border-radius: 0 6px 6px 0;                                                        padding: 14px 18px;                                                        font-size: 13px;                                                        color: #92400e;                                                        line-height: 1.5;\">\n"
"\n"
"                                                <strong>Ticket closing soon:\n"
"                                                </strong>\n"
"                                                Since there has been no activity\n"
"                                                on this ticket for a while, it\n"
"                                                will be automatically closed\n"
"                                                soon\n"
"                                                if no further response is\n"
"                                                received.\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"\n"
"                                    <p style=\"margin: 0 0 20px 0;                                               color: #4b5563;\">\n"
"                                        If your issue is still ongoing or you\n"
"                                        require more assistance, simply reply\n"
"                                        directly to this email or update your\n"
"                                        ticket via the customer portal.\n"
"                                    </p>\n"
"\n"
"                                    <!-- CTA Button -->\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 24px 0 18px 0;\">\n"
"                                        <tr>\n"
"                                            <td align=\"center\">\n"
"                                                <a t-attf-href=\"{{ object.get_base_url() }}/my/ticket/{{ object.id }}\" target=\"_blank\" style=\"background-color: #9EA700;                                                           color: #ffffff;                                                           text-decoration: none;                                                           font-size: 14px;                                                           font-weight: 600;                                                           padding: 10px 24px;                                                           border-radius: 6px;                                                           display: inline-block;\">\n"
"                                                    Keep Ticket Open / Update\n"
"                                                </a>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"\n"
"                                </td>\n"
"                            </tr>\n"
"\n"
"                            <!-- Footer -->\n"
"                            <tr>\n"
"                                <td style=\"background-color: #f9fafb;                                            border-top: 1px solid #e5e7eb;                                            padding: 20px 28px;                                            font-size: 13px;                                            color: #6b7280;\">\n"
"\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n"
"                                        <tr>\n"
"                                            <td valign=\"middle\" align=\"left\">\n"
"                                                <p style=\"margin: 0;                                                           line-height: 1.5;                                                           color: #6b7280;                                                           font-size: 13px;\">\n"
"                                                    Best regards,\n"
"                                                    <br>\n"
"\n"
"                                                    <strong style=\"color: #111827;\">\n"
"                                                        <t t-out=\"user.name or object.team_id.name or 'Support Team'\"></t>\n"
"                                                    </strong>\n"
"\n"
"                                                    <br>\n"
"\n"
"                                                    <t t-out=\"object.company_id.name\"></t>\n"
"                                                </p>\n"
"                                            </td>\n"
"\n"
"                                            <td valign=\"middle\" align=\"right\" style=\"padding-left: 15px;\">\n"
"\n"
"                                                <!-- Company Logo -->\n"
"                                                <t t-if=\"object.company_id.logo\">\n"
"                                                    <img t-attf-src=\"{{ object.get_base_url() }}/logo.png?company={{ object.company_id.id }}\" t-att-alt=\"object.company_id.name\" width=\"70\" style=\"width: 70px;                                                                 max-width: 70px;                                                                 height: auto;                                                                 display: block;                                                                 border: 0;                                                                 outline: none;\">\n"
"                                                </t>\n"
"\n"
"                                                <!-- Fallback Cyllo Logo -->\n"
"                                                <t t-else=\"\">\n"
"                                                    <img t-attf-src=\"{{ object.get_base_url() }}/cyllo_web/static/src/img/cyllo.svg\" alt=\"Cyllo Logo\" width=\"70\" style=\"width: 70px;                                                                 max-width: 70px;                                                                 height: auto;                                                                 display: block;                                                                 border: 0;                                                                 outline: none;\">\n"
"                                                </t>\n"
"\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"\n"
"                                </td>\n"
"                            </tr>\n"
"\n"
"                        </table>\n"
"                        <!-- End Main Email Card -->\n"
"\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
"        "
msgstr ""
"<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background-color: #f4f5f7;                           font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;                           font-size: 14px;                           color: #374151;                           line-height: 1.6;\">\n"
"\n"
"                <tr>\n"
"                    <td align=\"center\" style=\"padding: 24px 12px;\">\n"
"\n"
"                        <!-- Main Email Card -->\n"
"                        <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"600\" style=\"max-width: 600px;                                       width: 100%;                                       background-color: #ffffff;                                       border: 1px solid #e5e7eb;                                       border-radius: 8px;\">\n"
"\n"
"                            <!-- Header -->\n"
"                            <tr>\n"
"                                <td style=\"background-color: #ffffff;                                            padding: 20px 24px;                                            text-align: left;\">\n"
"\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n"
"                                        <tr>\n"
"                                            <td valign=\"middle\">\n"
"                                                <h2 style=\"margin: 0;                                                            font-size: 19px;                                                            font-weight: 600;                                                            color: #000000;                                                            letter-spacing: -0.2px;\">\n"
"                                                    Support Helpdesk\n"
"                                                </h2>\n"
"\n"
"                                                <span style=\"font-size: 15px;                                                              color: #6b7280;\">\n"
"                                                    Rappel d'inactivité\n"
"                                                </span>\n"
"                                            </td>\n"
"\n"
"                                            <td valign=\"middle\" align=\"right\">\n"
"                                                <span style=\"background-color: #ffffff;                                                              color: #858D00;                                                              font-size: 20px;                                                              font-weight: 600;                                                              padding: 4px 10px;                                                              border-radius: 12px;\">\n"
"                                                    #\n"
"                                                    <t t-out=\"object.ticket\"></t>\n"
"                                                </span>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"                                </td>\n"
"                            </tr>\n"
"\n"
"                            <!-- Content Area -->\n"
"                            <tr>\n"
"                                <td style=\"padding: 5px 28px 24px 28px;\">\n"
"\n"
"                                    <p style=\"margin: 0 0 10px 0;                                               font-size: 15px;\">\n"
"                                        Bonjour\n"
"                                        <strong t-out=\"object.customer_id.name or 'Customer'\"></strong>\n"
"                                        ,\n"
"                                    </p>\n"
"\n"
"                                    <p style=\"margin: 0 0 18px 0;                                               color: #4b5563;\">\n"
"                                        Nous revenons vers vous concernant votre ticket\n"
"                                        <strong>\n"
"                                            <t t-out=\"object.name\"></t>\n"
"                                        </strong>\n"
"                                        (n°<t t-out=\"object.ticket\"></t>).\n"
"                                    </p>\n"
"\n"
"                                    <!-- Reminder Box -->\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 20px 0;\">\n"
"                                        <tr>\n"
"                                            <td style=\"background-color: #fffbeb;                                                        border-left: 4px solid #f59e0b;                                                        border-radius: 0 6px 6px 0;                                                        padding: 14px 18px;                                                        font-size: 13px;                                                        color: #92400e;                                                        line-height: 1.5;\">\n"
"\n"
"                                                <strong>Fermeture prochaine du ticket :\n"
"                                                </strong>\n"
"                                                En l'absence d'activité sur ce ticket depuis un certain temps, il sera automatiquement fermé prochainement si aucune réponse n'est reçue.\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"\n"
"                                    <p style=\"margin: 0 0 20px 0;                                               color: #4b5563;\">\n"
"                                        Si votre problème persiste ou si vous avez besoin d'aide supplémentaire, répondez simplement à cet e-mail ou mettez à jour votre ticket via le portail client.\n"
"                                    </p>\n"
"\n"
"                                    <!-- CTA Button -->\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"margin: 24px 0 18px 0;\">\n"
"                                        <tr>\n"
"                                            <td align=\"center\">\n"
"                                                <a t-attf-href=\"{{ object.get_base_url() }}/my/ticket/{{ object.id }}\" target=\"_blank\" style=\"background-color: #9EA700;                                                           color: #ffffff;                                                           text-decoration: none;                                                           font-size: 14px;                                                           font-weight: 600;                                                           padding: 10px 24px;                                                           border-radius: 6px;                                                           display: inline-block;\">\n"
"                                                    Garder le ticket ouvert / mettre à jour\n"
"                                                </a>\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"\n"
"                                </td>\n"
"                            </tr>\n"
"\n"
"                            <!-- Footer -->\n"
"                            <tr>\n"
"                                <td style=\"background-color: #f9fafb;                                            border-top: 1px solid #e5e7eb;                                            padding: 20px 28px;                                            font-size: 13px;                                            color: #6b7280;\">\n"
"\n"
"                                    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n"
"                                        <tr>\n"
"                                            <td valign=\"middle\" align=\"left\">\n"
"                                                <p style=\"margin: 0;                                                           line-height: 1.5;                                                           color: #6b7280;                                                           font-size: 13px;\">\n"
"                                                    Cordialement,\n"
"                                                    <br>\n"
"\n"
"                                                    <strong style=\"color: #111827;\">\n"
"                                                        <t t-out=\"user.name or object.team_id.name or 'Support Team'\"></t>\n"
"                                                    </strong>\n"
"\n"
"                                                    <br>\n"
"\n"
"                                                    <t t-out=\"object.company_id.name\"></t>\n"
"                                                </p>\n"
"                                            </td>\n"
"\n"
"                                            <td valign=\"middle\" align=\"right\" style=\"padding-left: 15px;\">\n"
"\n"
"                                                <!-- Company Logo -->\n"
"                                                <t t-if=\"object.company_id.logo\">\n"
"                                                    <img t-attf-src=\"{{ object.get_base_url() }}/logo.png?company={{ object.company_id.id }}\" t-att-alt=\"object.company_id.name\" width=\"70\" style=\"width: 70px;                                                                 max-width: 70px;                                                                 height: auto;                                                                 display: block;                                                                 border: 0;                                                                 outline: none;\">\n"
"                                                </t>\n"
"\n"
"                                                <!-- Fallback Cyllo Logo -->\n"
"                                                <t t-else=\"\">\n"
"                                                    <img t-attf-src=\"{{ object.get_base_url() }}/cyllo_web/static/src/img/cyllo.svg\" alt=\"Cyllo Logo\" width=\"70\" style=\"width: 70px;                                                                 max-width: 70px;                                                                 height: auto;                                                                 display: block;                                                                 border: 0;                                                                 outline: none;\">\n"
"                                                </t>\n"
"\n"
"                                            </td>\n"
"                                        </tr>\n"
"                                    </table>\n"
"\n"
"                                </td>\n"
"                            </tr>\n"
"\n"
"                        </table>\n"
"                        <!-- End Main Email Card -->\n"
"\n"
"                    </td>\n"
"                </tr>\n"
"            </table>\n"
