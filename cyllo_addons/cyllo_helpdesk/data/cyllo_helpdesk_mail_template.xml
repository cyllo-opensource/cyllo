                                    <!-- Issue Card -->
                                    <div style="background-color: #f9fafb; border-left: 4px solid #9EA700; border-radius: 0 6px 6px 0; padding: 14px 18px; margin: 20px 0;">
                                        <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: #858D00; letter-spacing: 0.5px; margin-bottom: 4px;">
