    <record id="help_desk_mail_template_auto_close_reminder"
            model="mail.template">

        <field name="name">Help Desk: Auto-close Reminder</field>
        <field name="model_id"
               ref="cyllo_helpdesk.model_helpdesk_ticket"/>

        <field name="subject">Reminder: Your ticket will be closed soon</field>

        <field name="email_from">{{ user.email_formatted or (object.user_id.email_formatted if object.user_id else object.company_id.partner_id.email_formatted) }}</field>
        <field name="reply_to">{{ object.team_id.alias_id.alias_full_name if object.team_id and object.team_id.alias_id else object.company_id.partner_id.email_formatted }}</field>
        <field name="email_to">{{ object.email or (object.customer_id.email if object.customer_id else '') }}</field>
        <field name="email_cc">{{ ','.join(object.email_cc_ids.filtered('email').mapped('email')) }}</field>
        <field name="email_layout_xmlid">cyllo_helpdesk.cyllo_helpdesk_mail_notification_layout</field>

        <field name="body_html" type="html">
            <table border="0" cellpadding="0" cellspacing="0"
                   width="100%"
                   style="background-color: #f4f5f7;
                          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                          font-size: 14px;
                          color: #374151;
                          line-height: 1.6;">

                <tr>
                    <td align="center" style="padding: 24px 12px;">

                        <!-- Main Email Card -->
                        <table border="0" cellpadding="0" cellspacing="0"
                               width="600"
                               style="max-width: 600px;
                                      width: 100%;
                                      background-color: #ffffff;
                                      border: 1px solid #e5e7eb;
                                      border-radius: 8px;">

                            <!-- Header -->
                            <tr>
                                <td style="background-color: #ffffff;
                                           padding: 20px 24px;
                                           text-align: left;">

                                    <table border="0" cellpadding="0"
                                           cellspacing="0" width="100%">
                                        <tr>
                                            <td valign="middle">
                                                <h2 style="margin: 0;
                                                           font-size: 19px;
                                                           font-weight: 600;
                                                           color: #000000;
                                                           letter-spacing: -0.2px;">
                                                    Helpdesk Support
                                                </h2>

                                                <span style="font-size: 15px;
                                                             color: #6b7280;">
                                                    Inactivity Reminder
                                                </span>
                                            </td>

                                            <td valign="middle" align="right">
                                                <span style="background-color: #ffffff;
                                                             color: #858D00;
                                                             font-size: 20px;
                                                             font-weight: 600;
                                                             padding: 4px 10px;
                                                             border-radius: 12px;">
                                                    #
                                                    <t t-out="object.ticket"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>

                            <!-- Content Area -->
                            <tr>
                                <td style="padding: 5px 28px 24px 28px;">

                                    <p style="margin: 0 0 10px 0;
                                              font-size: 15px;">
                                        Dear
                                        <strong t-out="object.customer_id.name or 'Customer'"/>
                                        ,
                                    </p>

                                    <p style="margin: 0 0 18px 0;
                                              color: #4b5563;">
                                        We are following up regarding your
                                        ticket
                                        <strong>
                                            <t t-out="object.name"/>
                                        </strong>
                                        (No.<t t-out="object.ticket"/>).
                                    </p>

                                    <!-- Reminder Box -->
                                    <table border="0" cellpadding="0"
                                           cellspacing="0" width="100%"
                                           style="margin: 20px 0;">
                                        <tr>
                                            <td style="background-color: #fffbeb;
                                                       border-left: 4px solid #f59e0b;
                                                       border-radius: 0 6px 6px 0;
                                                       padding: 14px 18px;
                                                       font-size: 13px;
                                                       color: #92400e;
                                                       line-height: 1.5;">

                                                <strong>Ticket closing soon:
                                                </strong>
                                                Since there has been no activity
                                                on this ticket for a while, it
                                                will be automatically closed
                                                soon
                                                if no further response is
                                                received.
                                            </td>
                                        </tr>
                                    </table>

                                    <p style="margin: 0 0 20px 0;
                                              color: #4b5563;">
                                        If your issue is still ongoing or you
                                        require more assistance, simply reply
                                        directly to this email or update your
                                        ticket via the customer portal.
                                    </p>

                                    <!-- CTA Button -->
                                    <table border="0" cellpadding="0"
                                           cellspacing="0" width="100%"
                                           style="margin: 24px 0 18px 0;">
                                        <tr>
                                            <td align="center">
                                                <a t-attf-href="{{ object.get_base_url() }}/my/ticket/{{ object.id }}"
                                                   target="_blank"
                                                   style="background-color: #9EA700;
                                                          color: #ffffff;
                                                          text-decoration: none;
                                                          font-size: 14px;
                                                          font-weight: 600;
                                                          padding: 10px 24px;
                                                          border-radius: 6px;
                                                          display: inline-block;">
                                                    Keep Ticket Open / Update
                                                </a>
                                            </td>
                                        </tr>
                                    </table>

                                </td>
                            </tr>

                            <!-- Footer -->
                            <tr>
                                <td style="background-color: #f9fafb;
                                           border-top: 1px solid #e5e7eb;
                                           padding: 20px 28px;
                                           font-size: 13px;
                                           color: #6b7280;">

                                    <table border="0" cellpadding="0"
                                           cellspacing="0" width="100%">
                                        <tr>
                                            <td valign="middle" align="left">
                                                <p style="margin: 0;
                                                          line-height: 1.5;
                                                          color: #6b7280;
                                                          font-size: 13px;">
                                                    Best regards,
                                                    <br/>

                                                    <strong style="color: #111827;">
                                                        <t t-out="user.name or object.team_id.name or 'Support Team'"/>
                                                    </strong>

                                                    <br/>

                                                    <t t-out="object.company_id.name"/>
                                                </p>
                                            </td>

                                            <td valign="middle" align="right"
                                                style="padding-left: 15px;">

                                                <!-- Company Logo -->
                                                <t t-if="object.company_id.logo">
                                                    <img t-attf-src="{{ object.get_base_url() }}/logo.png?company={{ object.company_id.id }}"
                                                         t-att-alt="object.company_id.name"
                                                         width="70"
                                                         style="width: 70px;
                                                                max-width: 70px;
                                                                height: auto;
                                                                display: block;
                                                                border: 0;
                                                                outline: none;"/>
                                                </t>

                                                <!-- Fallback Cyllo Logo -->
                                                <t t-else="">
                                                    <img t-attf-src="{{ object.get_base_url() }}/cyllo_helpdesk/static/src/img/cyllo.png"
                                                         alt="Cyllo Logo"
