<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rating_rating_action_helpdesk_ticket" model="ir.actions.act_window">
        <field name="name">Customer Rating</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">kanban,pivot,graph</field>
        <field name="domain">[('res_model', '=', 'helpdesk.ticket'),
            ('consumed', '=', True)]
        </field>
    </record>

    <template id="rating_external_page_submit_cyllo_branding"
              inherit_id="rating.rating_external_page_submit">
        <xpath expr="//button[@type='submit']" position="attributes">
            <attribute name="style">margin-top:8px; background-color:#9ea700 !important; border-color:#9ea700 !important; color:#ffffff !important;</attribute>
        </xpath>
    </template>
</odoo>