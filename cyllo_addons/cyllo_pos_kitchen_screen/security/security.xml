<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company record rules -->
    <record id="kitchen_screen_comp_rule" model="ir.rule">
        <field name="name">Kitchen Screen: multi-company</field>
        <field name="model_id" ref="model_kitchen_screen"/>
        <field name="domain_force">['|', ('company_id', '=', False),
            ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="kitchen_screen_stage_comp_rule" model="ir.rule">
        <field name="name">Kitchen Screen Stage: multi-company</field>
        <field name="model_id" ref="model_kitchen_screen_stage"/>
        <field name="domain_force">['|', ('company_id', '=', False),
            ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
