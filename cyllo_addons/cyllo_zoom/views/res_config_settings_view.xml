<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_zoom" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cyllo.zoom
        </field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="after">
                <block title="Zoom Integration" name="zoom_integration">
                    <setting id="zoom_credentials"
                             string="Zoom OAuth Credentials"
                             help="Configure your Zoom app credentials."
                             documentation="https://developers.zoom.us/docs/integrations/oauth/">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="zoom_client" string="Client ID"
                                       class="col-lg-4 o_light_label"/>
                                <field name="zoom_client"
                                       placeholder="e.g. qwertyuiihgcx"/>
                            </div>
                            <div class="row mt8">
                                <label for="zoom_client_secret"
                                       string="Client Secret"
                                       class="col-lg-4 o_light_label"/>
                                <field name="zoom_client_secret"
                                       password="True"/>
                            </div>
                            <div class="row mt8">
                                <label for="zoom_redirect_uri"
                                       string="Redirect URI"
                                       class="col-lg-4 o_light_label"/>
                                <field name="zoom_redirect_uri"
                                       placeholder="http://localhost:8017/zoom/callback"/>
                            </div>
                            <div class="row mt8">
                                <label for="zoom_refresh_token"
                                       string="Refresh Token"
                                       class="col-lg-4 o_light_label"/>
                                <field name="zoom_refresh_token"
                                       password="True"
                                       placeholder="Populated automatically after connecting"/>
                            </div>
                            <div class="row mt8">
                                <label for="zoom_recordings"
                                       string="Recording Location"
                                       class="col-lg-4 o_light_label"/>
                                <field name="zoom_recordings"
                                       placeholder="/home/user/Documents/Zoom"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="zoom_connection"
                             string="Connection Status"
                             help="Current Zoom connection state and token information.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="zoom_status" string="Status"
                                       class="col-lg-4 o_light_label"/>
                                <field name="zoom_status" readonly="1"/>
                            </div>
                            <div class="row mt8">
                                <label for="zoom_token"
                                       string="Access Token"
                                       class="col-lg-4 o_light_label"/>
                                <field name="zoom_token"
                                       password="True"
                                       readonly="1"
                                       class="text-truncate"
                                       placeholder="Auto-populated after connecting"/>
                            </div>
                            <div class="row mt8">
                                <label for="zoom_token_expiry"
                                       string="Token Expiry"
                                       class="col-lg-4 o_light_label"/>
                                <field name="zoom_token_expiry" readonly="1"/>
                            </div>
                            <div class="mt16">
                                <button name="action_connect_zoom"
                                        type="object"
                                        string="Connect Zoom"
                                        class="btn btn-primary me-2"/>
                                <button name="action_zoom_meet_refresh_token"
                                        type="object"
                                        string="Refresh Token"
                                        class="btn btn-secondary"
                                        icon="fa-refresh"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
