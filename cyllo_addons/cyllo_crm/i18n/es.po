#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.email_template_activity_assigned
msgid "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; line-height: 1.6; color: #333;\">\n                    <div style=\"border-bottom: 2px solid #007bff; padding-bottom: 10px; margin-bottom: 20px;\">\n                        <h2 style=\"color: #007bff; margin: 0;\">Activity Assigned on Lead</h2>\n                    </div>\n\n                    <p>Dear <strong><t t-out=\"ctx.get('user_name')\"></t></strong>,</p>\n\n                    <p>An activity has been assigned to you on the lead <strong>\"<t t-out=\"ctx.get('lead_name')\"></t>\"</strong> (Stage: <t t-out=\"ctx.get('stage_name')\"></t>).</p>\n\n                    <div style=\"background-color: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin: 20px 0;\">\n                        <p style=\"margin: 0;\"><strong>Activity:</strong> <t t-out=\"ctx.get('activity_name')\"></t></p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Due Date:</strong> <t t-out=\"ctx.get('due_date')\"></t></p>\n                    </div>\n\n                    <p>Kindly ensure this activity is completed by the due date to maintain workflow efficiency.</p>\n\n                    <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;\">\n                        <p style=\"margin: 0;\">Best regards,</p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>CRM Team</strong></p>\n                        <t t-if=\"object.company_id.name\">\n                            <p style=\"margin: 5px 0 0 0; color: #666; font-size: 14px;\">\n                                <t t-out=\"object.company_id.name\"></t>\n                            </p>\n                        </t>\n                    </div>\n                </div>\n            "
msgstr "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; line-height: 1.6; color: #333;\">\n                    <div style=\"border-bottom: 2px solid #007bff; padding-bottom: 10px; margin-bottom: 20px;\">\n                        <h2 style=\"color: #007bff; margin: 0;\">Actividad asignada en el prospecto</h2>\n                    </div>\n\n                    <p>Estimado/a <strong><t t-out=\"ctx.get('user_name')\"></t></strong>,</p>\n\n                    <p>Se le ha asignado una actividad en el prospecto <strong>\"<t t-out=\"ctx.get('lead_name')\"></t>\"</strong> (Etapa: <t t-out=\"ctx.get('stage_name')\"></t>).</p>\n\n                    <div style=\"background-color: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin: 20px 0;\">\n                        <p style=\"margin: 0;\"><strong>Actividad:</strong> <t t-out=\"ctx.get('activity_name')\"></t></p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Fecha límite:</strong> <t t-out=\"ctx.get('due_date')\"></t></p>\n                    </div>\n\n                    <p>Por favor, asegúrese de completar esta actividad antes de la fecha límite para mantener la eficiencia del flujo de trabajo.</p>\n\n                    <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;\">\n                        <p style=\"margin: 0;\">Saludos cordiales,</p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Equipo de CRM</strong></p>\n                        <t t-if=\"object.company_id.name\">\n                            <p style=\"margin: 5px 0 0 0; color: #666; font-size: 14px;\">\n                                <t t-out=\"object.company_id.name\"></t>\n                            </p>\n                        </t>\n                    </div>\n                </div>\n            "

#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.crm_subscription_report_email_template
msgid "<div>\n                    <p>Hi <t t-esc=\"object.user_id.name\"></t>,</p>\n\n                    <p>\n                        Your scheduled subscription report\n                        <strong>\"<t t-esc=\"object.name.title()\"></t>\"</strong>has been generated.\n                    </p>\n\n                    <p>\n                        <strong>Report Frequency:</strong>\n                        <t t-esc=\"object.frequency.title()\"></t>\n                        <br>\n                    </p>\n\n                    <p>\n                        Please find the report attached with this email.\n                    </p>\n\n                    <p style=\"margin-top: 20px;\">\n                        Best regards,\n                        <br>\n                        <strong>\n                            <t t-esc=\"object.company_id.name\"></t>\n                        </strong>\n                    </p>\n                </div>\n            "
msgstr "<div>\n                    <p>Hola <t t-esc=\"object.user_id.name\"></t>,</p>\n\n                    <p>\n                        Su informe de suscripción programado\n                        <strong>\"<t t-esc=\"object.name.title()\"></t>\"</strong>ha sido generado.\n                    </p>\n\n                    <p>\n                        <strong>Frecuencia del informe:</strong>\n                        <t t-esc=\"object.frequency.title()\"></t>\n                        <br>\n                    </p>\n\n                    <p>\n                        Encontrará el informe adjunto a este correo.\n                    </p>\n\n                    <p style=\"margin-top: 20px;\">\n                        Saludos cordiales,\n                        <br>\n                        <strong>\n                            <t t-esc=\"object.company_id.name\"></t>\n                        </strong>\n                    </p>\n                </div>\n            "

#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.deal_reminder
msgid "<div>\n                   <p>\n                       Hello\n                       <t t-out=\"object.user_id.name\"></t>,\n                       <br>\n                       <br>\n                       The lead \"<t t-out=\"object.name\"></t>\" assigned to you has been idle for a while.\n                   <br>\n                        🔹 Lead Name: <t t-out=\"object.name\"></t>\n                       <br>\n                        🔹 Customer:  <t t-out=\"object.partner_id.name\"></t>\n                       <br>\n                        🔹 Last Activity: <t t-out=\"object.last_stage_update_date\"></t>\n                       <br>\n                        🔹 Days Since Last Update: <t t-out=\"object.lead_idle_days\"></t>\n                       <br>\n                       <br>\n\nPlease take the necessary action to follow up. If this lead is no longer relevant, consider updating its status.\n                       <br>\n                       <br>\n                       <br>\n                       <br>\n                       Thanks and regards\n                   </p>\n               </div>\n           "
msgstr "<div>\n                   <p>\n                       Hola\n                       <t t-out=\"object.user_id.name\"></t>,\n                       <br>\n                       <br>\n                       El prospecto \"<t t-out=\"object.name\"></t>\" asignado a usted ha estado inactivo durante un tiempo.\n                   <br>\n                        🔹 Nombre del prospecto: <t t-out=\"object.name\"></t>\n                       <br>\n                        🔹 Cliente:  <t t-out=\"object.partner_id.name\"></t>\n                       <br>\n                        🔹 Última actividad: <t t-out=\"object.last_stage_update_date\"></t>\n                       <br>\n                        🔹 Días desde la última actualización: <t t-out=\"object.lead_idle_days\"></t>\n                       <br>\n                       <br>\n\nPor favor, tome las medidas necesarias para dar seguimiento. Si este prospecto ya no es relevante, considere actualizar su estado.\n                       <br>\n                       <br>\n                       <br>\n                       <br>\n                       Gracias y saludos\n                   </p>\n               </div>\n           "

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_crm_lead_view_form_inherit
msgid "<span class=\"text-warning\">\n                        <i class=\"fa fa-exclamation-triangle\"/>\n                        Stage requires completion of activity:\n                    </span>"
msgstr "<span class=\"text-warning\">\n                        <i class=\"fa fa-exclamation-triangle\"/>\n                        La etapa requiere completar la actividad:\n                    </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Google Forms\n                                directly from CRM leads,\n                                store form IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from form responses.\n                            </span>"
msgstr "<span>\n                                Al activarlo, los usuarios pueden crear formularios de Google\n                                directamente desde los prospectos del CRM,\n                                almacenar los IDs y URLs de los formularios en el prospecto, y\n                                automatizar opcionalmente la creación de prospectos\n                                a partir de las respuestas de los formularios.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Google Meets\n                                directly Meet CRM leads,\n                                store form IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from form responses.\n                            </span>"
msgstr "<span>\n                                Al activarlo, los usuarios pueden crear reuniones de Google Meet\n                                directamente desde los prospectos del CRM,\n                                almacenar los IDs y URLs de los formularios en el prospecto, y\n                                automatizar opcionalmente la creación de prospectos\n                                a partir de las respuestas de los formularios.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Zoom meetings\n                                directly from CRM leads,\n                                store meeting IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from meeting responses.\n                            </span>"
msgstr "<span>\n                                Al activarlo, los usuarios pueden crear reuniones de Zoom\n                                directamente desde los prospectos del CRM,\n                                almacenar los IDs y URLs de las reuniones en el prospecto, y\n                                automatizar opcionalmente la creación de prospectos\n                                a partir de las respuestas de las reuniones.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create a task\n                                directly\n                                from a won CRM lead.\n                            </span>"
msgstr "<span>\n                                Al activarlo, los usuarios pueden crear una tarea\n                                directamente\n                                a partir de un prospecto ganado del CRM.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create and manage\n                                customer surveys,\n                                link survey responses to CRM leads and\n                                opportunities,\n                                and gain insights to improve customer\n                                engagement.\n                            </span>"
msgstr "<span>\n                                Al activarlo, los usuarios pueden crear y gestionar\n                                encuestas de clientes,\n                                vincular las respuestas de las encuestas a los prospectos del CRM y\n                                oportunidades,\n                                y obtener información para mejorar la interacción\n                                con los clientes.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can upload visiting cards\n                                directly from the Kanban view\n                                and automatically create a CRM lead.\n                            </span>"
msgstr "<span>\n                                Al activarlo, los usuarios pueden subir tarjetas de presentación\n                                directamente desde la vista Kanban\n                                y crear automáticamente un prospecto del CRM.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>Add exit criteria's\n                                for each stage, which should\n                                happen, to move to the next stage.\n                            </span>\n                            <br/>\n                            <br/>"
msgstr "<span>Añada los criterios de salida\n                                para cada etapa, que deben\n                                cumplirse para pasar a la siguiente etapa.\n                            </span>\n                            <br/>\n                            <br/>"

