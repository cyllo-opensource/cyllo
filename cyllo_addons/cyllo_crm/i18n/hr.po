#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.email_template_activity_assigned
msgid "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; line-height: 1.6; color: #333;\">\n                    <div style=\"border-bottom: 2px solid #007bff; padding-bottom: 10px; margin-bottom: 20px;\">\n                        <h2 style=\"color: #007bff; margin: 0;\">Activity Assigned on Lead</h2>\n                    </div>\n\n                    <p>Dear <strong><t t-out=\"ctx.get('user_name')\"></t></strong>,</p>\n\n                    <p>An activity has been assigned to you on the lead <strong>\"<t t-out=\"ctx.get('lead_name')\"></t>\"</strong> (Stage: <t t-out=\"ctx.get('stage_name')\"></t>).</p>\n\n                    <div style=\"background-color: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin: 20px 0;\">\n                        <p style=\"margin: 0;\"><strong>Activity:</strong> <t t-out=\"ctx.get('activity_name')\"></t></p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Due Date:</strong> <t t-out=\"ctx.get('due_date')\"></t></p>\n                    </div>\n\n                    <p>Kindly ensure this activity is completed by the due date to maintain workflow efficiency.</p>\n\n                    <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;\">\n                        <p style=\"margin: 0;\">Best regards,</p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>CRM Team</strong></p>\n                        <t t-if=\"object.company_id.name\">\n                            <p style=\"margin: 5px 0 0 0; color: #666; font-size: 14px;\">\n                                <t t-out=\"object.company_id.name\"></t>\n                            </p>\n                        </t>\n                    </div>\n                </div>\n            "
msgstr "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; line-height: 1.6; color: #333;\">\n                    <div style=\"border-bottom: 2px solid #007bff; padding-bottom: 10px; margin-bottom: 20px;\">\n                        <h2 style=\"color: #007bff; margin: 0;\">Aktivnost dodijeljena na potencijalnom klijentu</h2>\n                    </div>\n\n                    <p>Poštovani/a <strong><t t-out=\"ctx.get('user_name')\"></t></strong>,</p>\n\n                    <p>Dodijeljena vam je aktivnost na potencijalnom klijentu <strong>\"<t t-out=\"ctx.get('lead_name')\"></t>\"</strong> (Faza: <t t-out=\"ctx.get('stage_name')\"></t>).</p>\n\n                    <div style=\"background-color: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin: 20px 0;\">\n                        <p style=\"margin: 0;\"><strong>Aktivnost:</strong> <t t-out=\"ctx.get('activity_name')\"></t></p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Rok:</strong> <t t-out=\"ctx.get('due_date')\"></t></p>\n                    </div>\n\n                    <p>Molimo osigurajte da se ova aktivnost dovrši prije roka radi održavanja učinkovitosti radnog procesa.</p>\n\n                    <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;\">\n                        <p style=\"margin: 0;\">Srdačan pozdrav,</p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>CRM tim</strong></p>\n                        <t t-if=\"object.company_id.name\">\n                            <p style=\"margin: 5px 0 0 0; color: #666; font-size: 14px;\">\n                                <t t-out=\"object.company_id.name\"></t>\n                            </p>\n                        </t>\n                    </div>\n                </div>\n            "

#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.crm_subscription_report_email_template
msgid "<div>\n                    <p>Hi <t t-esc=\"object.user_id.name\"></t>,</p>\n\n                    <p>\n                        Your scheduled subscription report\n                        <strong>\"<t t-esc=\"object.name.title()\"></t>\"</strong>has been generated.\n                    </p>\n\n                    <p>\n                        <strong>Report Frequency:</strong>\n                        <t t-esc=\"object.frequency.title()\"></t>\n                        <br>\n                    </p>\n\n                    <p>\n                        Please find the report attached with this email.\n                    </p>\n\n                    <p style=\"margin-top: 20px;\">\n                        Best regards,\n                        <br>\n                        <strong>\n                            <t t-esc=\"object.company_id.name\"></t>\n                        </strong>\n                    </p>\n                </div>\n            "
msgstr "<div>\n                    <p>Pozdrav <t t-esc=\"object.user_id.name\"></t>,</p>\n\n                    <p>\n                        Vaše planirano izvješće o pretplati\n                        <strong>\"<t t-esc=\"object.name.title()\"></t>\"</strong>je izrađeno.\n                    </p>\n\n                    <p>\n                        <strong>Učestalost izvješća:</strong>\n                        <t t-esc=\"object.frequency.title()\"></t>\n                        <br>\n                    </p>\n\n                    <p>\n                        Izvješće se nalazi u prilogu ove poruke.\n                    </p>\n\n                    <p style=\"margin-top: 20px;\">\n                        Srdačan pozdrav,\n                        <br>\n                        <strong>\n                            <t t-esc=\"object.company_id.name\"></t>\n                        </strong>\n                    </p>\n                </div>\n            "

#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.deal_reminder
msgid "<div>\n                   <p>\n                       Hello\n                       <t t-out=\"object.user_id.name\"></t>,\n                       <br>\n                       <br>\n                       The lead \"<t t-out=\"object.name\"></t>\" assigned to you has been idle for a while.\n                   <br>\n                        🔹 Lead Name: <t t-out=\"object.name\"></t>\n                       <br>\n                        🔹 Customer:  <t t-out=\"object.partner_id.name\"></t>\n                       <br>\n                        🔹 Last Activity: <t t-out=\"object.last_stage_update_date\"></t>\n                       <br>\n                        🔹 Days Since Last Update: <t t-out=\"object.lead_idle_days\"></t>\n                       <br>\n                       <br>\n\nPlease take the necessary action to follow up. If this lead is no longer relevant, consider updating its status.\n                       <br>\n                       <br>\n                       <br>\n                       <br>\n                       Thanks and regards\n                   </p>\n               </div>\n           "
msgstr "<div>\n                   <p>\n                       Pozdrav\n                       <t t-out=\"object.user_id.name\"></t>,\n                       <br>\n                       <br>\n                       Potencijalni klijent \"<t t-out=\"object.name\"></t>\" koji vam je dodijeljen neaktivan je već neko vrijeme.\n                   <br>\n                        🔹 Naziv potencijalnog klijenta: <t t-out=\"object.name\"></t>\n                       <br>\n                        🔹 Klijent:  <t t-out=\"object.partner_id.name\"></t>\n                       <br>\n                        🔹 Posljednja aktivnost: <t t-out=\"object.last_stage_update_date\"></t>\n                       <br>\n                        🔹 Broj dana od zadnjeg ažuriranja: <t t-out=\"object.lead_idle_days\"></t>\n                       <br>\n                       <br>\n\nPoduzmite potrebne radnje za praćenje. Ako ovaj potencijalni klijent više nije relevantan, razmislite o ažuriranju njegovog statusa.\n                       <br>\n                       <br>\n                       <br>\n                       <br>\n                       Hvala i srdačan pozdrav\n                   </p>\n               </div>\n           "

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_crm_lead_view_form_inherit
msgid "<span class=\"text-warning\">\n                        <i class=\"fa fa-exclamation-triangle\"/>\n                        Stage requires completion of activity:\n                    </span>"
msgstr "<span class=\"text-warning\">\n                        <i class=\"fa fa-exclamation-triangle\"/>\n                        Faza zahtijeva dovršetak aktivnosti:\n                    </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Google Forms\n                                directly from CRM leads,\n                                store form IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from form responses.\n                            </span>"
msgstr "<span>\n                                Kada je omogućeno, korisnici mogu izrađivati Google obrasce\n                                izravno iz CRM potencijalnih klijenata,\n                                pohranjivati ID-eve i URL-ove obrazaca uz potencijalnog klijenta te\n                                po želji automatizirati izradu potencijalnih klijenata\n                                na temelju odgovora u obrascu.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Google Meets\n                                directly Meet CRM leads,\n                                store form IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from form responses.\n                            </span>"
msgstr "<span>\n                                Kada je omogućeno, korisnici mogu izrađivati Google Meet sastanke\n                                izravno iz CRM potencijalnih klijenata,\n                                pohranjivati ID-eve i URL-ove obrazaca uz potencijalnog klijenta te\n                                po želji automatizirati izradu potencijalnih klijenata\n                                na temelju odgovora u obrascu.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Zoom meetings\n                                directly from CRM leads,\n                                store meeting IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from meeting responses.\n                            </span>"
msgstr "<span>\n                                Kada je omogućeno, korisnici mogu izrađivati Zoom sastanke\n                                izravno iz CRM potencijalnih klijenata,\n                                pohranjivati ID-eve i URL-ove sastanaka uz potencijalnog klijenta te\n                                po želji automatizirati izradu potencijalnih klijenata\n                                na temelju odgovora na sastancima.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create a task\n                                directly\n                                from a won CRM lead.\n                            </span>"
msgstr "<span>\n                                Kada je omogućeno, korisnici mogu izravno\n                                izraditi zadatak\n                                iz dobivenog CRM potencijalnog klijenta.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create and manage\n                                customer surveys,\n                                link survey responses to CRM leads and\n                                opportunities,\n                                and gain insights to improve customer\n                                engagement.\n                            </span>"
msgstr "<span>\n                                Kada je omogućeno, korisnici mogu izrađivati i upravljati\n                                anketama kupaca,\n                                povezivati odgovore na ankete s CRM potencijalnim klijentima i\n                                prilikama,\n                                te dobiti uvide za poboljšanje\n                                angažmana kupaca.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can upload visiting cards\n                                directly from the Kanban view\n                                and automatically create a CRM lead.\n                            </span>"
msgstr "<span>\n                                Kada je omogućeno, korisnici mogu učitavati posjetnice\n                                izravno iz Kanban prikaza\n                                te automatski izraditi CRM potencijalnog klijenta.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>Add exit criteria's\n                                for each stage, which should\n                                happen, to move to the next stage.\n                            </span>\n                            <br/>\n                            <br/>"
msgstr "<span>Dodajte izlazne kriterije\n                                za svaku fazu, koji se moraju\n                                ispuniti za prijelaz u sljedeću fazu.\n                            </span>\n                            <br/>\n                            <br/>"

