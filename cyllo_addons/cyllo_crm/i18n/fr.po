#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.email_template_activity_assigned
msgid "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; line-height: 1.6; color: #333;\">\n                    <div style=\"border-bottom: 2px solid #007bff; padding-bottom: 10px; margin-bottom: 20px;\">\n                        <h2 style=\"color: #007bff; margin: 0;\">Activity Assigned on Lead</h2>\n                    </div>\n\n                    <p>Dear <strong><t t-out=\"ctx.get('user_name')\"></t></strong>,</p>\n\n                    <p>An activity has been assigned to you on the lead <strong>\"<t t-out=\"ctx.get('lead_name')\"></t>\"</strong> (Stage: <t t-out=\"ctx.get('stage_name')\"></t>).</p>\n\n                    <div style=\"background-color: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin: 20px 0;\">\n                        <p style=\"margin: 0;\"><strong>Activity:</strong> <t t-out=\"ctx.get('activity_name')\"></t></p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Due Date:</strong> <t t-out=\"ctx.get('due_date')\"></t></p>\n                    </div>\n\n                    <p>Kindly ensure this activity is completed by the due date to maintain workflow efficiency.</p>\n\n                    <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;\">\n                        <p style=\"margin: 0;\">Best regards,</p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>CRM Team</strong></p>\n                        <t t-if=\"object.company_id.name\">\n                            <p style=\"margin: 5px 0 0 0; color: #666; font-size: 14px;\">\n                                <t t-out=\"object.company_id.name\"></t>\n                            </p>\n                        </t>\n                    </div>\n                </div>\n            "
msgstr "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; line-height: 1.6; color: #333;\">\n                    <div style=\"border-bottom: 2px solid #007bff; padding-bottom: 10px; margin-bottom: 20px;\">\n                        <h2 style=\"color: #007bff; margin: 0;\">Activité assignée sur la piste</h2>\n                    </div>\n\n                    <p>Cher/Chère <strong><t t-out=\"ctx.get('user_name')\"></t></strong>,</p>\n\n                    <p>Une activité vous a été assignée sur la piste <strong>\"<t t-out=\"ctx.get('lead_name')\"></t>\"</strong> (Étape : <t t-out=\"ctx.get('stage_name')\"></t>).</p>\n\n                    <div style=\"background-color: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin: 20px 0;\">\n                        <p style=\"margin: 0;\"><strong>Activité :</strong> <t t-out=\"ctx.get('activity_name')\"></t></p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Date d'échéance :</strong> <t t-out=\"ctx.get('due_date')\"></t></p>\n                    </div>\n\n                    <p>Veuillez vous assurer que cette activité est terminée avant la date d'échéance afin de maintenir l'efficacité du flux de travail.</p>\n\n                    <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;\">\n                        <p style=\"margin: 0;\">Cordialement,</p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Équipe CRM</strong></p>\n                        <t t-if=\"object.company_id.name\">\n                            <p style=\"margin: 5px 0 0 0; color: #666; font-size: 14px;\">\n                                <t t-out=\"object.company_id.name\"></t>\n                            </p>\n                        </t>\n                    </div>\n                </div>\n            "

#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.crm_subscription_report_email_template
msgid "<div>\n                    <p>Hi <t t-esc=\"object.user_id.name\"></t>,</p>\n\n                    <p>\n                        Your scheduled subscription report\n                        <strong>\"<t t-esc=\"object.name.title()\"></t>\"</strong>has been generated.\n                    </p>\n\n                    <p>\n                        <strong>Report Frequency:</strong>\n                        <t t-esc=\"object.frequency.title()\"></t>\n                        <br>\n                    </p>\n\n                    <p>\n                        Please find the report attached with this email.\n                    </p>\n\n                    <p style=\"margin-top: 20px;\">\n                        Best regards,\n                        <br>\n                        <strong>\n                            <t t-esc=\"object.company_id.name\"></t>\n                        </strong>\n                    </p>\n                </div>\n            "
msgstr "<div>\n                    <p>Bonjour <t t-esc=\"object.user_id.name\"></t>,</p>\n\n                    <p>\n                        Votre rapport d'abonnement programmé\n                        <strong>\"<t t-esc=\"object.name.title()\"></t>\"</strong>a été généré.\n                    </p>\n\n                    <p>\n                        <strong>Fréquence du rapport :</strong>\n                        <t t-esc=\"object.frequency.title()\"></t>\n                        <br>\n                    </p>\n\n                    <p>\n                        Veuillez trouver le rapport joint à cet e-mail.\n                    </p>\n\n                    <p style=\"margin-top: 20px;\">\n                        Cordialement,\n                        <br>\n                        <strong>\n                            <t t-esc=\"object.company_id.name\"></t>\n                        </strong>\n                    </p>\n                </div>\n            "

#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.deal_reminder
msgid "<div>\n                   <p>\n                       Hello\n                       <t t-out=\"object.user_id.name\"></t>,\n                       <br>\n                       <br>\n                       The lead \"<t t-out=\"object.name\"></t>\" assigned to you has been idle for a while.\n                   <br>\n                        🔹 Lead Name: <t t-out=\"object.name\"></t>\n                       <br>\n                        🔹 Customer:  <t t-out=\"object.partner_id.name\"></t>\n                       <br>\n                        🔹 Last Activity: <t t-out=\"object.last_stage_update_date\"></t>\n                       <br>\n                        🔹 Days Since Last Update: <t t-out=\"object.lead_idle_days\"></t>\n                       <br>\n                       <br>\n\nPlease take the necessary action to follow up. If this lead is no longer relevant, consider updating its status.\n                       <br>\n                       <br>\n                       <br>\n                       <br>\n                       Thanks and regards\n                   </p>\n               </div>\n           "
msgstr "<div>\n                   <p>\n                       Bonjour\n                       <t t-out=\"object.user_id.name\"></t>,\n                       <br>\n                       <br>\n                       La piste \"<t t-out=\"object.name\"></t>\" qui vous est assignée est inactive depuis un moment.\n                   <br>\n                        🔹 Nom de la piste : <t t-out=\"object.name\"></t>\n                       <br>\n                        🔹 Client :  <t t-out=\"object.partner_id.name\"></t>\n                       <br>\n                        🔹 Dernière activité : <t t-out=\"object.last_stage_update_date\"></t>\n                       <br>\n                        🔹 Jours depuis la dernière mise à jour : <t t-out=\"object.lead_idle_days\"></t>\n                       <br>\n                       <br>\n\nVeuillez prendre les mesures nécessaires pour effectuer un suivi. Si cette piste n'est plus pertinente, envisagez de mettre à jour son statut.\n                       <br>\n                       <br>\n                       <br>\n                       <br>\n                       Cordialement\n                   </p>\n               </div>\n           "

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_crm_lead_view_form_inherit
msgid "<span class=\"text-warning\">\n                        <i class=\"fa fa-exclamation-triangle\"/>\n                        Stage requires completion of activity:\n                    </span>"
msgstr "<span class=\"text-warning\">\n                        <i class=\"fa fa-exclamation-triangle\"/>\n                        L'étape nécessite l'achèvement de l'activité :\n                    </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Google Forms\n                                directly from CRM leads,\n                                store form IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from form responses.\n                            </span>"
msgstr "<span>\n                                Une fois activée, cette option permet aux utilisateurs de créer des formulaires Google\n                                directement depuis les pistes du CRM,\n                                de stocker les ID et URL des formulaires dans la piste, et\n                                d'automatiser éventuellement la création de pistes\n                                à partir des réponses aux formulaires.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Google Meets\n                                directly Meet CRM leads,\n                                store form IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from form responses.\n                            </span>"
msgstr "<span>\n                                Une fois activée, cette option permet aux utilisateurs de créer des réunions Google Meet\n                                directement depuis les pistes du CRM,\n                                de stocker les ID et URL des formulaires dans la piste, et\n                                d'automatiser éventuellement la création de pistes\n                                à partir des réponses aux formulaires.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Zoom meetings\n                                directly from CRM leads,\n                                store meeting IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from meeting responses.\n                            </span>"
msgstr "<span>\n                                Une fois activée, cette option permet aux utilisateurs de créer des réunions Zoom\n                                directement depuis les pistes du CRM,\n                                de stocker les ID et URL des réunions dans la piste, et\n                                d'automatiser éventuellement la création de pistes\n                                à partir des réponses aux réunions.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create a task\n                                directly\n                                from a won CRM lead.\n                            </span>"
msgstr "<span>\n                                Une fois activée, cette option permet aux utilisateurs de créer une tâche\n                                directement\n                                à partir d'une piste CRM gagnée.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create and manage\n                                customer surveys,\n                                link survey responses to CRM leads and\n                                opportunities,\n                                and gain insights to improve customer\n                                engagement.\n                            </span>"
msgstr "<span>\n                                Une fois activée, cette option permet aux utilisateurs de créer et de gérer\n                                des enquêtes clients,\n                                de lier les réponses aux enquêtes aux pistes du CRM et\n                                aux opportunités,\n                                et d'obtenir des informations pour améliorer l'engagement\n                                client.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can upload visiting cards\n                                directly from the Kanban view\n                                and automatically create a CRM lead.\n                            </span>"
msgstr "<span>\n                                Une fois activée, cette option permet aux utilisateurs de télécharger des cartes de visite\n                                directement depuis la vue Kanban\n                                et de créer automatiquement une piste CRM.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>Add exit criteria's\n                                for each stage, which should\n                                happen, to move to the next stage.\n                            </span>\n                            <br/>\n                            <br/>"
msgstr "<span>Ajoutez des critères de sortie\n                                pour chaque étape, qui doivent\n                                se produire pour passer à l'étape suivante.\n                            </span>\n                            <br/>\n                            <br/>"

