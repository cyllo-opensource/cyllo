#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.email_template_activity_assigned
msgid "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; line-height: 1.6; color: #333;\">\n                    <div style=\"border-bottom: 2px solid #007bff; padding-bottom: 10px; margin-bottom: 20px;\">\n                        <h2 style=\"color: #007bff; margin: 0;\">Activity Assigned on Lead</h2>\n                    </div>\n\n                    <p>Dear <strong><t t-out=\"ctx.get('user_name')\"></t></strong>,</p>\n\n                    <p>An activity has been assigned to you on the lead <strong>\"<t t-out=\"ctx.get('lead_name')\"></t>\"</strong> (Stage: <t t-out=\"ctx.get('stage_name')\"></t>).</p>\n\n                    <div style=\"background-color: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin: 20px 0;\">\n                        <p style=\"margin: 0;\"><strong>Activity:</strong> <t t-out=\"ctx.get('activity_name')\"></t></p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Due Date:</strong> <t t-out=\"ctx.get('due_date')\"></t></p>\n                    </div>\n\n                    <p>Kindly ensure this activity is completed by the due date to maintain workflow efficiency.</p>\n\n                    <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;\">\n                        <p style=\"margin: 0;\">Best regards,</p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>CRM Team</strong></p>\n                        <t t-if=\"object.company_id.name\">\n                            <p style=\"margin: 5px 0 0 0; color: #666; font-size: 14px;\">\n                                <t t-out=\"object.company_id.name\"></t>\n                            </p>\n                        </t>\n                    </div>\n                </div>\n            "
msgstr "<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; line-height: 1.6; color: #333;\">\n                    <div style=\"border-bottom: 2px solid #007bff; padding-bottom: 10px; margin-bottom: 20px;\">\n                        <h2 style=\"color: #007bff; margin: 0;\">Activiteit toegewezen aan lead</h2>\n                    </div>\n\n                    <p>Beste <strong><t t-out=\"ctx.get('user_name')\"></t></strong>,</p>\n\n                    <p>Er is een activiteit aan u toegewezen op de lead <strong>\"<t t-out=\"ctx.get('lead_name')\"></t>\"</strong> (Fase: <t t-out=\"ctx.get('stage_name')\"></t>).</p>\n\n                    <div style=\"background-color: #f8f9fa; border-left: 4px solid #007bff; padding: 15px; margin: 20px 0;\">\n                        <p style=\"margin: 0;\"><strong>Activiteit:</strong> <t t-out=\"ctx.get('activity_name')\"></t></p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>Vervaldatum:</strong> <t t-out=\"ctx.get('due_date')\"></t></p>\n                    </div>\n\n                    <p>Zorg ervoor dat deze activiteit voor de vervaldatum wordt afgerond om de efficiëntie van de workflow te behouden.</p>\n\n                    <div style=\"margin-top: 30px; padding-top: 20px; border-top: 1px solid #eee;\">\n                        <p style=\"margin: 0;\">Met vriendelijke groet,</p>\n                        <p style=\"margin: 5px 0 0 0;\"><strong>CRM-team</strong></p>\n                        <t t-if=\"object.company_id.name\">\n                            <p style=\"margin: 5px 0 0 0; color: #666; font-size: 14px;\">\n                                <t t-out=\"object.company_id.name\"></t>\n                            </p>\n                        </t>\n                    </div>\n                </div>\n            "

#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.crm_subscription_report_email_template
msgid "<div>\n                    <p>Hi <t t-esc=\"object.user_id.name\"></t>,</p>\n\n                    <p>\n                        Your scheduled subscription report\n                        <strong>\"<t t-esc=\"object.name.title()\"></t>\"</strong>has been generated.\n                    </p>\n\n                    <p>\n                        <strong>Report Frequency:</strong>\n                        <t t-esc=\"object.frequency.title()\"></t>\n                        <br>\n                    </p>\n\n                    <p>\n                        Please find the report attached with this email.\n                    </p>\n\n                    <p style=\"margin-top: 20px;\">\n                        Best regards,\n                        <br>\n                        <strong>\n                            <t t-esc=\"object.company_id.name\"></t>\n                        </strong>\n                    </p>\n                </div>\n            "
msgstr "<div>\n                    <p>Hallo <t t-esc=\"object.user_id.name\"></t>,</p>\n\n                    <p>\n                        Uw geplande abonnementsrapport\n                        <strong>\"<t t-esc=\"object.name.title()\"></t>\"</strong>is gegenereerd.\n                    </p>\n\n                    <p>\n                        <strong>Rapportagefrequentie:</strong>\n                        <t t-esc=\"object.frequency.title()\"></t>\n                        <br>\n                    </p>\n\n                    <p>\n                        U vindt het rapport bijgevoegd bij deze e-mail.\n                    </p>\n\n                    <p style=\"margin-top: 20px;\">\n                        Met vriendelijke groet,\n                        <br>\n                        <strong>\n                            <t t-esc=\"object.company_id.name\"></t>\n                        </strong>\n                    </p>\n                </div>\n            "

#. module: cyllo_crm
#: model:mail.template,body_html:cyllo_crm.deal_reminder
msgid "<div>\n                   <p>\n                       Hello\n                       <t t-out=\"object.user_id.name\"></t>,\n                       <br>\n                       <br>\n                       The lead \"<t t-out=\"object.name\"></t>\" assigned to you has been idle for a while.\n                   <br>\n                        🔹 Lead Name: <t t-out=\"object.name\"></t>\n                       <br>\n                        🔹 Customer:  <t t-out=\"object.partner_id.name\"></t>\n                       <br>\n                        🔹 Last Activity: <t t-out=\"object.last_stage_update_date\"></t>\n                       <br>\n                        🔹 Days Since Last Update: <t t-out=\"object.lead_idle_days\"></t>\n                       <br>\n                       <br>\n\nPlease take the necessary action to follow up. If this lead is no longer relevant, consider updating its status.\n                       <br>\n                       <br>\n                       <br>\n                       <br>\n                       Thanks and regards\n                   </p>\n               </div>\n           "
msgstr "<div>\n                   <p>\n                       Hallo\n                       <t t-out=\"object.user_id.name\"></t>,\n                       <br>\n                       <br>\n                       De lead \"<t t-out=\"object.name\"></t>\" die aan u is toegewezen, is al een tijdje inactief.\n                   <br>\n                        🔹 Naam lead: <t t-out=\"object.name\"></t>\n                       <br>\n                        🔹 Klant:  <t t-out=\"object.partner_id.name\"></t>\n                       <br>\n                        🔹 Laatste activiteit: <t t-out=\"object.last_stage_update_date\"></t>\n                       <br>\n                        🔹 Dagen sinds laatste update: <t t-out=\"object.lead_idle_days\"></t>\n                       <br>\n                       <br>\n\nOnderneem de nodige actie om op te volgen. Als deze lead niet meer relevant is, overweeg dan om de status bij te werken.\n                       <br>\n                       <br>\n                       <br>\n                       <br>\n                       Met vriendelijke groet\n                   </p>\n               </div>\n           "

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_crm_lead_view_form_inherit
msgid "<span class=\"text-warning\">\n                        <i class=\"fa fa-exclamation-triangle\"/>\n                        Stage requires completion of activity:\n                    </span>"
msgstr "<span class=\"text-warning\">\n                        <i class=\"fa fa-exclamation-triangle\"/>\n                        Deze fase vereist voltooiing van de activiteit:\n                    </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Google Forms\n                                directly from CRM leads,\n                                store form IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from form responses.\n                            </span>"
msgstr "<span>\n                                Indien ingeschakeld, kunnen gebruikers Google Formulieren\n                                rechtstreeks vanuit CRM-leads aanmaken,\n                                formulier-ID's en URL's opslaan bij de lead, en\n                                optioneel het aanmaken van leads automatiseren\n                                op basis van formulierreacties.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Google Meets\n                                directly Meet CRM leads,\n                                store form IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from form responses.\n                            </span>"
msgstr "<span>\n                                Indien ingeschakeld, kunnen gebruikers Google Meet-vergaderingen\n                                rechtstreeks vanuit CRM-leads aanmaken,\n                                formulier-ID's en URL's opslaan bij de lead, en\n                                optioneel het aanmaken van leads automatiseren\n                                op basis van formulierreacties.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create Zoom meetings\n                                directly from CRM leads,\n                                store meeting IDs and URLs in the lead, and\n                                optionally automate lead creation\n                                from meeting responses.\n                            </span>"
msgstr "<span>\n                                Indien ingeschakeld, kunnen gebruikers Zoom-vergaderingen\n                                rechtstreeks vanuit CRM-leads aanmaken,\n                                vergader-ID's en URL's opslaan bij de lead, en\n                                optioneel het aanmaken van leads automatiseren\n                                op basis van vergaderreacties.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create a task\n                                directly\n                                from a won CRM lead.\n                            </span>"
msgstr "<span>\n                                Indien ingeschakeld, kunnen gebruikers rechtstreeks\n                                een taak aanmaken\n                                vanuit een gewonnen CRM-lead.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can create and manage\n                                customer surveys,\n                                link survey responses to CRM leads and\n                                opportunities,\n                                and gain insights to improve customer\n                                engagement.\n                            </span>"
msgstr "<span>\n                                Indien ingeschakeld, kunnen gebruikers klantonderzoeken\n                                aanmaken en beheren,\n                                enquêtereacties koppelen aan CRM-leads en\n                                verkoopkansen,\n                                en inzichten verkrijgen om de klantbetrokkenheid\n                                te verbeteren.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>\n                                When enabled, users can upload visiting cards\n                                directly from the Kanban view\n                                and automatically create a CRM lead.\n                            </span>"
msgstr "<span>\n                                Indien ingeschakeld, kunnen gebruikers visitekaartjes\n                                rechtstreeks vanuit de Kanban-weergave uploaden\n                                en automatisch een CRM-lead aanmaken.\n                            </span>"

#. module: cyllo_crm
#: model_terms:ir.ui.view,arch_db:cyllo_crm.view_res_config_settings_form
msgid "<span>Add exit criteria's\n                                for each stage, which should\n                                happen, to move to the next stage.\n                            </span>\n                            <br/>\n                            <br/>"
msgstr "<span>Voeg uitgangscriteria toe\n                                voor elke fase, die moeten\n                                gebeuren om naar de volgende fase te gaan.\n                            </span>\n                            <br/>\n                            <br/>"

