<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
<!--Subscription Report Email Template-->
        <record id="crm_subscription_report_email_template" model="mail.template">
            <field name="name">CRM Subscription Report</field>
            <field name="model_id" ref="cyllo_crm.model_crm_subscription_report"/>
            <field name="subject">{{ object.frequency.title()}} Subscription Report : {{ object.name.title()}}</field>
            <field name="email_from">{{ object.company_id.email}}</field>
            <field name="email_to">{{ object.user_id.partner_id.email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 24px 12px; background-color: #F4F6F8; font-family: 'Segoe UI', Helvetica, Arial, sans-serif; color: #3C4043;">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 590px; margin: 0 auto; background-color: #FFFFFF; border: 1px solid #E5E7EB; border-top: 4px solid #9EA700; border-radius: 8px; border-collapse: separate;">
                        <tr>
                            <td style="padding: 28px 32px 8px 32px;">
                                <span style="font-size: 11px; color: #9EA700; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">CRM Report</span>
                                <div style="font-size: 22px; font-weight: 700; color: #1F2933; margin-top: 4px;">Subscription Report</div>
                                <hr style="border: none; border-top: 1px solid #E5E7EB; margin: 16px 0 0 0;"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 32px 28px 32px; font-size: 14px; line-height: 1.6; color: #3C4043;">
                                <p style="margin: 0 0 16px 0;">Hi <strong><t t-esc="object.user_id.name"/></strong>,</p>
                                <p style="margin: 0 0 16px 0;">Your scheduled subscription report <strong>"<t t-esc="object.name.title()"/>"</strong> has been generated.</p>
                                <div style="margin: 16px 0; padding: 12px 16px; background-color: #F7F8E6; border-left: 4px solid #9EA700; border-radius: 4px;">
                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding: 2px 16px 2px 0; color: #6B7280; white-space: nowrap;">Report Frequency</td><td style="padding: 2px 0; font-weight: 600; color: #1F2933;"><t t-esc="object.frequency.title()"/></td></tr></table>
                                </div>
                                <p style="margin: 0 0 16px 0;">Please find the report attached with this email.</p>
                                <p style="margin: 24px 0 0 0;">Best regards,<br/><strong><t t-esc="object.company_id.name"/></strong></p>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding: 0 32px 20px 32px; font-size: 11px; color: #999999;">
                                <hr style="border: none; border-top: 1px solid #E5E7EB; margin: 0 0 12px 0;"/>
                                <t t-if="object.company_id.name"><b style="color: #555555;"><t t-out="object.company_id.name"/></b><br/></t>
                                Powered by <a href="https://www.cyllo.com" style="color: #9EA700; text-decoration: none;">Cyllo</a>
                            </td>
                        </tr>
                    </table>
                </div>
            </field>
        </record>
<!--Advance Followup Email Template-->
        <record id="email_template_activity_assigned" model="mail.template">
            <field name="name">CRM Lead Activity Assignment</field>
            <field name="email_from">{{ object.company_id.email }}</field>
            <field name="email_to">{{ ctx.get('email_to') }}</field>
            <field name="subject">{{ ctx.get('activity_name') }} Activity Assigned on Lead {{ ctx.get('lead_name') }}</field>
            <field name="model_id" ref="model_crm_stage_activity"/>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 24px 12px; background-color: #F4F6F8; font-family: 'Segoe UI', Helvetica, Arial, sans-serif; color: #3C4043;">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 590px; margin: 0 auto; background-color: #FFFFFF; border: 1px solid #E5E7EB; border-top: 4px solid #9EA700; border-radius: 8px; border-collapse: separate;">
                        <tr>
                            <td style="padding: 28px 32px 8px 32px;">
                                <span style="font-size: 11px; color: #9EA700; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">CRM Activity</span>
                                <div style="font-size: 22px; font-weight: 700; color: #1F2933; margin-top: 4px;">Activity Assigned on Lead</div>
                                <hr style="border: none; border-top: 1px solid #E5E7EB; margin: 16px 0 0 0;"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 32px 28px 32px; font-size: 14px; line-height: 1.6; color: #3C4043;">
                                <p style="margin: 0 0 16px 0;">Dear <strong><t t-out="ctx.get('user_name')"/></strong>,</p>
                                <p style="margin: 0 0 16px 0;">An activity has been assigned to you on the lead <strong>"<t t-out="ctx.get('lead_name')"/>"</strong> (Stage: <t t-out="ctx.get('stage_name')"/>).</p>
                                <div style="margin: 16px 0; padding: 12px 16px; background-color: #F7F8E6; border-left: 4px solid #9EA700; border-radius: 4px;">
                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding: 2px 16px 2px 0; color: #6B7280; white-space: nowrap;">Activity</td><td style="padding: 2px 0; font-weight: 600; color: #1F2933;"><t t-out="ctx.get('activity_name')"/></td></tr><tr><td style="padding: 2px 16px 2px 0; color: #6B7280; white-space: nowrap;">Due Date</td><td style="padding: 2px 0; font-weight: 600; color: #1F2933;"><t t-out="ctx.get('due_date')"/></td></tr></table>
                                </div>
                                <p style="margin: 0 0 16px 0;">Kindly ensure this activity is completed by the due date to maintain workflow efficiency.</p>
                                <p style="margin: 24px 0 0 0;">Best regards,<br/><strong>CRM Team</strong></p>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding: 0 32px 20px 32px; font-size: 11px; color: #999999;">
                                <hr style="border: none; border-top: 1px solid #E5E7EB; margin: 0 0 12px 0;"/>
                                <t t-if="object.company_id.name"><b style="color: #555555;"><t t-out="object.company_id.name"/></b><br/></t>
                                Powered by <a href="https://www.cyllo.com" style="color: #9EA700; text-decoration: none;">Cyllo</a>
                            </td>
                        </tr>
                    </table>
                </div>
            </field>
        </record>
<!--Deal Reminder Mail Template-->
        <record id="deal_reminder" model="mail.template">
           <field name="name">Deal Reminder</field>
           <field name="model_id" ref="cyllo_crm.model_crm_lead"/>
           <field name="subject">{{ object.name }}</field>
           <field name="email_from">{{ object.company_id.email }}</field>
           <field name="email_to">{{ object.user_id.email }}</field>
           <field name="description">Add Description</field>
           <field name="body_html" type="html">
                <div style="margin: 0; padding: 24px 12px; background-color: #F4F6F8; font-family: 'Segoe UI', Helvetica, Arial, sans-serif; color: #3C4043;">
                    <table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 590px; margin: 0 auto; background-color: #FFFFFF; border: 1px solid #E5E7EB; border-top: 4px solid #9EA700; border-radius: 8px; border-collapse: separate;">
                        <tr>
                            <td style="padding: 28px 32px 8px 32px;">
                                <span style="font-size: 11px; color: #9EA700; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">CRM Reminder</span>
                                <div style="font-size: 22px; font-weight: 700; color: #1F2933; margin-top: 4px;">Idle Lead Reminder</div>
                                <hr style="border: none; border-top: 1px solid #E5E7EB; margin: 16px 0 0 0;"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 32px 28px 32px; font-size: 14px; line-height: 1.6; color: #3C4043;">
                                <p style="margin: 0 0 16px 0;">Hello <strong><t t-out="object.user_id.name"/></strong>,</p>
                                <p style="margin: 0 0 16px 0;">The lead "<t t-out="object.name"/>" assigned to you has been idle for a while.</p>
                                <div style="margin: 16px 0; padding: 12px 16px; background-color: #F7F8E6; border-left: 4px solid #9EA700; border-radius: 4px;">
                                    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td style="padding: 2px 16px 2px 0; color: #6B7280; white-space: nowrap;">Lead Name</td><td style="padding: 2px 0; font-weight: 600; color: #1F2933;"><t t-out="object.name"/></td></tr><tr><td style="padding: 2px 16px 2px 0; color: #6B7280; white-space: nowrap;">Customer</td><td style="padding: 2px 0; font-weight: 600; color: #1F2933;"><t t-out="object.partner_id.name"/></td></tr><tr><td style="padding: 2px 16px 2px 0; color: #6B7280; white-space: nowrap;">Last Activity</td><td style="padding: 2px 0; font-weight: 600; color: #1F2933;"><t t-out="object.last_stage_update_date"/></td></tr><tr><td style="padding: 2px 16px 2px 0; color: #6B7280; white-space: nowrap;">Days Since Last Update</td><td style="padding: 2px 0; font-weight: 600; color: #1F2933;"><t t-out="object.lead_idle_days"/></td></tr></table>
                                </div>
                                <p style="margin: 0 0 16px 0;">Please take the necessary action to follow up. If this lead is no longer relevant, consider updating its status.</p>
                                <p style="margin: 24px 0 0 0;">Thanks and regards</p>
                            </td>
                        </tr>
                        <tr>
                            <td align="center" style="padding: 0 32px 20px 32px; font-size: 11px; color: #999999;">
                                <hr style="border: none; border-top: 1px solid #E5E7EB; margin: 0 0 12px 0;"/>
                                <t t-if="object.company_id.name"><b style="color: #555555;"><t t-out="object.company_id.name"/></b><br/></t>
                                Powered by <a href="https://www.cyllo.com" style="color: #9EA700; text-decoration: none;">Cyllo</a>
                            </td>
                        </tr>
                    </table>
                </div>
           </field>
       </record>
    </data>
</odoo>
