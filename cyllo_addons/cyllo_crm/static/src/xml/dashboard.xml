<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="crm_dashboard.crm_dashboard_template">
        <div t-att-class="'cy_crm_dashboard' + (state.isSampleData ? ' sample-data-mode' : '')">
            <!-- Header Section -->
            <div
                class="dashboard-header cy_pj_dashboard background-image-banner control-panel">
                <div class="header-content">
                    <div class="heading">
                        <span class="dashboard-header-title">Dashboard</span>
                        <p class="dashboard-header-subtitle">Get a clear view of your sales, activities, and team performance</p>
                    </div>
                </div>
                <div class="dashboard-filters-section">
                    <div class="cy-header-actions">
                        <button class="btn cy-view-report-btn"
                            type="button"
                            t-on-click="onViewReportsClick"
                            data-tooltip="Open CRM Analysis Report">
                            <i class="ri-file-chart-line"></i> View Report
                        </button>
                        <button id="cydialogBtn" t-ref="filterButton"
                            class="btn btn-secondary themed-bg dropdown-toggle cy-dash-filter-btn cy-churn-filter-btn"
                            type="button"
                            t-on-click="onToggleFilters"
                            data-tooltip="Apply Filters">
                            <i class="ri-filter-line"></i> Filter
                        </button>
                    </div>
                    <div class="filters-content" t-if="state.showFilters">
                        <!-- Main filter row - all filters in one row -->
                        <div class="filter-row">
                            <!-- Date Range Filter (checkbox dropdown) -->
                            <div class="filter-item">
                                <label class="filter-label">
                                    <i class="fa fa-calendar"/>
                                    Date Range
                                </label>
                                <div class="cy-dropdown">
                                    <button type="button"
                                            class="form-select cy-dropdown-toggle"
                                            t-att-class="state.filterDraft.dateRange !== 'this_month' ? 'cy-select-filled' : ''"
                                            t-on-click.stop="() => this.toggleFilterDropdown('dates')">
                                        <span t-esc="getDateRangeLabel()"/>
                                    </button>
                                    <div class="cy-dropdown-menu"
                                         t-if="state.openDropdown === 'dates'">
                                        <div class="cy-dropdown-option"
                                             t-foreach="dateRangeOptions"
                                             t-as="opt" t-key="opt.value"
                                             t-att-class="state.filterDraft.dateRange == opt.value ? 'cy-option-selected' : ''"
                                             t-on-click.stop="() => this.onDraftDateRangeOption(opt.value)">
                                            <input type="checkbox"
                                                   t-att-checked="state.filterDraft.dateRange == opt.value"/>
                                            <span class="cy-option-label"
                                                  t-esc="opt.label"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sales Team Filter (checkbox dropdown) -->
                            <div class="filter-item">
                                <label class="filter-label">
                                    <i class="fa fa-users"/>
                                    Sales Team
                                </label>
                                <div class="cy-dropdown">
                                    <button type="button"
                                            class="form-select cy-dropdown-toggle"
                                            t-att-class="state.filterDraft.salesTeams.length ? 'cy-select-filled' : ''"
                                            t-on-click.stop="() => this.toggleFilterDropdown('teams')">
                                        <span t-esc="getSalesTeamsNames() or 'All Teams'"/>
                                    </button>
                                    <div class="cy-dropdown-menu"
                                         t-if="state.openDropdown === 'teams'">
                                        <div class="cy-dropdown-option"
                                             t-on-click.stop="() => this.onDraftSalesTeamOption('')">
                                            <input type="checkbox"
                                                   t-att-checked="!state.filterDraft.salesTeams.length"/>
                                            <span class="cy-option-label">All Teams</span>
                                        </div>
                                        <div class="cy-dropdown-option"
                                             t-foreach="state.salesTeams"
                                             t-as="team" t-key="team.id"
                                             t-att-class="state.filterDraft.salesTeams.includes(team.id) ? 'cy-option-selected' : ''"
                                             t-on-click.stop="() => this.onDraftSalesTeamOption(team.id)">
                                            <input type="checkbox"
                                                   t-att-checked="state.filterDraft.salesTeams.includes(team.id)"/>
                                            <span class="cy-option-label"
                                                  t-esc="team.name"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sales Persons Filter (checkbox dropdown) -->
                            <div class="filter-item"
                                 t-if="!state.hideSalespersonFilter">
                                <label class="filter-label">
                                    <i class="fa fa-user"/>
                                    Sales Persons
                                </label>
                                <div class="cy-dropdown">
                                    <button type="button"
                                            class="form-select cy-dropdown-toggle"
                                            t-att-class="state.filterDraft.salesPersons.length ? 'cy-select-filled' : ''"
                                            t-on-click.stop="() => this.toggleFilterDropdown('persons')">
                                        <span t-esc="getSalesPersonsNames() or 'All sales persons'"/>
                                    </button>
                                    <div class="cy-dropdown-menu"
                                         t-if="state.openDropdown === 'persons'">
                                        <div class="cy-dropdown-option"
                                             t-on-click.stop="() => this.onDraftSalespersonOption('')">
                                            <input type="checkbox"
                                                   t-att-checked="!state.filterDraft.salesPersons.length"/>
                                            <span class="cy-option-label">All sales persons</span>
                                        </div>
                                        <div class="cy-dropdown-option"
                                             t-foreach="state.salespersons"
                                             t-as="person" t-key="person.id"
                                             t-att-class="state.filterDraft.salesPersons.includes(person.id) ? 'cy-option-selected' : ''"
                                             t-on-click.stop="() => this.onDraftSalespersonOption(person.id)">
                                            <input type="checkbox"
                                                   t-att-checked="state.filterDraft.salesPersons.includes(person.id)"/>
                                            <span class="cy-option-label"
                                                  t-esc="person.name"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Custom Date Range (appears when custom is selected) -->
                        <div class="custom-date-section"
                             t-if="state.filterDraft.dateRange === 'custom'">
                            <div class="date-inputs">
                                <div class="date-input-group">
                                    <label class="date-label">From Date</label>
                                    <input type="date" class=" date-input"
                                           t-model="state.filterDraft.dateFrom"
                                           t-att-max="state.filterDraft.dateTo"/>
                                </div>
                                <div class="date-separator">
                                    <i class="fa fa-arrow-right"/>
                                </div>
                                <div class="date-input-group">
                                    <label class="date-label">To Date</label>
                                    <input type="date" class="date-input"
                                           t-model="state.filterDraft.dateTo"
                                           t-att-min="state.filterDraft.dateFrom"/>
                                </div>
                            </div>
                        </div>

                        <!-- Active Filters Display -->
                        <div class="active-filters-section"
                             t-if="hasActiveFilters()">
                            <div class="active-filters-header">
                                <span class="active-filters-label">
                                    <i class="fa fa-tag"/>
                                    Active Filters
                                </span>
                            </div>
                            <div class="filter-tags">
                                <span class="filter-tag"
                                      t-if="state.filterDraft.dateRange !== 'this_month'">
                                    <span class="tag-content"
                                          t-esc="getDateRangeLabel()"/>
                                    <i class="fa fa-times tag-remove"
                                       t-on-click="clearDateFilter"/>
                                </span>
                                <span class="filter-tag"
                                      t-if="state.filterDraft.salesTeams.length">
                                    <span class="tag-content"
                                          t-esc="'Team: ' + getSalesTeamsNames()"/>
                                    <i class="fa fa-times tag-remove"
                                       t-on-click="clearSalesTeamFilter"/>
                                </span>
                                <span class="filter-tag"
                                      t-if="!state.hideSalespersonFilter and state.filterDraft.salesPersons.length">
                                    <span class="tag-content"
                                          t-esc="'Person: ' + getSalesPersonsNames()"/>
                                    <i class="fa fa-times tag-remove"
                                       t-on-click="clearSalespersonFilter"/>
                                </span>
                                <span class="filter-tag" t-if="state.filters.stage">
                                    <span class="tag-content"
                                          t-esc="'Stage: ' + getStageName()"/>
                                    <i class="fa fa-times tag-remove"
                                       t-on-click="clearStageFilter"/>
                                </span>
                            </div>
                        </div>

                        <!-- Popover footer: Clear Filter / Apply -->
                        <div class="filter-footer">
                            <button class="cy-filter-clear"
                                    type="button"
                                    t-on-click="onResetFilters">
                                Clear Filter
                            </button>
                            <button class="cy-filter-apply"
                                    type="button"
                                    t-on-click="onApplyFilters">
                                Apply
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="o_view_nocontent cy-nocontent-wrap" t-if="state.isSampleData">
                <div class="o_nocontent_help">
                    <p class="o_view_nocontent_smiling_face">
                        No data found. Showing sample data.
                    </p>
                    <p>
                        Create a new lead, the first step of a new opportunity!<br/>
                        You can also widen the date range or clear the filters
                        to include more records.
                    </p>
                </div>
            </div>

                <!-- Key Metrics Cards -->
            <div class="metrics-grid">
                <t t-foreach="state.metrics" t-as="metric" t-key="metric_index">
                    <div class="metric-card cy-kpi-card"
                        t-att-data-metric-type="metric.type"
                        t-on-click="() => onMetricClick(metric, this.action)">
                        <div class="metric-content">
                            <div class="metric-info">
                                <p class="metric-label" t-esc="metric.label"/>
                                <div class="metric-value-row">
                                    <span class="metric-value" t-esc="metric.formatted_value"/>
                                    <span class="metric-unit" t-if="metric.unit" t-esc="metric.unit"/>
                                </div>
                                <p class="metric-change"
                                   t-att-class="metric.change >= 0 ? 'positive-change' : 'negative-change'">
                                    <t t-if="metric.change >= 0">
                                        <i class="ri-arrow-right-up-line"/>
                                        <t t-esc="'+' + metric.change"/>% from last period
                                    </t>
                                    <t t-else="">
                                        <i class="ri-arrow-right-down-line"/>
                                        <t t-esc="metric.change"/>% from last period
                                    </t>
                                </p>
                            </div>
                            <div class="metric-icon">
                                <i t-att-class="metric.icon"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            <!-- Row 3: Sales Pipeline + Top Performers + Updates -->
            <div class="performance-grid">
                <!-- Pipeline Chart -->
                <div class="chart-card cy-kpi-card cy-pipeline-card">
                    <div class="chart-header">
                        <h3 class="chart-title">Sales Pipeline</h3>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-secondary"
                                    t-on-click="()=>this.exportData('sale')"
                                    data-chart="pipeline">
                                <i class="fa fa-download"/>
                            </button>
                        </div>
                    </div>
                    <div class="cy-pipeline-track">
                        <div class="chart-container">
                            <canvas t-ref="pipelineChart"/>
                        </div>
                        <div class="chart-legend pipeline-legend">
                            <t t-foreach="state.pipeline" t-as="stage"
                               t-key="stage_index">
                                <div class="legend-item">
                                     <span class="legend-color"
                                              t-att-style="'background-color: ' + stage.color"/>
                                    <div class="legend-line">

                                        <span class="legend-text"
                                              t-esc="stage.stage"/>
                                        <span class="legend-value"
                                          t-esc="stage.value + '%'"/>
                                    </div>

                                </div>
                            </t>
                        </div>
                        <div class="cy-pipeline-counts"
                             t-if="state.pipeline and state.pipeline.length and state.pipeline[0].count !== undefined">
                            <t t-foreach="state.pipeline" t-as="stage"
                               t-key="stage_index">
                                <span class="pipeline-count">
                                    <span class="pipeline-count-num"
                                          t-esc="stage.count"/>
                                    <span class="pipeline-count-label"
                                          t-esc="stage.count === 1 ? 'deal' : 'deals'"/>
                                </span>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Top Performers -->
                <div class="performers-card cy-kpi-card">
                    <div class="chart-header">
                        <h3 class="chart-title">Top Performers</h3>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-secondary"
                                    t-on-click="()=>this.exportData('performers')"
                                    data-chart="performers">
                                <i class="fa fa-download"/>
                            </button>
                        </div>
                    </div>
                    <t t-if="state.topPerformers and state.topPerformers.length > 0">
                        <div class="performers-list">
                        <t t-foreach="state.topPerformers" t-as="performer"
                           t-key="performer_index">
                            <div class="performer-item">
                                <div class="performer-info">
                                    <img class="performer-avatar-img"
                                         t-if="performer.avatar and performer.user_id"
                                         t-att-src="'/web/image/res.users/' + performer.user_id + '/image_128'"
                                         alt="performer.name"/>
                                    <div class="performer-avatar"
                                         t-if="!performer.avatar or !performer.user_id"
                                         t-esc="performer.initials"/>
                                    <div class="performer-details">
                                        <p class="performer-name"
                                           t-esc="performer.name"/>
                                        <p class="performer-deals"
                                           t-esc="performer.deals + (performer.deals === 1 ? ' deal' : ' deals')"/>
                                    </div>
                                </div>
                                <div class="performer-right">
                                    <span class="performer-amount"
                                          t-esc="performer.formatted_amount"/>
                                    <span class="performer-rank">
                                        Top <t t-esc="performer_index + 1"/>
                                    </span>
                                </div>
                            </div>
                            </t>
                    </div>

    </t>
    <t t-else="">
        <div class="no-data-message"
        >
            <span>No data found</span>
        </div>
    </t>
                </div>

                <!-- Updates (row 3 — third card) -->
                <div class="notifications-section cy-kpi-card cy-updates-card">
                    <div class="notifications-header">
                        <div class="notifications-title-group">
                            <span class="notifications-title">
                                <i class="fa fa-bell"/>
                                Updates
                            </span>
                        </div>
                        <!-- Clear Records -->
                        <button class="btn btn-secondary"
                                t-on-click="onClearNotifications"
                                t-if="state.leadNotifications and state.leadNotifications.length">
                            <i class="ri-delete-bin-line"/>
                            Clear 
                        </button>
                    </div>

                    <div class="notifications-content">
                        <!-- No notifications message -->
                        <div class="no-notifications"
                             t-if="!state.leadNotifications or !state.leadNotifications.length">
                            <div class="no-notifications-content">
                                <i class="fa fa-bell-slash no-notifications-icon"/>
                                <h4 class="no-notifications-title">No New
                                    Notifications
                                </h4>
                                <p class="no-notifications-text">You're all
                                    caught up! Check back later for new lead
                                    updates.
                                </p>
                            </div>
                        </div>
                        <!-- Notifications List (all rows, scrollable) -->
                        <div class="notifications-list"
                             t-if="state.leadNotifications and state.leadNotifications.length">
                            <t t-foreach="state.leadNotifications"
                               t-as="notification" t-key="notification.id">
                                <div class="notification-item cy-update-row"
                                     t-att-class="getNotificationClass(notification)"
                                     t-on-click="onNotificationClick"
                                     t-att-data-id="notification.id">

                                    <!-- Type icon chip -->
                                    <div class="notification-icon-chip">
                                        <i t-att-class="getNotificationIcon(notification.type)"/>
                                    </div>

                                    <!-- Title + description -->
                                    <div class="notification-content">
                                        <p class="notification-title"
                                           t-esc="notification.title"/>
                                        <p class="notification-desc"
                                           t-esc="notification.message"/>
                                    </div>

                                    <!-- Time -->
                                    <span class="notification-time"
                                          t-if="notification.create_date">
                                        <i class="ri-time-line"/>
                                        <t t-esc="formatNotificationTime(notification.create_date)"/>
                                    </span>

                                    <!-- Notification Actions -->
                                    <div class="notification-actions">
                                        <!-- View Lead Button -->
                                        <button class="btn cy-btn-view-lead"
                                                t-on-click.stop="onViewLead"
                                                t-att-data-lead-id="notification.lead_id"
                                                t-if="notification.lead_id">
                                            View Lead
                                        </button>

                                        <!-- Dismiss Button -->
                                        <button class="btn btn-secondary"
                                                t-on-click.stop="onDismissNotification"
                                                t-att-data-id="notification.id">
                                            Dismiss
                                        </button>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
             <div class="charts-grid" t-ref="crmDashboardChartGrids">
                <!-- Revenue Chart -->
                <div class="chart-card cy-kpi-card cy-trend-card">
                    <div class="chart-header">
                        <h3 class="chart-title">Revenue &amp; Leads Trend</h3>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-secondary"
                                    t-on-click="()=>this.exportData('lead')"
                                    data-chart="revenue">
                                <i class="fa fa-download"/>
                            </button>
                        </div>
                    </div>
                    <!-- HTML series legend below the title -->
                    <div class="chart-legend cy-series-legend">
                        <div class="legend-item">
                            <span class="legend-color lead-dot"></span>
                            <span class="legend-text">Lead</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color revenue-dot"></span>
                            <span class="legend-text">Revenue</span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-dash"></span>
                            <span class="legend-text">Previous year</span>
                        </div>
                    </div>
                    <div class="chart-container">
                        <canvas t-ref="revenueChart" />
                    </div>
                </div>

                <!-- Weekly Activities (row 2 — beside Revenue &amp; Leads Trend) -->
                <div class="activities-card cy-kpi-card cy-activities-card">
                    <div class="chart-header">
                        <h3 class="chart-title">Activities Overview</h3>
                        <div class="chart-actions">
                            <button class="btn btn-sm btn-secondary"
                                    t-on-click="()=>this.exportData('activity')"
                                    data-chart="activities">
                                <i class="fa fa-download"/>
                            </button>
                        </div>
                    </div>
                    <!-- HTML series legend below the title -->
                    <div class="chart-legend cy-series-legend"
                         t-if="state.activityLegend and state.activityLegend.length">
                        <t t-foreach="state.activityLegend" t-as="item"
                           t-key="item_index">
                            <div class="legend-item">
                                <span class="legend-color"
                                      t-att-style="'background-color: ' + item.color"/>
                                <span class="legend-text" t-esc="item.name"/>
                            </div>
                        </t>
                    </div>
                    <div class="chart-container">
                        <canvas t-ref="activitiesChart"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
