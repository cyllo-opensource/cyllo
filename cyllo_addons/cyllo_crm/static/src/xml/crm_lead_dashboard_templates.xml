<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for rendering the crm lead dashboard. -->
<templates>
    <t t-name="cyllo_crm.crm_lead_dashboard" owl="1">
        <!-- Dashboard -->
        <div class="o_stock_move_dashboard container-fluid py-3 border-bottom bg-white"
             t-att-class="{'d-none': !state.isDashboardVisible}">

            <!-- Row 1: My Leads -->
            <div class="d-flex align-items-stretch mb-2">
                <div class="d-flex flex-grow-1 gap-1">
                    <a href="#" class="cy-crm-dash-btn btn btn-primary"
                                   t-on-click="(ev) => this.setSearchContext(ev, 'total_leads')" filter_name="my">
                        <div class="cy-crm-dash-count" t-out="crmLeadData['my_leads']"/>
                        <div class="cy-crm-dash-label">My Leads</div>
                                </a>
                    <a href="#" class="cy-crm-dash-btn btn btn-primary"
                                   t-on-click="(ev) => this.setSearchContext(ev, 'idle')" filter_name="activities_idle">
                        <div class="cy-crm-dash-count" t-out="crmLeadData['idle']"/>
                        <div class="cy-crm-dash-label">Idle Leads</div>
                                </a>
                    <a href="#" class="cy-crm-dash-btn btn btn-primary"
                                   t-on-click="(ev) => this.setSearchContext(ev, 'no_activity')" filter_name="no_activity">
                        <div class="cy-crm-dash-count" t-out="crmLeadData['no_activity']"/>
                        <div class="cy-crm-dash-label">No Activity</div>
                                </a>
                    <a href="#" class="cy-crm-dash-btn btn btn-primary"
                                   t-on-click="(ev) => this.setSearchContext(ev, 'overdue')" filter_name="activities_overdue">
                        <div class="cy-crm-dash-count" t-out="crmLeadData['overdue']"/>
                        <div class="cy-crm-dash-label">Overdue</div>
                                </a>
                    <a href="#" class="cy-crm-dash-btn btn btn-primary"
                                   t-on-click="(ev) => this.setSearchContext(ev, 'due_today')" filter_name="activities_today">
                        <div class="cy-crm-dash-count" t-out="crmLeadData['due_today']"/>
                        <div class="cy-crm-dash-label">Due Today</div>
                                </a>
                    <a href="#" class="cy-crm-dash-btn btn btn-primary"
                                   t-on-click="(ev) => this.setSearchContext(ev, 'activity_today')" filter_name="assigned_to_me">
                        <div class="cy-crm-dash-count" t-out="crmLeadData['activity_today']"/>
                        <div class="cy-crm-dash-label">My Activities</div>
                                </a>
                            </div>
                        </div>

            <!-- Row 2: All Leads -->
            <t t-if="crmLeadData['can_see_all_leads']">
                <div class="d-flex align-items-stretch">
                    <div class="d-flex flex-grow-1 gap-1">
                        <a href="#" class="cy-crm-dash-btn btn btn-secondary"
                           t-on-click="(ev) => this.setSearchContext(ev, 'all_leads')" filter_name="all_leads">
                            <div class="cy-crm-dash-count" t-out="crmLeadData['all_leads']"/>
                            <div class="cy-crm-dash-label">All Leads</div>
                        </a>
                        <a href="#" class="cy-crm-dash-btn btn btn-secondary"
                           t-on-click="(ev) => this.setSearchContext(ev, 'all_idle')" filter_name="all_activities_idle">
                            <div class="cy-crm-dash-count" t-out="crmLeadData['all_idle']"/>
                            <div class="cy-crm-dash-label">Idle Leads</div>
                        </a>
                        <a href="#" class="cy-crm-dash-btn btn btn-secondary"
                           t-on-click="(ev) => this.setSearchContext(ev, 'all_no_activity')" filter_name="all_no_activity">
                            <div class="cy-crm-dash-count" t-out="crmLeadData['all_no_activity']"/>
                            <div class="cy-crm-dash-label">No Activity</div>
                        </a>
                        <a href="#" class="cy-crm-dash-btn btn btn-secondary"
                           t-on-click="(ev) => this.setSearchContext(ev, 'all_overdue')" filter_name="all_activities_overdue">
                            <div class="cy-crm-dash-count" t-out="crmLeadData['all_overdue']"/>
                            <div class="cy-crm-dash-label">Overdue</div>
                        </a>
                        <a href="#" class="cy-crm-dash-btn btn btn-secondary"
                           t-on-click="(ev) => this.setSearchContext(ev, 'all_due_today')" filter_name="all_activities_today">
                            <div class="cy-crm-dash-count" t-out="crmLeadData['all_due_today']"/>
                            <div class="cy-crm-dash-label">Due Today</div>
                        </a>
                        <a href="#" class="cy-crm-dash-btn btn btn-secondary"
                           t-on-click="(ev) => this.setSearchContext(ev, 'all_activity_today')" filter_name="all_activity_today">
                            <div class="cy-crm-dash-count" t-out="crmLeadData['all_activity_today']"/>
                            <div class="cy-crm-dash-label">All Activities</div>
                        </a>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
