<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="demo_debt_management_lend" model="debt.management">
        <field name="debt_type">lend</field>
        <field name="person_id" ref="base.res_partner_1"/>
        <field name="amount">2500.0</field>
        <field name="date" eval="DateTime.now().strftime('%Y-%m-%d')"/>
        <field name="payback_period">month</field>
        <field name="payback_date" eval="(DateTime.now() + relativedelta(days=30)).strftime('%Y-%m-%d')"/>
    </record>

    <record id="demo_debt_management_borrow" model="debt.management">
        <field name="debt_type">borrow</field>
        <field name="person_id" ref="base.res_partner_2"/>
        <field name="amount">1200.0</field>
        <field name="date" eval="DateTime.now().strftime('%Y-%m-%d')"/>
        <field name="payback_period">week</field>
        <field name="payback_date" eval="(DateTime.now() + relativedelta(days=7)).strftime('%Y-%m-%d')"/>
    </record>
</odoo>
