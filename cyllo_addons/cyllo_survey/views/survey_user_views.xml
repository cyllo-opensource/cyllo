<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_user_input_line_view_form" model="ir.ui.view">
        <field name="name">survey.user_input.line.view.form.inherit.cyllo.survey</field>
        <field name="model">survey.user_input.line</field>
        <field name="inherit_id" ref="survey.survey_user_input_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_text_box']" position="after">
                <field name="value_upload_name" invisible="1"/>
                <field name="value_upload" filename="value_upload_name" colspan="2" invisible="answer_type != 'upload'"/>
            </xpath>
        </field>
    </record>
</odoo>
