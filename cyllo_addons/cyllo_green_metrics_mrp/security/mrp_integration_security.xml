<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mrp_workcenter_carbon_rule_multicompany" model="ir.rule">
            <field name="name">MRP Workcenter Carbon Multi-Company Rule</field>
            <field name="model_id" ref="model_mrp_workcenter_carbon"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Manufacturing User -> Green Metrics User -->
         <record id="mrp.group_mrp_user" model="res.groups">
            <field name="implied_ids" eval="[
                Command.link(ref('cyllo_green_metrics.group_carbon_user'))
            ]"/>
        </record>

        <!-- Manufacturing Manager -> Green Metrics Manager -->
        <record id="mrp.group_mrp_manager" model="res.groups">
            <field name="implied_ids" eval="[
                Command.link(ref('cyllo_green_metrics.group_carbon_manager'))
            ]"/>
        </record>
    </data>
</odoo>
