<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_cyllo_stock" model="ir.ui.view">
        <field name="name">res.config.settings.cyllo.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="inside">
                <setting id="module_cyllo_intercompany_transfer_setting" string="Intercompany Transfers" help="Enable automated intercompany workflows between companies.">
                    <field name="module_cyllo_intercompany_transfer"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>