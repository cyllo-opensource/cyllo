<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable_inherit_cyllo" model="ir.ui.view">
        <field name="name">stock.quant.inventory.tree.editable.inherit.cyllo</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <!-- Add risk details field after scheduled date (inventory_date) -->
            <xpath expr="//field[@name='inventory_date']" position="after">
                <field name="expiry_risk_level" widget="badge"
                       decoration-danger="expiry_risk_level == 'high'"
                       decoration-warning="expiry_risk_level == 'medium'"
                       decoration-success="expiry_risk_level == 'low'"
                       decoration-muted="expiry_risk_level == 'no_expiry'"
                       optional="show"
                       invisible="expiry_risk_level == 'no_expiry'"
                       readonly="1"/>
                <field name="is_handled" column_invisible="True"/>
            </xpath>
            <!-- Add Handle action button after Set button -->
            <xpath expr="//button[@name='action_set_inventory_quantity']" position="after">
                <button name="action_handle_expiry" type="object" string="Handle"
                        class="btn btn-link" icon="fa-gears"
                        invisible="is_handled or expiry_risk_level == 'no_expiry'"/>
            </xpath>
        </field>
    </record>

    <record id="quant_search_view_inherit_cyllo" model="ir.ui.view">
        <field name="name">stock.quant.search.inherit.cyllo</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="expiry_risk_level"/>
            </xpath>
            <xpath expr="//filter[@name='my_count']" position="after">
                <separator/>
                <filter name="expiry_risk_high" string="High Expiry Risk"
                        domain="[('expiry_risk_level', '=', 'high')]"/>
                <filter name="expiry_risk_medium" string="Medium Expiry Risk"
                        domain="[('expiry_risk_level', '=', 'medium')]"/>
                <filter name="expiry_risk_low" string="Low Expiry Risk"
                        domain="[('expiry_risk_level', '=', 'low')]"/>
            </xpath>
        </field>
    </record>
</odoo>
