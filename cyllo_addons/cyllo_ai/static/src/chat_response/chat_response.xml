                            </g>
                            <g opacity="1" transform="matrix(0.8695600032806396,0,0,0.8695600032806396,361.25,373.75)">
                                <path stroke-linecap="butt" stroke-linejoin="miter" fill-opacity="0" stroke-miterlimit="4" stroke="rgb(193,200,47)" stroke-opacity="1" stroke-width="24" d=" M0,-53.25 C29.388675689697266,-53.25 53.25,-29.388675689697266 53.25,0 C53.25,29.388675689697266 29.388675689697266,53.25 0,53.25 C-29.388675689697266,53.25 -53.25,29.388675689697266 -53.25,0 C-53.25,-29.388675689697266 -29.388675689697266,-53.25 0,-53.25z"></path>
