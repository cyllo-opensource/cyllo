                </svg>
                <t t-if="props.streaming">
                    <span class="cy-ai-head-live" t-esc="liveLabel" />
                </t>
                <t t-elif="showWorked">
                    <button class="cy-ai-head-summary"
                        t-att-class="{ 'cy-ai-head-static': !steps.length }"
                        t-att-disabled="!steps.length"
                        t-on-click="toggleSteps">
                        <span t-esc="workedLabel" />
                        <i t-if="steps.length"
                            t-att-class="'cy-ai-head-caret ri-arrow-down-s-line' + (state.stepsOpen ? ' open' : '')" />
                    </button>
                </t>
            </div>
            <!-- The trajectory behind the answer: which tools ran, and whether
                 each succeeded. Collapsed by default. -->
            <div class="cy-ai-steps" t-if="state.stepsOpen and steps.length">
                <t t-foreach="steps" t-as="step" t-key="step_index">
                    <div class="cy-ai-step">
                        <i t-att-class="step.ok === false ? 'ri-close-circle-line cy-ai-step-bad'
                                                          : 'ri-check-line cy-ai-step-ok'" />
                        <span t-esc="step.label" />
                    </div>
                </t>
            </div>
            <div class="chat-bubble-wrapper">
                <!-- Message bubble -->
                <!-- The answer up to the model's [[chart]] marker (or all of it,
                     when there is no marker). -->
                <!-- Whatever the model said before calling the tool. The card
                     below renders the operation's own fields, so this is only
                     the lead-in prose, not the preview markdown again. -->
                <div class="chat-bubble bot" t-if="confirmCard and confirmLeadHtml">
                    <t t-out="confirmLeadHtml" />
                </div>
                <div class="cy-ai-confirm-card" t-if="confirmCard">
                    <div class="cy-ai-confirm-head">
                        <i t-att-class="'cy-ai-confirm-icon cy-ai-confirm-icon-' + confirmCard.action + ' ' + confirmCard.icon" />
                        <div class="cy-ai-confirm-headtext">
                            <span class="cy-ai-confirm-eyebrow" t-if="props.interrupted and !state.hideButtons">Confirm before running</span>
                            <span class="cy-ai-confirm-eyebrow" t-else="">Operation reviewed</span>
                            <span class="cy-ai-confirm-title">
                                <span t-att-class="'cy-ai-confirm-verb me-1 cy-ai-confirm-verb-' + confirmCard.action" t-esc="confirmCard.action" />
                                <t t-esc="confirmCard.subject" />
                            </span>
                        </div>
                        <code class="cy-ai-confirm-technical" t-esc="confirmCard.modelName" />
                    </div>
                    <div class="cy-ai-confirm-match" t-if="confirmCard.match">
                        <i class="ri-news-line" />
                        <span t-esc="confirmCard.match" />
                    </div>
                    <div class="cy-ai-confirm-rows" t-if="confirmCard.values.length">
                        <div class="cy-ai-confirm-row" t-foreach="confirmCard.values" t-as="v" t-key="v_index">
                            <span class="cy-ai-confirm-key" t-esc="v.key" />
                            <span class="cy-ai-confirm-val" t-esc="v.value" />
                        </div>
                    </div>
                    <div class="cy-ai-confirm-actions" t-if="props.interrupted and !state.hideButtons">
                        <button class="btn btn-primary btn-sm" t-on-click="handleProceed">
                            <i class="ri-check-line" />
                            Proceed
                        </button>
                        <button class="btn btn-secondary btn-sm" t-on-click="handleEdit">
                            <i class="ri-pencil-line" />
                            Request changes
                        </button>
                        <button class="btn btn-secondary btn-sm" t-on-click="handleCancel">
                            <i class="ri-close-line" />
                            Cancel
                        </button>
                    </div>
                    <div class="cy-ai-confirm-done" t-else="">
                        <i class="ri-check-double-line" />
                        Handled
                    </div>
                </div>
                <div class="chat-bubble bot" t-ref="bubble" t-else="">
                    <t t-if="props.html" t-out="answerParts.before" />
                    <t t-elif="props.text" t-out="props.text" />
                </div>
                <!-- Attachments belong INSIDE the response, between the prose and
                     the action row: a chart is part of the answer, not a postscript.
                     They used to be siblings of .chat-message, so they rendered
                     after the whole message including its footer, which read as a
                     detached card rather than part of the reply. -->
                <t t-if="props.chart and chartComponent">
                    <div class="cy-ai-chat-chart">
                        <t t-component="chartComponent" t-props="props.chart" />
                    </div>
                </t>
                <t t-if="props.widget and widgetComponent">
                    <div class="cy-ai-chat-widget">
                        <t t-component="widgetComponent" t-props="props.widget.props or {}" />
                    </div>
                </t>
                <t t-if="props.suggestions and props.suggestions.length">
                    <div class="cy-ai-suggestions">
                        <t t-foreach="props.suggestions" t-as="sugg" t-key="sugg_index">
                            <div class="cy-ai-card">
                                <div class="cy-ai-card-title" t-esc="sugg.title" />
                                <div class="cy-ai-card-question" t-if="sugg.question" t-esc="sugg.question" />
                                <div class="cy-ai-card-chips">
                                    <span class="cy-ai-chip" t-esc="sugg.dimension.label" />
                                    <span class="cy-ai-chip cy-ai-chip-measure" t-esc="sugg.measure.label" />
                                </div>
                                <div class="cy-ai-card-why" t-if="sugg.reason">
                                    <i class="ri-check-line me-1" />
                                    <t t-esc="sugg.reason" />
                                </div>
                                <button class="btn btn-sm cy-ai-apply w-100"
                                    t-on-click="() => this.onApplySuggestion(sugg)">
                                    <i class="ri-check-line me-1" />
                                    Apply
                                </button>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-if="props.chart_config">
                    <t t-log="'props.chart_config', props.chart_config.__target__" />
                    <div class="chart-config">
                        <div
                            class="chat-bubble bot bg-white w-100">
                            <!-- Title + toolbar on one line. The title is pulled out
                                 of the ECharts option (see chartTitle / _withoutTitle
                                 in the component) so it is a DOM node and can align
                                 with the icons instead of being painted in the canvas. -->
                            <div class="cy-ai-chart-head">
                                <span class="cy-ai-chart-title" t-esc="chartTitle" />
                                <div class="graph-icon">
                                    <i class="ri-fullscreen-line"
                                        t-on-click="onExpandGraph"
                                        style="padding: 5px;"
                                        title="Maximize Graph" />
                                    <div t-if="state.showGraphPopup" class="gov-popup">
                                        <div class="gov-popup-header w-2">
                                            <span t-esc="chartTitle or 'Chart'" />
                                            <button class="chart-close-btn" t-on-click="onExpandGraph">×</button>
                                        </div>
                                        <div style="display: flex; justify-content: end; padding: 10px;">
                                            <t t-foreach="state.chartTypes" t-as="type" t-key="type.name">
                                                <div class="chart-type-icon"
                                                    t-att-class="{'selected': type.name === state.popupSelectedType}"
                                                    t-on-click="() => onChartTypeSelect(type.name, true)"
                                                    t-att-title="type.label"
                                                    style="width: 30px; height: 30px; border-radius: 6px; padding: 4px;
                                                 box-sizing: border-box; cursor: pointer; transition: all 0.2s;"
                                                    onmouseenter="this.style.boxShadow='0 4px 6px rgba(0, 0, 0, 0.2)'"
                                                    onmouseleave="this.style.boxShadow='none'">
                                                    <img t-att-src="type.icon" alt=""
                                                        style="width: 100%; height: 100%; object-fit: contain;" />
                                                </div>
                                            </t>
                                        </div>
                                        <div class="gov-popup-body">
                                            <div style="width: 100%; min-height: 700px; padding: 10px" t-ref="popupChartContainer"></div>
                                        </div>
                                    </div>
                                    <i class="ri-bar-chart-line"
                                        style="padding: 5px;"
                                        t-on-click="onGraphIconClick"
                                        title="Change Chart Type" />
                                </div>
                            </div>
                            <!-- Chart type popup grid -->
                            <t t-if="state.showChartOptions">
                                <div class="chart-type-popup" t-att-class="{'visible': state.showChartOptions}">
                                    <t t-foreach="state.chartTypes" t-as="type" t-key="type.name">
                                        <div class="chart-type-icon"
                                            t-att-class="{'selected': type.name === state.chatSelectedType}"
                                            t-on-click="() => onChartTypeSelect(type.name)"
                                            t-att-title="type.label"
                                            style="width: 30px; height: 30px; border-radius: 6px; padding: 4px;
                                             box-sizing: border-box; cursor: pointer; transition: all 0.2s;"
                                            onmouseenter="this.style.boxShadow='0 4px 6px rgba(0, 0, 0, 0.2)'"
                                            onmouseleave="this.style.boxShadow='none'">
                                            <img t-att-src="type.icon" alt=""
                                                style="width: 100%; height: 100%; object-fit: contain;" />
                                        </div>
                                    </t>
                                </div>
                            </t>
                            <!-- Dynamic chart container -->
                            <div t-ref="chartContainer" style="width: 100%; min-height: 400px;padding: 5px;"></div>
                        </div>
                    </div>
                </t>
                <!-- Whatever the model wrote AFTER the marker, so the chart lands
                     where it asked rather than always at the end. Empty (and this
                     div absent) when no marker was used. -->
                <div class="chat-bubble bot" t-if="answerParts.after" t-ref="bubbleAfter">
                    <t t-out="answerParts.after" />
                </div>
                <!-- Action row: copy (always) + meta (time/tokens when known) -->
                <div class="cyllo-msg-footer">
                    <i t-if="!props.streaming"
                        t-att-class="'cyllo-copy-icon ' + (state.copied ? 'ri-check-line' : 'ri-file-copy-line')"
                        t-on-click="copyResponse"
                        t-att-title="state.copied ? 'Copied' : 'Copy response'" />
                    <i t-if="!props.streaming"
                        t-att-class="'cyllo-play-icon ' + (props.isPlaying ? 'ri-stop-line' : 'ri-volume-up-line')"
                        t-on-click="togglePlay"
                        t-att-title="props.isPlaying ? 'Stop' : 'Read aloud'" />
                    <i t-if="state.hasTable"
                        class="cyllo-copy-icon ri-download-line"
                        t-on-click="downloadTable"
                        title="Download table" />
                    <span t-if="props.unsaved" class="cy-ai-unsaved"
                        title="This exchange could not be written to the conversation history, so it will not be here after a reload.">
                        <i class="ri-error-warning-line" />
                        Not saved
                    </span>
                    <span t-if="timeLabel or tokenLabel" class="cyllo-msg-meta">
                        <span t-if="timeLabel" t-esc="timeLabel" />
                        <span t-if="timeLabel and tokenLabel"> · </span>
                        <span t-if="tokenLabel" t-esc="tokenLabel" />
                    </span>
                </div>
                <!-- Icons directly below the bubble -->
                <div t-if="props.interrupted and !state.hideButtons and !confirmCard" class="action-icons">
                    <i class="ri-check-line proceed-icon" t-on-click="handleProceed" title="Proceed" />
                    <i class="ri-pencil-line edit-icon" t-on-click="handleEdit" title="Request changes" />
                    <i class="ri-close-line cancel-icon" t-on-click="handleCancel" title="Cancel" />
                </div>
            </div>
        </div>
    </t>
</templates>