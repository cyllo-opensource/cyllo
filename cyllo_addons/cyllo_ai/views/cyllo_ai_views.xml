<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============ LLM Models ============ -->
    <record id="view_cyllo_llm_tree" model="ir.ui.view">
        <field name="name">cyllo.llm.tree</field>
        <field name="model">cyllo.llm</field>
        <field name="arch" type="xml">
            <tree string="LLM Models">
                <field name="display_name" />
                <field name="name" />
                <field name="wrapper" />
            </tree>
        </field>
    </record>

    <record id="view_cyllo_llm_form" model="ir.ui.view">
        <field name="name">cyllo.llm.form</field>
        <field name="model">cyllo.llm</field>
        <field name="arch" type="xml">
            <form string="LLM Model">
                <sheet>
                    <group>
                        <field name="display_name" />
                        <field name="name" placeholder="Provider model id, e.g. gpt-4o" />
                        <field name="wrapper" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cyllo_llm" model="ir.actions.act_window">
        <field name="name">LLM Models</field>
        <field name="res_model">cyllo.llm</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_cyllo_ai" model="ir.actions.client">
        <field name="name">Cyllo AI</field>
        <field name="tag">cyllo_ai.ChatBotScreen</field>
    </record>
</odoo>