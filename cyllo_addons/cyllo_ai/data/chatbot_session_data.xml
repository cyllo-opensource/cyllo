<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Garbage-collect idle agent working-state sessions -->
    <record id="ir_cron_gc_chatbot_session" model="ir.cron">
        <field name="name">Cyllo AI: Garbage-collect idle sessions</field>
        <field name="model_id" ref="model_chatbot_session"/>
        <field name="state">code</field>
        <field name="code">model._gc_sessions(max_idle_days=7)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
