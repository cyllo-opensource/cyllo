<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_cyllo_ai" model="ir.module.category">
        <field name="name">Cyllo AI</field>
        <field name="description">Access rights for the Cyllo AI assistant.</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_cyllo_ai_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_cyllo_ai"/>
    </record>

    <record id="group_cyllo_ai_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_cyllo_ai"/>
        <field name="implied_ids" eval="[(4, ref('group_cyllo_ai_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Every internal user can use the assistant and see their own
         conversations, so grant the User group to all employees. Admin-only
         screens (Configuration, LLM Models, Audit) are gated separately. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('cyllo_ai.group_cyllo_ai_user'))]"/>
    </record>
</odoo>
