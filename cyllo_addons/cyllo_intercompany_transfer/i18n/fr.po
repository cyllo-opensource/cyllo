#. module: cyllo_intercompany_transfer
#: model_terms:ir.ui.view,arch_db:cyllo_intercompany_transfer.res_config_settings_view_form_cyllo_intercompany_transfer
msgid ""
"When a delivery order is validated in the                        supplying "
"company, the corresponding receipt in the receiving company is"
"                        automatically updated with the quantities actually "
"delivered,                        including partial deliveries."
msgstr ""
"Lorsqu'un bon de livraison est validé dans la société fournisseur, la "
"réception correspondante dans la société destinataire est automatiquement "
"mise à jour avec les quantités réellement livrées, y compris les livraisons "
"partielles."
