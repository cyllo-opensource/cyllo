"                                        ✓ Scanned\n"
"                                    </span>"
msgstr ""
"<span class=\"badge badge-success py-1 px-2\">\n"
"                                        ✓ Escaneado\n"
"                                    </span>"

#. module: cyllo_link_tracker
#: model_terms:ir.ui.view,arch_db:cyllo_link_tracker.view_qr_token_overview_kanban
msgid ""
"<span class=\"badge badge-success py-1 px-2\">✓ Tracked &amp; Scanned</span>"
msgstr ""
"<span class=\"badge badge-success py-1 px-2\">✓ Rastreado y escaneado</span>"

#. module: cyllo_link_tracker
#: model_terms:ir.ui.view,arch_db:cyllo_link_tracker.view_qr_token_overview_kanban
msgid ""
"<span class=\"badge badge-warning py-1 px-2\">⏳ Tracked — Not Scanned</span>"
msgstr ""
"<span class=\"badge badge-warning py-1 px-2\">⏳ Rastreado — No "
"escaneado</span>"

#. module: cyllo_link_tracker
#: model_terms:ir.ui.view,arch_db:cyllo_link_tracker.view_qr_token_overview_form
msgid ""
"<span>\n"
"                            <i class=\"fa fa-check-circle fa-lg mr-2\"/>\n"
"                            <strong>Tracked &amp; Scanned</strong> — Analytics are ON and this QR has been scanned.\n"
"                        </span>"
msgstr ""
"<span>\n"
"                            <i class=\"fa fa-check-circle fa-lg mr-2\"/>\n"
"                            <strong>Rastreado y escaneado</strong> — Las analíticas están activadas y este código QR ha sido escaneado.\n"
"                        </span>"

