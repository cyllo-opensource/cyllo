#. module: cyllo_link_tracker
#: model_terms:ir.ui.view,arch_db:cyllo_link_tracker.view_qr_record_status_form
msgid ""
"<i class=\"fa fa-check-circle mr-2\"/>\n"
"                        <strong>Scanned ✓</strong> — This QR code has been scanned for this record."
msgstr ""
"<i class=\"fa fa-check-circle mr-2\"/>\n"
"                        <strong>Escaneado ✓</strong> — Este código QR ha sido escaneado para este registro."

#. module: cyllo_link_tracker
#: model_terms:ir.ui.view,arch_db:cyllo_link_tracker.view_qr_token_overview_form
msgid ""
"<i class=\"fa fa-clock-o fa-lg mr-2\"/>\n"
"                        <strong>Tracked — Not Yet Scanned</strong> — Analytics are ON but no scans recorded yet."
msgstr ""
"<i class=\"fa fa-clock-o fa-lg mr-2\"/>\n"
"                        <strong>Rastreado — Aún no escaneado</strong> — Las analíticas están activadas pero aún no se han registrado escaneos."

#. module: cyllo_link_tracker
#: model_terms:ir.ui.view,arch_db:cyllo_link_tracker.view_qr_token_overview_form
msgid ""
"<i class=\"fa fa-times-circle fa-lg mr-2\"/>\n"
"                        <strong>Not Tracked</strong> — Analytics are OFF for this QR code."
msgstr ""
"<i class=\"fa fa-times-circle fa-lg mr-2\"/>\n"
"                        <strong>No rastreado</strong> — Las analíticas están desactivadas para este código QR."

#. module: cyllo_link_tracker
#: model_terms:ir.ui.view,arch_db:cyllo_link_tracker.view_qr_token_overview_kanban
msgid "<span class=\"badge badge-secondary py-1 px-2\">✗ Not Tracked</span>"
msgstr "<span class=\"badge badge-secondary py-1 px-2\">✗ No rastreado</span>"

#. module: cyllo_link_tracker
#: model_terms:ir.ui.view,arch_db:cyllo_link_tracker.view_qr_record_status_kanban
