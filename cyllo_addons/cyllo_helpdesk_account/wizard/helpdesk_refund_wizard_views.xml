<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_refund_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.refund.wizard.form</field>
        <field name="model">helpdesk.refund.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Refund">
                <sheet>
                    <group>
                        <group>
                            <field name="ticket_id" invisible="1"/>
                            <field name="customer_id" readonly="1" force_save="1"/>
                            <field name="invoice_id" options="{'no_create': True}" domain="[
                                                        ('move_type', '=', 'out_invoice'),
                                                        ('partner_id', '=', customer_id),
                                                        ('state', '=', 'posted'),
                                                        ('reversal_move_id', '=', False)
                                                    ]"/>
                        </group>
                        <group>
                            <field name="journal_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
