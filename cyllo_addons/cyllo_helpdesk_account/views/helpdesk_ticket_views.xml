<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="helpdesk_ticket_view_form_inherit_account" model="ir.ui.view">
        <field name="name">helpdesk.ticket.view.form.inherit.account</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="cyllo_helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_create_refund" type="object" string="Create Refund" invisible="not customer_id or not use_credit_notes" groups="account.group_account_invoice,account.group_account_manager"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_refunds" type="object" class="oe_stat_button" icon="fa-reply" invisible="not use_credit_notes or refund_count == 0" groups="account.group_account_invoice,account.group_account_manager">
                    <field name="refund_count" widget="statinfo" string="Refunds"/>
                </button>
            </xpath>

            <xpath expr="//group[@invisible='1']" position="inside">
                <field name="refund_ids" invisible="1" groups="account.group_account_invoice,account.group_account_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
