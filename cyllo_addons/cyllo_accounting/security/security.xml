<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ensure all accounting groups are in the main Accounting category so they appear in the single selection dropdown -->
    <record id="account.group_account_readonly" model="res.groups">
        <field name="name">Read-Only</field>
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
    </record>

    <record id="account.group_account_invoice" model="res.groups">
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <!-- Make Billing imply Read-Only for linear hierarchy -->
            <field name="implied_ids"
           eval="[(4, ref('account.group_account_user')),
                  (4, ref('account.group_account_readonly'))]"/>
    </record>

    <record id="account.group_account_user" model="res.groups">
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <record id="account.group_account_manager" model="res.groups">
        <field name="category_id" ref="base.module_category_accounting_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="account_asset_asset_multi_company_rule" model="ir.rule">
        <field name="name">Deferred revenue/expense multi-company</field>
        <field ref="model_account_asset_asset" name="model_id"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'in',
            company_ids)]
        </field>
    </record>

