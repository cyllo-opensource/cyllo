#: code:addons/cyllo_accounting/models/batch_payment.py:0
#, python-format
msgid "You cannot add payments with zero amount in a Batch Payment."
msgstr ""
"Vous ne pouvez pas ajouter de paiements d'un montant nul dans un paiement "
"par lot."

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/account_move.py:0
#, python-format
msgid "You cannot add/modify entries prior to and inclusive of: Lock Date %s."
msgstr ""
"Vous ne pouvez pas ajouter/modifier des écritures antérieures à, et incluant"
" : la date de verrouillage %s."

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/account_move.py:0
#, python-format
msgid ""
"You cannot add/modify entries prior to and inclusive of: Purchase Lock Date "
"%s."
msgstr ""
"Vous ne pouvez pas ajouter/modifier des écritures antérieures à, et incluant"
" : la date de verrouillage des achats %s."

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/account_move.py:0
#, python-format
msgid ""
"You cannot add/modify entries prior to and inclusive of: Sale Lock Date %s."
msgstr ""
"Vous ne pouvez pas ajouter/modifier des écritures antérieures à, et incluant"
" : la date de verrouillage des ventes %s."

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/account_fiscal_year.py:0
#, python-format
msgid ""
"You cannot delete a fiscal year in open state first close the fiscal year."
msgstr ""
"Vous ne pouvez pas supprimer un exercice fiscal à l'état ouvert ; clôturez "
"d'abord l'exercice fiscal."

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/account_return.py:0
#, python-format
msgid "You cannot delete a posted tax return."
msgstr "Vous ne pouvez pas supprimer une déclaration de TVA comptabilisée."

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/account_asset_asset.py:0
#, python-format
msgid ""
"You cannot delete a record linked to posted entries.\n"
"You can cancel the linked journal entries."
msgstr ""
"Vous ne pouvez pas supprimer un enregistrement lié à des écritures comptabilisées.\n"
"Vous pouvez annuler les écritures comptables liées."

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/res_config_settings.py:0
#, python-format
msgid "You cannot disable Accounting PDC because PDC payments exist."
msgstr ""
"Vous ne pouvez pas désactiver les chèques postdatés de comptabilité car des "
"paiements par chèque postdaté existent."

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/account_return.py:0
#, python-format
msgid ""
"You cannot post a tax return prior to and inclusive of the Tax Lock Date "
"(%s)."
msgstr ""
"Vous ne pouvez pas comptabiliser une déclaration de TVA antérieure à, et "
"incluant, la date de verrouillage de la TVA (%s)."

#. module: cyllo_accounting
#. cyllo-javascript
#: code:addons/cyllo_accounting/static/src/js/relational_utils.js:0
#, python-format
msgid "You cannot register payment for draft journal entries"
msgstr ""
"Vous ne pouvez pas enregistrer de paiement pour des écritures comptables en "
"brouillon"

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/account_move.py:0
#, python-format
msgid "You cannot reset to draft, The related asset is already posted"
msgstr ""
"Vous ne pouvez pas réinitialiser en brouillon ; l'immobilisation associée "
"est déjà comptabilisée"

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/wizards/account_move_lock.py:0
#, python-format
msgid "You cannot set a lock date in the future."
msgstr "Vous ne pouvez pas définir une date de verrouillage dans le futur."

#. module: cyllo_accounting
#. cyllo-python
#: code:addons/cyllo_accounting/models/ir_module_module.py:0
#, python-format
msgid "You cannot uninstall Accounting PDC because PDC payments exist."
msgstr ""
"Vous ne pouvez pas désinstaller les chèques postdatés de comptabilité car "
"des paiements par chèque postdaté existent."

