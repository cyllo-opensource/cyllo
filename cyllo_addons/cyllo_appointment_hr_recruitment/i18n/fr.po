#. module: cyllo_appointment_hr_recruitment
#: model:mail.template,subject:cyllo_appointment_hr_recruitment.email_template_applicant_schedule_interview
msgid ""
"\n"
"            Can we schedule an interview for your\n"
"            {{ (object.job_id.name + ' ') if object.job_id else '' }}application?\n"
"        "
msgstr ""
"\n"
"            Pouvons-nous planifier un entretien pour votre candidature\n"
"            {{ (object.job_id.name + ' ') if object.job_id else '' }}?\n"
"        "

#. module: cyllo_appointment_hr_recruitment
#: model:mail.template,description:cyllo_appointment_hr_recruitment.email_template_applicant_schedule_interview
msgid ""
"\n"
"            Send this template when you want to invite an applicant to book\n"
"            their own interview slot through the Cyllo Appointment portal.\n"
"        "
msgstr ""
"\n"
"            Envoyez ce modèle lorsque vous souhaitez inviter un candidat à réserver\n"
"            son propre créneau d'entretien via le portail de Rendez-vous Cyllo.\n"
"        "

#. module: cyllo_appointment_hr_recruitment
#: model:mail.template,body_html:cyllo_appointment_hr_recruitment.email_template_applicant_schedule_interview
msgid ""
"<div style=\"margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif;\">\n"
"    <h2 style=\"color: #333333;\">Hello,</h2>\n"
"    <div style=\"font-size: 13px; color: #555555; line-height: 1.6;\">\n"
"        Thank you for your application and your interest in joining\n"
"        <t t-out=\"object.company_id.name or ''\">Our Company</t>.<br><br>\n"
"\n"
"        We would like to invite you to schedule a phone interview at a time\n"
"        that suits you. The session should last approximately 30 minutes —\n"
"        we will discuss your experience and motivations for joining the\n"
"        <t t-out=\"object.company_id.name or ''\">Our Company</t> team.<br><br>\n"
"\n"
"        Please use the button below to pick a slot that works best for you:\n"
"    </div>\n"
"    <br>\n"
"    <a t-att-href=\"object._get_interview_invite_url()\" t-attf-style=\"            background-color: {{ user.company_id.email_secondary_color or '#875A7B' }};            color: {{ user.company_id.email_primary_color or '#FFFFFF' }};            text-decoration: none;            padding: 10px 20px;            border-radius: 5px;            font-size: 14px;            display: inline-block;        \">\n"
"        Book my interview slot\n"
"    </a>\n"
"    <br><br>\n"
"    <div style=\"font-size: 12px; color: #888888;\">\n"
"        If the button above does not work, copy and paste the following\n"
"        link into your browser:<br>\n"
"        <t t-out=\"object._get_interview_invite_url()\"></t>\n"
"    </div>\n"
"    <br>\n"
"    <p style=\"font-size: 13px; color: #555555;\">\n"
"        Best regards,<br>\n"
"        <t t-out=\"user.name\"></t>\n"
"    </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif;\">\n"
"    <h2 style=\"color: #333333;\">Bonjour,</h2>\n"
"    <div style=\"font-size: 13px; color: #555555; line-height: 1.6;\">\n"
"        Merci pour votre candidature et votre intérêt pour rejoindre\n"
"        <t t-out=\"object.company_id.name or ''\">notre entreprise</t>.<br><br>\n"
"\n"
"        Nous aimerions vous inviter à planifier un entretien téléphonique à l'heure\n"
"        qui vous convient. La session devrait durer environ 30 minutes —\n"
"        nous discuterons de votre expérience et de vos motivations à rejoindre l'équipe de\n"
"        <t t-out=\"object.company_id.name or ''\">notre entreprise</t>.<br><br>\n"
"\n"
"        Veuillez utiliser le bouton ci-dessous pour choisir le créneau qui vous convient le mieux :\n"
"    </div>\n"
"    <br>\n"
"    <a t-att-href=\"object._get_interview_invite_url()\" t-attf-style=\"            background-color: {{ user.company_id.email_secondary_color or '#875A7B' }};            color: {{ user.company_id.email_primary_color or '#FFFFFF' }};            text-decoration: none;            padding: 10px 20px;            border-radius: 5px;            font-size: 14px;            display: inline-block;        \">\n"
"        Réserver mon créneau d'entretien\n"
"    </a>\n"
"    <br><br>\n"
"    <div style=\"font-size: 12px; color: #888888;\">\n"
"        Si le bouton ci-dessus ne fonctionne pas, copiez et collez le lien suivant\n"
"        dans votre navigateur :<br>\n"
"        <t t-out=\"object._get_interview_invite_url()\"></t>\n"
"    </div>\n"
"    <br>\n"
"    <p style=\"font-size: 13px; color: #555555;\">\n"
"        Cordialement,<br>\n"
"        <t t-out=\"user.name\"></t>\n"
"    </p>\n"
"</div>\n"
"        "

