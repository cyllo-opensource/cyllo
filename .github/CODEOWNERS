# CODEOWNERS
# Reference: https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-code-owners
#
# Format:  <pattern>   <owner1> <owner2> ...
# Owners are matched bottom-up — the last matching pattern takes priority.
# Replace @YOUR_USERNAME and @TEAM_NAME with actual GitHub usernames or team slugs.

# ─────────────────────────────────────────────────────────────────────────────
# Global Default: all files require review from the main maintainer
# ─────────────────────────────────────────────────────────────────────────────
*                           @YOUR_USERNAME

# ─────────────────────────────────────────────────────────────────────────────
# Source Code
# ─────────────────────────────────────────────────────────────────────────────
/src/                       @YOUR_USERNAME

# Frontend
/src/frontend/              @YOUR_USERNAME
/src/components/            @YOUR_USERNAME
/src/styles/                @YOUR_USERNAME

# Backend / API
/src/backend/               @YOUR_USERNAME
/src/api/                   @YOUR_USERNAME
/src/services/              @YOUR_USERNAME

# Database
/src/database/              @YOUR_USERNAME
/migrations/                @YOUR_USERNAME

# ─────────────────────────────────────────────────────────────────────────────
# Configuration & Infrastructure
# ─────────────────────────────────────────────────────────────────────────────
/.github/                   @YOUR_USERNAME
/.github/workflows/         @YOUR_USERNAME
/docker/                    @YOUR_USERNAME
Dockerfile                  @YOUR_USERNAME
docker-compose.yml          @YOUR_USERNAME
*.tf                        @YOUR_USERNAME

# ─────────────────────────────────────────────────────────────────────────────
# Tests
# ─────────────────────────────────────────────────────────────────────────────
/tests/                     @YOUR_USERNAME
/test/                      @YOUR_USERNAME
**/*.test.*                 @YOUR_USERNAME
**/*.spec.*                 @YOUR_USERNAME

# ─────────────────────────────────────────────────────────────────────────────
# Documentation
# ─────────────────────────────────────────────────────────────────────────────
/docs/                      @YOUR_USERNAME
README.md                   @YOUR_USERNAME
*.md                        @YOUR_USERNAME

# ─────────────────────────────────────────────────────────────────────────────
# Package / Dependency Files (require extra care)
# ─────────────────────────────────────────────────────────────────────────────
package.json                @YOUR_USERNAME
package-lock.json           @YOUR_USERNAME
yarn.lock                   @YOUR_USERNAME
requirements.txt            @YOUR_USERNAME
Pipfile                     @YOUR_USERNAME
go.mod                      @YOUR_USERNAME
go.sum                      @YOUR_USERNAME
pom.xml                     @YOUR_USERNAME
Gemfile                     @YOUR_USERNAME
